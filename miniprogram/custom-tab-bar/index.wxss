.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: content-box;
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(24px) saturate(180%);
  border-top: 1rpx solid rgba(15, 23, 42, 0.06);
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.tab {
  position: relative;
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 8rpx;
}

.icon {
  width: 46rpx;
  height: 46rpx;
}

.label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #9aa3af;
}

.tab.active .label {
  color: #1957e8;
  font-weight: 700;
}

.indicator {
  position: absolute;
  top: 0;
  width: 88rpx;
  height: 6rpx;
  border-radius: 0 0 6rpx 6rpx;
  background: linear-gradient(90deg, #1957e8, #00d6b9);
  box-shadow: 0 2rpx 10rpx rgba(25, 87, 232, 0.3);
}
