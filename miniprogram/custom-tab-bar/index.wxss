.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  height: 168rpx;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: content-box;
  background: rgba(0, 0, 0, 0.92);
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.tab {
  position: relative;
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 12rpx;
}

.icon {
  width: 48rpx;
  height: 48rpx;
}

.label {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.40);
}

.tab.active .label {
  color: #ffffff;
}

.indicator {
  position: absolute;
  top: 0;
  width: 96rpx;
  height: 6rpx;
  border-radius: 0 0 6rpx 6rpx;
  background: linear-gradient(90deg, #1957E8, #00D6B9);
  box-shadow: 0 0 18rpx rgba(0, 214, 185, 0.8);
}
