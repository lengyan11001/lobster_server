<view class="tabbar">
  <view wx:for="{{list}}" wx:key="pagePath" class="tab {{selected === index ? 'active' : ''}}" data-index="{{index}}" bindtap="switchTab">
    <view wx:if="{{selected === index}}" class="indicator"></view>
    <image class="icon" src="{{selected === index ? item.activeIcon : item.icon}}" />
    <text class="label">{{item.text}}</text>
  </view>
</view>
