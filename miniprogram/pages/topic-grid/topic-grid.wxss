.page { padding: 24rpx; background: #f8fafc; min-height: 100vh; }
.head { margin-bottom: 18rpx; }
.title { display:block; font-size:38rpx; font-weight:700; color:#0f172a; }
.sub { display:block; margin-top:6rpx; font-size:22rpx; color:#94a3b8; }
.input-row { display:flex; gap:14rpx; margin-bottom:20rpx; }
.kw-input { flex:1; background:#fff; border:1rpx solid #e2e8f0; border-radius:14rpx; padding:16rpx; font-size:26rpx; }
.primary { margin:0; padding:0 28rpx; height:76rpx; line-height:76rpx; border-radius:14rpx; }
.grid { display:flex; flex-wrap:wrap; background:#fff; border:1rpx solid #e2e8f0; border-radius:18rpx; padding:8rpx; }
.cell { width:20%; height:110rpx; display:flex; align-items:center; justify-content:center; box-sizing:border-box; border:1rpx solid #f1f5f9; font-size:20rpx; color:#0f172a; text-align:center; padding:6rpx; }
.cell.center { background:#06b6d4; color:#fff; font-size:26rpx; font-weight:700; }
.cell.on { background:#f0fdff; }
.cell.center.on { background:#06b6d4; }
.ph { width:16rpx; height:16rpx; border-radius:50%; background:#e2e8f0; }
.status { display:block; margin-top:16rpx; font-size:22rpx; color:#0891b2; }
.topics { margin-top:22rpx; }
.topics-title { display:block; font-size:26rpx; font-weight:600; color:#0f172a; margin-bottom:12rpx; }
.topic { display:flex; background:#fff; border:1rpx solid #e2e8f0; border-radius:14rpx; padding:16rpx; margin-bottom:12rpx; }
.topic-index { width:40rpx; color:#06b6d4; font-weight:700; }
.topic-text { flex:1; font-size:24rpx; color:#0f172a; line-height:1.6; }
