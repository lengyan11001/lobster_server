<view class="page">
  <view class="head">
    <text class="title">宫格选题</text>
    <text class="sub">中心词 → 行业关键词 → 人群场景 → 连看出选题</text>
  </view>

  <view class="input-row">
    <input class="kw-input" value="{{keyword}}" bindinput="onKeyword" placeholder="输入一个关键词，例如：家装" />
    <button class="primary" loading="{{loading}}" disabled="{{loading}}" bindtap="generate">生成</button>
  </view>

  <view class="grid">
    <view wx:for="{{grid}}" wx:key="index" class="cell {{index === 12 ? 'center' : ''}} {{item ? 'on' : ''}}">
      <text wx:if="{{item}}">{{item}}</text>
      <view wx:else class="ph"></view>
    </view>
  </view>

  <text wx:if="{{statusText}}" class="status">{{statusText}}</text>

  <view wx:if="{{topics.length}}" class="topics">
    <text class="topics-title">生成选题（{{topics.length}}）</text>
    <view wx:for="{{topics}}" wx:key="*this" class="topic" data-text="{{item}}" catchtap="copyTopic">
      <text class="topic-index">{{index + 1}}</text>
      <text class="topic-text">{{item}}</text>
    </view>
  </view>
</view>
