<view class="page">
  <view class="fixed-top">
  <view class="hero">
    <text class="hero-title">宫格选题</text>
    <text class="hero-sub">中心词 → 行业关键词 → 人群场景 → 连看出选题</text>
    <view class="progress"><view class="progress-bar" style="width: {{filled * 4}}%"></view></view>
    <text class="progress-text">已填充 {{filled}} / 25</text>
  </view>

  <view class="input-card">
    <view class="input-row">
      <input class="kw-input" value="{{keyword}}" bindinput="onKeyword" placeholder="输入一个关键词，例如：家装" confirm-type="done" bindconfirm="generate" />
      <button class="gen-btn" loading="{{loading}}" disabled="{{loading}}" bindtap="generate">生成</button>
    </view>
    <view wx:if="{{chips.length}}" class="chips">
      <text wx:for="{{chips}}" wx:key="*this" class="chip" data-word="{{item}}" catchtap="pickChip">{{item}}</text>
    </view>
  </view>

  <view class="grid-card">
    <view class="grid">
      <view wx:for="{{grid}}" wx:key="index" class="cell {{item.ring}} {{item.text ? 'on' : ''}} {{hits[index] ? 'hit' : ''}}">
        <text wx:if="{{item.text}}" class="cell-text">{{item.text}}</text>
        <view wx:else class="ph"></view>
      </view>
    </view>
  </view>

  <view wx:if="{{statusText}}" class="status-pill">{{statusText}}</view>
  </view>

  <scroll-view class="topic-scroll" scroll-y>

  <view wx:if="{{topics.length}}" class="topics">
    <view class="topics-head"><text class="topics-title">生成选题</text><text class="topics-count">{{topics.length}} 条</text></view>
    <view wx:for="{{topics}}" wx:key="index" class="topic {{activeTopic === index ? 'active' : ''}}" data-index="{{index}}" catchtap="selectTopic">
      <view class="topic-badge">{{index + 1}}</view>
      <view class="topic-main">
        <text class="topic-text">{{item.text}}</text>
        <view wx:if="{{item.inner || item.outer}}" class="topic-tags">
          <text wx:if="{{item.inner}}" class="tag inner">{{item.inner}}</text>
          <text wx:if="{{item.inner && item.outer}}" class="tag x">×</text>
          <text wx:if="{{item.outer}}" class="tag outer">{{item.outer}}</text>
        </view>
      </view>
      <text class="topic-copy" data-text="{{item.text}}" catchtap="copyTopic">复制</text>
    </view>
  </view>
  </scroll-view>
</view>
