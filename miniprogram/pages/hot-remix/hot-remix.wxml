<view class="page">
  <view style="margin:12rpx 0;padding:12rpx 16rpx;border-radius:10rpx;background:#fff7ed;color:#9a3412;font-size:22rpx;line-height:1.6;">AI 生成内容，请注意甄别；生成结果仅供参考。</view>

  <view class="head">
    <view class="head-copy">
      <text class="title">热门跟创</text>
      
    </view>
    <view class="head-btns">
      <button wx:if="{{viewMode === 'list'}}" class="primary small" bindtap="openCreate">＋ 新建</button>
    </view>
  </view>

  <block wx:if="{{viewMode === 'list'}}">
    <view class="card">
      <view class="card-head">
        <text class="card-title">跟创任务</text>
        <text class="count">{{jobList.length}} 条</text>
      </view>

      <view wx:if="{{!jobList.length && !pendingTask}}" class="empty">还没有任务，点右上角「新建」开始</view>

      <view wx:if="{{pendingTask}}" class="job-row pending">
        <view class="h-main">
          <text class="h-title">跟创任务</text>
          <text class="h-meta">{{pendingTask.statusText}}</text>
        </view>
        <text class="h-action">生成中</text>
      </view>

      <view wx:for="{{jobList}}" wx:key="id" class="job-row" data-index="{{index}}" bindtap="openJob">
        <view class="h-main">
          <text class="h-title">{{item.title}}</text>
          <text class="h-meta">{{item.meta}}</text>
        </view>
        <text class="h-action">{{item.videoUrl ? '播放' : '状态'}}</text>
        <text wx:if="{{item.videoUrl}}" class="h-dl" catchtap="downloadJob" data-index="{{index}}">下载</text>
      </view>
    </view>

    <text wx:if="{{statusText}}" class="status">{{statusText}}</text>
  </block>

  <block wx:else>
    <block wx:if="{{step === 1}}">
    <view class="card">
      <text class="card-title">1. 原视频</text>
      <view class="video-row">
        <view class="video-box" bindtap="chooseVideo">
          <video wx:if="{{videoPreview}}" src="{{videoPreview}}" class="video-thumb" muted object-fit="cover"></video>
          <view wx:else class="video-empty">+ 上传本地视频</view>
        </view>
        <view class="video-meta">
          <text class="ok">{{videoUrl ? '视频已就绪' : '未选择'}}</text>
          <text class="hint">{{videoName}}</text>
        </view>
      </view>
      <text class="or">或粘贴作品链接分享文案</text>
      <textarea class="textarea" value="{{shareText}}" bindinput="onShareInput" placeholder="粘贴包含链接的完整分享文案" maxlength="1000" auto-height />
      <button class="ghost" loading="{{resolving}}" bindtap="resolveShare">解析链接</button>
      <text wx:if="{{shareStatus}}" class="hint">{{shareStatus}}</text>
    </view>

    <view class="card">
      <text class="card-title">2. 参考图片 *</text>
      <view class="image-row">
        <view class="image-box" bindtap="chooseImage">
          <image wx:if="{{imagePreview}}" src="{{imagePreview}}" mode="aspectFill" class="image-thumb" />
          <view wx:else class="image-empty">+ 上传图片</view>
        </view>
      </view>
    </view>

    <view class="btn-row">
      <button class="step-next" bindtap="nextStep">下一步</button>
    </view>
    </block>

    <block wx:if="{{step === 2}}">
    <view class="card">
      <text class="card-title">3. 参数</text>
      <view class="param">
        <text class="param-label">跟创模式</text>
        <picker mode="selector" range="{{modeLabels}}" value="{{modeIndex}}" bindchange="pickMode">
          <view class="picker">{{modeLabels[modeIndex]}}</view>
        </picker>
      </view>
      <view class="param">
        <text class="param-label">分辨率</text>
        <picker mode="selector" range="{{resolutions}}" value="{{resIndex}}" bindchange="pickRes">
          <view class="picker">{{resolutions[resIndex]}}</view>
        </picker>
      </view>
      <view class="param">
        <text class="param-label">成片时长</text>
        <picker mode="selector" range="{{durationLabels}}" value="{{durIndex}}" bindchange="pickDur">
          <view class="picker">{{durationLabels[durIndex]}}</view>
        </picker>
      </view>
      <text class="param-label block">提示词（可选）</text>
      <textarea class="textarea small" value="{{prompt}}" bindinput="onPrompt" placeholder="例如：画面保持原节奏，人物换成参考图形象" maxlength="500" auto-height />
      <text class="param-label block">标题（可选）</text>
      <input class="input" value="{{title}}" bindinput="onTitle" placeholder="作品标题" maxlength="60" />
    </view>

    <view class="btn-row">
      <button class="ghost" bindtap="prevStep">上一步</button>
      <button class="primary" loading="{{submitting}}" bindtap="submit">开始跟创</button>
    </view>
    <text wx:if="{{statusText}}" class="status">{{statusText}}</text>
    </block>
  </block>
  <view wx:if="{{previewOpen}}" class="preview-mask" catchtap="closePreview">
    <view class="preview-head">
      <text class="preview-back" catchtap="closePreview">‹ 返回</text>
      <text class="preview-title">{{previewTitle}}</text>
      <text class="preview-save" catchtap="savePreview">保存</text>
    </view>
    <video wx:if="{{previewUrl}}" class="preview-video" src="{{previewUrl}}" controls autoplay object-fit="contain"></video>
  </view>
</view>
