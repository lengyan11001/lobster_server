<view class="page">
  <view class="head">
    <text class="title">新建形象分身</text>
    <text class="sub">数字人 2.0：训练素材 + 授权视频 + 授权说明</text>
  </view>

  <view class="panel">
    <text class="label">名称</text>
    <input class="input" value="{{title}}" bindinput="onTitle" placeholder="给这个形象起个名字" />

    <text class="label">素材类型</text>
    <view class="seg">
      <view class="seg-item {{sourceType === 'image' ? 'active' : ''}}" data-t="image" bindtap="setSourceType">图片</view>
      <view class="seg-item {{sourceType === 'video' ? 'active' : ''}}" data-t="video" bindtap="setSourceType">视频</view>
    </view>

    <text class="label">{{sourceType === 'image' ? '训练图片' : '训练视频'}}</text>
    <view class="picker-box" bindtap="chooseSource">
      <text class="picker-text">{{sourceName || (sourceType === 'image' ? '选择清晰正面照片' : '选择清晰正面视频')}}</text>
      <text wx:if="{{sourceName}}" class="clear" catchtap="clearSource">×</text>
    </view>
    <view class="cap-btns">
      <button class="ghost" data-mode="photo" data-target="source" bindtap="openCapture">拍照</button>
      <button class="ghost" data-mode="video" data-target="source" bindtap="openCapture">录制视频</button>
    </view>

    <text class="label">录制读稿（可选）</text>
    <textarea class="textarea" value="{{trainingText}}" bindinput="onTrainingText" auto-height maxlength="500" />

    <text class="label">授权视频（必填）</text>
    <view class="picker-box" bindtap="chooseAuthVideo">
      <text class="picker-text">{{authVideoName || '选择本人授权视频'}}</text>
      <text wx:if="{{authVideoName}}" class="clear" catchtap="clearAuthVideo">×</text>
    </view>
    <view class="cap-btns">
      <button class="ghost" data-mode="video" data-target="auth" bindtap="openCapture">按授权说明录制</button>
    </view>

    <text class="label">授权说明（必填，需包含品牌名）</text>
    <textarea class="textarea" value="{{authText}}" bindinput="onAuthText" auto-height maxlength="500" />

    <checkbox-group bindchange="toggleAgree"><label class="agree"><checkbox value="1" checked="{{agree}}" /><text>我确认已取得形象本人授权</text></label></checkbox-group>

    <button class="primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">开始克隆</button>
    <view wx:if="{{statusText}}" class="status">{{statusText}}</view>
  </view>
</view>
<view wx:if="{{captureOpen}}" class="cap-sheet">
  <view class="cap-head">
    <view class="cap-head-text">
      <text class="cap-title">拍摄素材</text>
      <text class="cap-sub">{{captureScript ? '已开启提词器 · 前置摄像头' : '默认使用前置摄像头'}}</text>
    </view>
    <view class="cap-close" bindtap="closeCapture">×</view>
  </view>

  <view class="cap-toolbar">
    <view class="cap-modes">
      <view class="cap-mode {{captureMode === 'photo' ? 'active' : ''}}" data-mode="photo" bindtap="switchCaptureMode">拍照</view>
      <view class="cap-mode {{captureMode === 'video' ? 'active' : ''}}" data-mode="video" bindtap="switchCaptureMode">录像</view>
    </view>
    <view class="cap-switch" bindtap="switchCamera">⟲ 切换</view>
  </view>

  <view class="cap-stage">
    <camera wx:if="{{!capturedPath}}" class="cap-live" device-position="{{cameraPos}}" flash="off" binderror="onCameraError">
      <cover-view wx:if="{{captureScript}}" class="cap-teleprompter">{{captureScript}}</cover-view>
      <cover-view wx:if="{{recording}}" class="cap-badge"><cover-view class="cap-dot"></cover-view><cover-view class="cap-time">{{recordTimeText}}</cover-view></cover-view>
    </camera>
    <image wx:elif="{{capturedKind === 'image'}}" class="cap-preview" src="{{capturedPath}}" mode="aspectFill" />
    <video wx:else class="cap-preview" src="{{capturedPath}}" controls />
  </view>

  <text class="cap-status">{{captureStatus}}</text>

  <view class="cap-actions">
    <button wx:if="{{capturedPath}}" class="cap-ghost" bindtap="retakeCapture">重拍</button>
    <view wx:if="{{!capturedPath}}" class="cap-shutter {{recording ? 'recording' : ''}}" bindtap="captureAction">
      <view class="cap-shutter-inner"></view>
    </view>
    <button wx:if="{{capturedPath}}" class="cap-use" bindtap="useCapture">使用素材</button>
  </view>
</view>
