.page { min-height: 100vh; padding: 28rpx; background: #f3f6fb; }
.head { padding: 12rpx 4rpx 20rpx; }
.title { display: block; font-size: 40rpx; font-weight: 700; }
.sub { display: block; margin-top: 8rpx; font-size: 24rpx; color: #64748b; }
.panel { padding: 28rpx; background: #fff; border-radius: 24rpx; }
.label { display: block; margin: 20rpx 0 12rpx; font-size: 24rpx; color: #64748b; }
.input { width: 100%; height: 80rpx; padding: 0 20rpx; font-size: 28rpx; background: #f8fafc; border-radius: 14rpx; }
.textarea { width: 100%; min-height: 140rpx; padding: 20rpx; font-size: 26rpx; line-height: 1.7; background: #f8fafc; border-radius: 14rpx; }
.seg { display: flex; gap: 12rpx; }
.seg-item { flex: 1; padding: 16rpx 0; text-align: center; font-size: 26rpx; color: #475569; background: #f1f5f9; border-radius: 12rpx; }
.seg-item.active { color: #fff; background: #2563eb; }
.picker-box { position: relative; padding: 24rpx; font-size: 26rpx; color: #334155; background: #f8fafc; border-radius: 14rpx; }
.clear { position: absolute; right: 18rpx; top: 14rpx; font-size: 32rpx; color: #ef4444; }
.picker { padding: 22rpx; font-size: 28rpx; background: #f8fafc; border-radius: 14rpx; }
.agree { display: flex; align-items: center; gap: 10rpx; margin: 20rpx 0; font-size: 24rpx; color: #475569; }
.primary { margin-top: 24rpx; height: 88rpx; line-height: 88rpx; font-size: 30rpx; color: #fff; background: #2563eb; border-radius: 16rpx; }
.primary[disabled] { opacity: 0.5; }
.status { margin-top: 16rpx; font-size: 24rpx; color: #64748b; text-align: center; }

/* 深色主题（内联） */
page, .page { background: #05070f !important; color: #f2f6ff !important; }
.head, .home-top { background: transparent !important; }
.title, .card-title, .tool-name, .copy-text, .content, .body, .sheet-title, .label, .name, .item-name, .record-title {
  color: #f2f6ff !important;
}
.sub, .card-meta, .meta, .hint, .desc, .time, .tool-desc, .empty, .tip {
  color: #8b98ae !important;
}
.panel, .card, .copy-card, .tool-row, .device-card, .candidate, .hist, .item, .list-item, .sheet {
  background: rgba(255,255,255,.045) !important;
  border-color: rgba(255,255,255,.10) !important;
  color: #f2f6ff !important;
}
.input, textarea, input { background: rgba(255,255,255,.06) !important; color: #f2f6ff !important; border-color: rgba(255,255,255,.14) !important; }
.chip { background: rgba(255,255,255,.06) !important; color: #b6c1d2 !important; }
.chip.active { background: #22d3ee !important; color: #04121a !important; }
.chip.completed { background: rgba(52,211,153,.18) !important; color: #34d399 !important; }
.chip.pending { background: rgba(34,211,238,.16) !important; color: #67e8f9 !important; }
.chip.failed, .err, .error, .card-error { color: #fb7185 !important; }
button.ghost, .ghost { background: rgba(255,255,255,.06) !important; color: #f2f6ff !important; border-color: rgba(255,255,255,.14) !important; }
button.primary, .primary { background: linear-gradient(135deg,#22d3ee,#6366f1) !important; color: #fff !important; }
.danger, button.danger { background: rgba(251,113,133,.16) !important; color: #fb7185 !important; }
.overlay { background: rgba(0,0,0,.55) !important; }

