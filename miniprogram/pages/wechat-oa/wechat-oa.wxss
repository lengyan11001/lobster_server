page { background: #f8f9fa; }
.page { min-height: 100vh; padding: 28rpx 32rpx 60rpx; box-sizing: border-box; background: #f8f9fa; }
.head { margin-bottom: 24rpx; }
.title { display: block; font-size: 40rpx; font-weight: 700; color: #0f172a; }
.sub { display: block; margin-top: 10rpx; font-size: 24rpx; color: #64748b; line-height: 1.6; }
.card { margin-bottom: 24rpx; padding: 26rpx; border-radius: 28rpx; background: #fff; box-shadow: 0 12rpx 40rpx rgba(15,23,42,0.05); }
.card-title { display: block; margin-bottom: 14rpx; font-size: 28rpx; font-weight: 600; color: #0f172a; }
.hint { display: block; margin: 8rpx 0 14rpx; font-size: 23rpx; color: #64748b; line-height: 1.6; }
.ip-list { display: flex; flex-direction: column; }
.ip-row { display: flex; align-items: center; justify-content: space-between; padding: 14rpx 0; border-bottom: 1rpx solid #f1f5f9; }
.ip { font-size: 28rpx; color: #0f172a; font-family: monospace; }
.copy { font-size: 23rpx; color: #1957E8; padding: 8rpx 0 8rpx 20rpx; }
.ok-card { background: #f0fdfa; }
.kv { display: flex; justify-content: space-between; padding: 10rpx 0; font-size: 25rpx; }
.k { color: #64748b; }
.v { color: #0f172a; max-width: 70%; text-align: right; word-break: break-all; }
.mono { font-family: monospace; }
.label { display: block; margin: 16rpx 0 10rpx; font-size: 24rpx; color: #475569; font-weight: 600; }
.input { width: 100%; height: 84rpx; padding: 0 20rpx; box-sizing: border-box; background: #f8fafc; border: 1rpx solid #e2e8f0; border-radius: 16rpx; font-size: 26rpx; color: #0f172a; }
.primary { margin-top: 24rpx; height: 88rpx; line-height: 88rpx; border-radius: 18rpx; font-size: 28rpx; font-weight: 600; color: #fff; background: linear-gradient(135deg, #1957E8, #00B3A0); }
.status { display: block; margin-top: 14rpx; font-size: 23rpx; color: #64748b; line-height: 1.6; }
