.page { min-height: 100vh; padding: 28rpx; background: #f3f6fb; }
.panel { padding: 26rpx; margin-bottom: 20rpx; background: #fff; border-radius: 20rpx; }
.label { display: block; margin: 18rpx 0 10rpx; font-size: 24rpx; color: #64748b; }
.input { width: 100%; height: 78rpx; padding: 0 20rpx; font-size: 27rpx; background: #f8fafc; border-radius: 14rpx; }
.textarea { width: 100%; min-height: 120rpx; padding: 18rpx; font-size: 26rpx; line-height: 1.7; background: #f8fafc; border-radius: 14rpx; }
.picker { padding: 22rpx; font-size: 27rpx; background: #f8fafc; border-radius: 14rpx; }
.chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.chip { padding: 10rpx 20rpx; font-size: 24rpx; color: #475569; background: #f1f5f9; border-radius: 999rpx; }
.chip.active { color: #fff; background: #2563eb; }
.empty { font-size: 22rpx; color: #94a3b8; }
.actions { display: flex; flex-direction: column; gap: 16rpx; margin-top: 8rpx; }
.primary { height: 88rpx; line-height: 88rpx; font-size: 30rpx; color: #fff; background: #2563eb; border-radius: 16rpx; }
.danger { height: 76rpx; line-height: 76rpx; font-size: 26rpx; color: #fff; background: #ef4444; border-radius: 16rpx; }
