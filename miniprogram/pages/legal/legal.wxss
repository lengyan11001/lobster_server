.page { padding: 32rpx 32rpx 80rpx; background: #fff; min-height: 100vh; }
.doc-title { display: block; font-size: 40rpx; font-weight: 700; color: #0f172a; }
.doc-meta { display: block; margin-top: 10rpx; font-size: 22rpx; color: #94a3b8; }
.sec { margin-top: 32rpx; }
.sec-h { display: block; font-size: 28rpx; font-weight: 600; color: #0f172a; margin-bottom: 10rpx; }
.sec-p { display: block; font-size: 26rpx; line-height: 1.75; color: #475569; }
.doc-foot { display: block; margin-top: 48rpx; text-align: center; font-size: 22rpx; color: #94a3b8; }
