<view class="page">
  <view class="head">
    <view><text class="title">数字人视频</text><text class="sub">点开预览，右上角新建</text></view>
    <view class="add-fab" bindtap="goCreate">＋</view>
  </view>
  <view wx:if="{{loading && !items.length}}" class="empty">加载中…</view>
  <view wx:elif="{{!items.length}}" class="empty">还没有生成记录</view>

  <view wx:for="{{items}}" wx:key="id" class="card">
    <view class="card-top" data-id="{{item.id}}" bindtap="toggle">
      <text class="card-title">{{item.title}}</text>
      <text class="chip">{{item.statusText || '已完成'}}</text>
    </view>
    <text class="card-meta">{{item.time}}</text>
    <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" class="cover" />
    <block wx:if="{{openId === item.id}}">
      <video wx:if="{{item.videoUrl}}" src="{{item.videoUrl}}" class="video" controls></video>
      <view class="actions">
        <button wx:if="{{item.videoUrl}}" class="ghost mini" catchtap="copyUrl" data-id="{{item.id}}">复制链接</button>
      </view>
    </block>
  </view>
</view>
