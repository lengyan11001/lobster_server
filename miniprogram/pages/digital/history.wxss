.page { padding: 24rpx; }
.head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.title { display: block; font-size: 38rpx; font-weight: 600; color: #0f172a; }
.sub { display: block; margin-top: 6rpx; font-size: 22rpx; color: #94a3b8; }
.empty { padding: 120rpx 0; text-align: center; color: #94a3b8; }
.card { background: #fff; border-radius: 18rpx; padding: 24rpx; margin-bottom: 16rpx; }
.card-top { display: flex; justify-content: space-between; gap: 16rpx; }
.card-title { flex: 1; font-size: 28rpx; color: #0f172a; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.chip { font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 999rpx; background: #ecfdf5; color: #059669; }
.card-meta { display: block; margin-top: 8rpx; font-size: 22rpx; color: #94a3b8; }
.cover { width: 100%; height: 260rpx; margin-top: 14rpx; border-radius: 12rpx; background: #f1f5f9; }
.video { width: 100%; height: 420rpx; margin-top: 16rpx; border-radius: 12rpx; }
.actions { display: flex; gap: 16rpx; margin-top: 16rpx; }
.primary.small { margin: 0; height: 60rpx; line-height: 60rpx; padding: 0 22rpx; font-size: 24rpx; border-radius: 999rpx; }
.ghost.mini { margin: 0; height: 60rpx; line-height: 60rpx; padding: 0 24rpx; font-size: 24rpx; border-radius: 999rpx; }
