.page { min-height: 100vh; padding: 28rpx; background: #f3f6fb; }
.head { padding: 12rpx 4rpx 24rpx; }
.title { display: block; font-size: 42rpx; font-weight: 700; }
.sub { display: block; margin-top: 8rpx; font-size: 24rpx; color: #64748b; }
.panel { padding: 28rpx; margin-bottom: 24rpx; background: #fff; border-radius: 24rpx; box-shadow: 0 12rpx 32rpx rgba(15,23,42,0.06); }
.panel-head { display: flex; align-items: center; justify-content: space-between; }
.label { display: block; margin: 16rpx 0 12rpx; font-size: 24rpx; color: #64748b; }
.hint { font-size: 22rpx; color: #94a3b8; }
.empty { padding: 24rpx; font-size: 24rpx; color: #94a3b8; line-height: 1.6; }
.hscroll { white-space: nowrap; }
.avatar-row { display: flex; gap: 16rpx; }
.avatar-card { width: 160rpx; padding: 8rpx; border: 2rpx solid transparent; border-radius: 16rpx; background: #f8fafc; }
.avatar-card.active { border-color: #2563eb; background: #eff6ff; }
.avatar-img { width: 144rpx; height: 180rpx; border-radius: 12rpx; background: #e2e8f0; }
.avatar-empty { display: flex; align-items: center; justify-content: center; font-size: 40rpx; color: #94a3b8; }
.avatar-name { display: block; margin-top: 8rpx; font-size: 22rpx; color: #0f172a; overflow: hidden; text-overflow: ellipsis; }
.avatar-status { display: block; font-size: 20rpx; color: #f59e0b; }
.avatar-status.ok { color: #16a34a; }
.picker { padding: 22rpx; font-size: 28rpx; background: #f8fafc; border-radius: 16rpx; }
.input { width: 100%; height: 80rpx; padding: 0 20rpx; font-size: 28rpx; background: #f8fafc; border-radius: 16rpx; }
.textarea { width: 100%; min-height: 220rpx; padding: 20rpx; font-size: 28rpx; line-height: 1.7; background: #f8fafc; border-radius: 16rpx; }
.tpl-row { display: flex; gap: 16rpx; }
.tpl { width: 170rpx; padding: 8rpx; border: 2rpx solid transparent; border-radius: 16rpx; background: #f8fafc; }
.tpl.active { border-color: #2563eb; background: #eff6ff; }
.tpl-img { width: 154rpx; height: 210rpx; border-radius: 12rpx; background: #e2e8f0; }
.tpl-empty { display: flex; align-items: center; justify-content: center; color: #94a3b8; }
.tpl-name { display: block; margin-top: 8rpx; font-size: 22rpx; color: #334155; }
.switch-row { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; font-size: 26rpx; color: #334155; border-top: 2rpx solid #f1f5f9; }
.primary { margin-top: 24rpx; height: 88rpx; line-height: 88rpx; color: #fff; font-size: 30rpx; background: #2563eb; border-radius: 16rpx; }
.primary[disabled] { opacity: 0.5; }
.ghost { margin-top: 16rpx; height: 76rpx; line-height: 76rpx; font-size: 26rpx; color: #2563eb; background: #eff6ff; border-radius: 16rpx; }
.status { font-size: 28rpx; color: #0f172a; }
.video { width: 100%; margin-top: 20rpx; border-radius: 16rpx; }
.hist { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0; border-top: 2rpx solid #f1f5f9; }
.hist-cover { width: 96rpx; height: 120rpx; border-radius: 10rpx; background: #e2e8f0; }
.hist-empty { display: flex; align-items: center; justify-content: center; color: #94a3b8; }
.hist-title { display: block; font-size: 26rpx; color: #0f172a; }
.hist-meta { display: block; margin-top: 6rpx; font-size: 22rpx; color: #94a3b8; }.param-grid { display: flex; flex-wrap: wrap; gap: 8rpx 24rpx; margin-top: 12rpx; }
.param { width: 320rpx; }
.param-label { display: block; font-size: 22rpx; color: #64748b; }
.picker.small { padding: 14rpx 18rpx; font-size: 24rpx; }
.picker.tiny { padding: 10rpx 16rpx; font-size: 24rpx; background: #f1f5f9; border-radius: 999rpx; }
.mode-row { display: flex; gap: 12rpx; margin-bottom: 12rpx; }
.mode { flex: 1; padding: 16rpx 0; text-align: center; font-size: 26rpx; color: #475569; background: #f1f5f9; border-radius: 14rpx; }
.mode.active { color: #fff; background: #2563eb; }
.audio-box { position: relative; padding: 24rpx; font-size: 26rpx; color: #334155; background: #f8fafc; border: 2rpx dashed #cbd5e1; border-radius: 16rpx; }
.audio-clear { position: absolute; top: 8rpx; right: 16rpx; font-size: 34rpx; color: #ef4444; }
.link { font-size: 24rpx; color: #2563eb; }
.mat-row { display: flex; flex-wrap: wrap; gap: 16rpx; }
.mat { position: relative; width: 140rpx; height: 140rpx; }
.mat-thumb { width: 140rpx; height: 140rpx; border-radius: 12rpx; background: #e2e8f0; }
.mat-video { display: flex; align-items: center; justify-content: center; font-size: 22rpx; color: #64748b; }
.mat-del { position: absolute; top: -10rpx; right: -10rpx; width: 36rpx; height: 36rpx; line-height: 34rpx; text-align: center; font-size: 26rpx; color: #fff; background: #ef4444; border-radius: 50%; }
.mat-add { width: 140rpx; height: 140rpx; line-height: 140rpx; text-align: center; font-size: 48rpx; color: #94a3b8; background: #f8fafc; border: 2rpx dashed #cbd5e1; border-radius: 12rpx; }
.asset-tabs { display: flex; align-items: center; gap: 16rpx; margin: 20rpx 0 12rpx; }
.asset-tab { padding: 10rpx 22rpx; font-size: 24rpx; color: #475569; background: #f1f5f9; border-radius: 999rpx; }
.asset-tab.active { color: #fff; background: #2563eb; }
.asset-row { display: flex; gap: 12rpx; }
.asset { position: relative; width: 130rpx; height: 130rpx; border: 4rpx solid transparent; border-radius: 12rpx; }
.asset.active { border-color: #2563eb; }
.asset-thumb { width: 122rpx; height: 122rpx; border-radius: 10rpx; background: #e2e8f0; }
.asset-video { display: flex; align-items: center; justify-content: center; font-size: 20rpx; color: #64748b; }
.asset-check { position: absolute; right: 4rpx; bottom: 4rpx; width: 32rpx; height: 32rpx; line-height: 30rpx; text-align: center; font-size: 22rpx; color: #fff; background: #2563eb; border-radius: 50%; }
.btn-row { display: flex; gap: 16rpx; }
.btn-row .half { flex: 1; }.sub-panel { padding: 20rpx; margin: 12rpx 0 20rpx; background: #f8fafc; border-radius: 16rpx; }
.input.top { margin-top: 16rpx; }
.agree { display: flex; align-items: center; gap: 10rpx; margin: 16rpx 0; font-size: 24rpx; color: #475569; }
.status.small { margin-top: 12rpx; font-size: 24rpx; color: #64748b; }
.voice-row { display: flex; align-items: center; gap: 16rpx; }
.voice-picker { flex: 1; }
.ghost.mini { margin-top: 0; width: 140rpx; height: 76rpx; line-height: 76rpx; }
.search-row { display: flex; align-items: center; gap: 16rpx; margin: 12rpx 0; }
.search { flex: 1; height: 68rpx; padding: 0 20rpx; font-size: 24rpx; background: #f8fafc; border-radius: 999rpx; }
.search.flex { margin: 0 8rpx; }.err { display: block; padding: 8rpx 4rpx; font-size: 24rpx; line-height: 1.6; color: #dc2626; }.asset-pick { position: absolute; top: 4rpx; right: 4rpx; width: 34rpx; height: 34rpx; line-height: 32rpx; text-align: center; font-size: 22rpx; color: #fff; background: rgba(37,99,235,0.9); border-radius: 50%; }
.asset.active .asset-pick { background: #16a34a; }.play-badge { position: absolute; left: 8rpx; bottom: 8rpx; width: 34rpx; height: 34rpx; line-height: 34rpx; text-align: center; font-size: 18rpx; color: #fff; background: rgba(0,0,0,0.55); border-radius: 50%; }
.play-badge.small { width: 30rpx; height: 30rpx; line-height: 30rpx; font-size: 16rpx; }
.quick-links { display: flex; gap: 28rpx; padding: 0 8rpx 20rpx; }
.quick-link { font-size: 26rpx; color: #2563eb; }

.head-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.primary.small { margin: 0; height: 64rpx; line-height: 64rpx; padding: 0 24rpx; font-size: 24rpx; color: #fff; background: #2563eb; border-radius: 999rpx; }
.overlay { position: fixed; inset: 0; z-index: 99; display: flex; align-items: flex-end; background: rgba(15,23,42,0.5); }
.sheet { width: 100%; max-height: 80vh; overflow-y: auto; padding: 28rpx; background: #fff; border-radius: 24rpx 24rpx 0 0; }
.sheet-head { display: flex; align-items: center; justify-content: space-between; }
.sheet-title { font-size: 30rpx; font-weight: 600; }
.sheet-close { font-size: 40rpx; color: #94a3b8; }
.pick { padding: 22rpx 0; border-top: 2rpx solid #f1f5f9; }
.pick-name { display: block; font-size: 28rpx; color: #0f172a; }
.pick-meta { display: block; margin-top: 6rpx; font-size: 22rpx; color: #94a3b8; }
.pick-dim { opacity: 0.4; }
.extract-mask { position: fixed; inset: 0; z-index: 120; display: flex; align-items: center; justify-content: center; background: rgba(15,23,42,0.55); }
.extract-card { width: 78%; padding: 56rpx 40rpx 44rpx; background: #fff; border-radius: 28rpx; box-shadow: 0 24rpx 60rpx rgba(15,23,42,0.28); display: flex; flex-direction: column; align-items: center; }
.extract-dots { display: flex; padding-left: 18rpx; }
.dot { width: 16rpx; height: 16rpx; margin-right: 18rpx; border-radius: 50%; background: #2563eb; opacity: 0.3; animation: dotPulse 1.2s infinite ease-in-out; }
.d2 { animation-delay: 0.15s; }
.d3 { animation-delay: 0.3s; }
@keyframes dotPulse { 0%,100% { opacity: 0.25; transform: translateY(0); } 50% { opacity: 1; transform: translateY(-8rpx); } }
.extract-title { margin-top: 24rpx; font-size: 32rpx; font-weight: 700; color: #0f172a; }
.extract-steps { margin-top: 28rpx; width: 100%; }
.step { display: flex; align-items: center; padding: 10rpx 0; font-size: 24rpx; color: #94a3b8; }
.step.on { color: #2563eb; }
.step-dot { width: 12rpx; height: 12rpx; margin-right: 16rpx; border-radius: 50%; background: #cbd5e1; flex: none; }
.step.on .step-dot { background: #2563eb; }
.extract-tip { margin-top: 24rpx; font-size: 22rpx; color: #94a3b8; }

.dh-tpl { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 24rpx; margin-bottom: 20rpx; background: #eff6ff; border-radius: 16rpx; }
.dh-tpl-text { font-size: 24rpx; color: #1d4ed8; }
.dh-tpl-link { font-size: 24rpx; color: #2563eb; }
