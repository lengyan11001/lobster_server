.page { min-height: 100vh; padding: 28rpx; background: #f3f6fb; }
.head { padding: 12rpx 4rpx 20rpx; }
.title { display: block; font-size: 42rpx; font-weight: 700; }
.sub { display: block; margin-top: 8rpx; font-size: 24rpx; color: #64748b; }
.tabs { display: flex; gap: 12rpx; padding-bottom: 20rpx; }
.tab { padding: 12rpx 24rpx; font-size: 26rpx; color: #475569; background: #fff; border-radius: 999rpx; }
.tab.active { color: #fff; background: #2563eb; }
.card { display: flex; gap: 20rpx; padding: 20rpx; margin-bottom: 20rpx; background: #fff; border-radius: 20rpx; }
.cover { width: 180rpx; height: 180rpx; border-radius: 14rpx; background: #e2e8f0; }
.cover-empty { display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #94a3b8; }
.card-body { flex: 1; display: flex; flex-direction: column; }
.card-title { font-size: 28rpx; font-weight: 600; color: #0f172a; }
.card-summary { margin-top: 8rpx; font-size: 24rpx; color: #64748b; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.card-meta { margin-top: auto; font-size: 22rpx; color: #94a3b8; }
.empty { padding: 40rpx; text-align: center; font-size: 24rpx; color: #94a3b8; }
.more { padding-top: 8rpx; }
.ghost { height: 76rpx; line-height: 76rpx; font-size: 26rpx; color: #2563eb; background: #eff6ff; border-radius: 16rpx; }
.danger { height: 76rpx; line-height: 76rpx; font-size: 26rpx; color: #fff; background: #ef4444; border-radius: 16rpx; }
.overlay { position: fixed; inset: 0; z-index: 99; display: flex; align-items: flex-end; background: rgba(15,23,42,0.5); }
.sheet { width: 100%; max-height: 86vh; overflow-y: auto; padding: 28rpx; background: #fff; border-radius: 24rpx 24rpx 0 0; }
.sheet-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.sheet-title { flex: 1; font-size: 30rpx; font-weight: 600; }
.sheet-close { font-size: 40rpx; color: #94a3b8; }
.video, .image { width: 100%; margin-top: 20rpx; border-radius: 16rpx; }
.content { display: block; margin-top: 20rpx; font-size: 26rpx; line-height: 1.8; color: #1f2937; white-space: pre-wrap; }
.sheet-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.sheet-actions .half { flex: 1; }
@import "../../styles/dark.wxss";
