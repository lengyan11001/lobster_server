<view class="page">
  <view class="head"><text class="title">充值算力</text><text class="sub">选择套餐，微信支付</text></view>
  <view class="modes">
    <view class="mode {{mode === 'package' ? 'active' : ''}}" data-mode="package" bindtap="setMode">套餐</view>
    <view class="mode {{mode === 'custom' ? 'active' : ''}}" data-mode="custom" bindtap="setMode">自定义金额</view>
  </view>
  <view wx:if="{{mode === 'custom'}}" class="custom-box">
    <text class="custom-label">充值金额（元）</text>
    <input class="custom-input" type="digit" value="{{customAmount}}" bindinput="onCustomAmount" placeholder="最低 1 元" />
  </view>
  <view class="list" wx:if="{{mode === 'package'}}">
    <view wx:for="{{packages}}" wx:key="index" class="pkg {{selected === index ? 'active' : ''}}" data-index="{{index}}" bindtap="select">
      <text class="pkg-price">¥{{item.price}}</text>
      <text class="pkg-credits">{{item.credits}} 算力</text>
      <text class="pkg-label">{{item.label}}</text>
    </view>
  </view>
  <button class="primary" loading="{{paying}}" disabled="{{paying}}" bindtap="pay">微信支付</button>
  <text wx:if="{{statusText}}" class="status">{{statusText}}</text>
</view>
