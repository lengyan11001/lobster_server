.page { min-height: 100vh; padding: 24rpx; background: #f8f9fa; }
.card { margin-bottom: 24rpx; padding: 24rpx; background: #fff; border-radius: 28rpx; box-shadow: 0 16rpx 56rpx rgba(15,23,42,.06); }
.title { display: block; font-size: 32rpx; font-weight: 700; color: #0f172a; }
.title.small { font-size: 26rpx; }
.hint { display: block; margin-top: 8rpx; font-size: 22rpx; color: #94a3b8; }
.env { display: block; margin-top: 16rpx; font-size: 22rpx; color: #334155; white-space: pre-wrap; word-break: break-all; }
.btn { margin-top: 16rpx; height: 84rpx; line-height: 84rpx; border-radius: 20rpx; font-size: 27rpx; }
.btn.primary { color: #fff; background: linear-gradient(135deg,#1957E8,#00D6B9); }
.btn.ghost { color: #1957E8; background: #fff; border: 1rpx solid #eef1f6; }
.line { display: block; margin-top: 8rpx; font-size: 22rpx; color: #64748b; }
.log { display: block; margin-top: 6rpx; font-size: 21rpx; color: #334155; word-break: break-all; }
