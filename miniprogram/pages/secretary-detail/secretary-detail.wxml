<view class="page">
  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <block wx:else>
    <view class="panel">
      <view class="top">
        <text class="title">{{record.name}}</text>
        <text class="chip {{record.status}}">{{record.statusText}}</text>
      </view>
      <text class="meta">{{record.sourceLabel}} · {{record.time}}</text>

      <view class="actions">
        <button class="ghost half" loading="{{audioLoading}}" bindtap="playAudio">{{playing ? '停止播放' : '播放录音'}}</button>
        <button class="primary half" loading="{{extracting}}" disabled="{{extracting}}" bindtap="extractProfile">提取资料</button>
        <button wx:if="{{record.status === 'failed' || record.error}}" class="ghost half" bindtap="retry">{{record.status === 'failed' ? '重新转写' : '重新生成摘要'}}</button>
        <button class="danger half" bindtap="remove">删除</button>
      </view>
      <text wx:if="{{record.error}}" class="err">{{record.error}}</text>
    </view>

    <view wx:if="{{record.summary}}" class="panel">
      <text class="label">摘要</text>
      <text class="body">{{record.summary}}</text>
    </view>

    <view wx:if="{{record.keyPoints.length}}" class="panel">
      <text class="label">要点</text>
      <text wx:for="{{record.keyPoints}}" wx:key="*this" class="point">· {{item}}</text>
    </view>

    <view class="panel">
      <text class="label">转写全文</text>
      <text wx:if="{{record.transcript}}" class="body" user-select="{{true}}">{{record.transcript}}</text>
      <text wx:else class="empty-text">还没有转写内容</text>
    </view>
  </block>
</view>
<view wx:if="{{extractOpen}}" class="ex-mask" catchtap="closeExtract">
  <view class="ex-sheet" catchtap="extractNoop">
    <view class="ex-head"><text class="ex-title">AI 提取：资料 / 关键词 / 同行 / 记忆</text><text class="ex-close" catchtap="closeExtract">×</text></view>
    <scroll-view scroll-y class="ex-body">
      <view class="ex-section">① 资料调查</view>
      <block wx:for="{{extractFields}}" wx:key="key">
        <view wx:if="{{item.key === 'gender'}}" class="ex-field">
          <text class="ex-label">{{item.label}}</text>
          <picker range="{{['未填写','女','男']}}" value="{{extractGenderIndex}}" bindchange="onGenderChange">
            <view class="ex-input">{{['未填写','女','男'][extractGenderIndex]}}</view>
          </picker>
        </view>
        <view wx:else class="ex-field">
          <text class="ex-label">{{item.label}}</text>
          <input class="ex-input" value="{{item.value}}" data-index="{{index}}" bindinput="onExtractInput" placeholder="可修改或补充" />
        </view>
      </block>

      <view class="ex-section">② 关键词</view>
      <view wx:for="{{extractKeywords}}" wx:key="index" class="ex-row-item">
        <input class="ex-input half" value="{{item.keyword}}" data-index="{{index}}" data-field="keyword" bindinput="onKwInput" placeholder="关键词" />
        <input class="ex-input half" value="{{item.display_name}}" data-index="{{index}}" data-field="display_name" bindinput="onKwInput" placeholder="备注/简称" />
        <text class="ex-del" data-index="{{index}}" catchtap="removeKeyword">删</text>
      </view>
      <view class="ex-add" catchtap="addKeyword">+ 添加一条关键词</view>

      <view class="ex-section">③ 同行</view>
      <view wx:for="{{extractCompetitors}}" wx:key="index" class="ex-row-item">
        <picker range="{{['抖音','视频号','小红书','快手','其他']}}" value="{{0}}" data-index="{{index}}" bindchange="onCpPlatform">
          <view class="ex-input third">{{item.platform === 'douyin' ? '抖音' : (item.platform === 'channels' ? '视频号' : (item.platform === 'xiaohongshu' ? '小红书' : (item.platform === 'kuaishou' ? '快手' : '其他')))}}</view>
        </picker>
        <input class="ex-input half" value="{{item.account}}" data-index="{{index}}" data-field="account" bindinput="onCpInput" placeholder="账号名/ID" />
        <text class="ex-del" data-index="{{index}}" catchtap="removeCompetitor">删</text>
      </view>
      <view class="ex-add" catchtap="addCompetitor">+ 添加一个同行</view>

      <view class="ex-section">④ 记忆文件</view>
      <view wx:for="{{extractDocs}}" wx:key="key" class="ex-row" data-index="{{index}}" catchtap="toggleExtractItem">
        <view class="ex-box {{item.checked ? 'on' : ''}}">{{item.checked ? '✓' : ''}}</view>
        <view class="ex-copy"><text class="ex-label">{{item.title}}</text><text class="ex-value">写入个人记忆</text></view>
      </view>
      <view wx:if="{{!extractFields.length && !extractDocs.length}}" class="ex-empty">没有提取到可写入的内容</view>
      <view class="ex-field">
        <text class="ex-label">模板名称（存为模板时用）</text>
        <input class="ex-input" value="{{templateName}}" bindinput="onTemplateName" placeholder="例如：我的个人IP模板" />
      </view>
    </scroll-view>
    <view class="ex-actions">
      <button class="ghost third" catchtap="closeExtract">取消</button>
      <button class="ghost third" catchtap="saveTemplate">存为模板</button>
      <button class="primary third" catchtap="saveExtract">保存到个人设置</button>
    </view>
  </view>
</view>
