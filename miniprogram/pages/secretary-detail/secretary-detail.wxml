<view class="page">
  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <block wx:else>
    <view class="panel">
      <view class="top">
        <text class="title">{{record.name}}</text>
        <text class="chip {{record.status}}">{{record.statusText}}</text>
      </view>
      <text class="meta">{{record.sourceLabel}} · {{record.time}}</text>

      <view class="actions">
        <button class="ghost half" loading="{{audioLoading}}" bindtap="playAudio">{{playing ? '停止播放' : '播放录音'}}</button>
        <button class="primary half" loading="{{extracting}}" disabled="{{extracting}}" bindtap="extractProfile">提取资料</button>
        <button wx:if="{{record.status === 'failed' || record.error}}" class="ghost half" bindtap="retry">{{record.status === 'failed' ? '重新转写' : '重新生成摘要'}}</button>
        <button class="danger half" bindtap="remove">删除</button>
      </view>
      <text wx:if="{{record.error}}" class="err">{{record.error}}</text>
    </view>

    <view wx:if="{{record.summary}}" class="panel">
      <text class="label">摘要</text>
      <text class="body">{{record.summary}}</text>
    </view>

    <view wx:if="{{record.keyPoints.length}}" class="panel">
      <text class="label">要点</text>
      <text wx:for="{{record.keyPoints}}" wx:key="*this" class="point">· {{item}}</text>
    </view>

    <view class="panel">
      <text class="label">转写全文</text>
      <text wx:if="{{record.transcript}}" class="body" user-select="{{true}}">{{record.transcript}}</text>
      <text wx:else class="empty-text">还没有转写内容</text>
    </view>
  </block>
</view>
<view wx:if="{{extractOpen}}" class="ex-mask" catchtap="closeExtract">
  <view class="ex-sheet" catchtap="extractNoop">
    <view class="ex-head"><text class="ex-title">确认提取结果</text><text class="ex-close" catchtap="closeExtract">×</text></view>
    <scroll-view scroll-y class="ex-body">
      <view wx:for="{{extractFields}}" wx:key="key" class="ex-field">
        <text class="ex-label">{{item.label}}</text>
        <input class="ex-input" value="{{item.value}}" data-index="{{index}}" bindinput="onExtractInput" placeholder="可修改或补充" />
      </view>
      <view wx:for="{{extractDocs}}" wx:key="key" class="ex-row" data-index="{{index}}" catchtap="toggleExtractItem">
        <view class="ex-box {{item.checked ? 'on' : ''}}">{{item.checked ? '✓' : ''}}</view>
        <view class="ex-copy"><text class="ex-label">{{item.title}}</text><text class="ex-value">写入个人记忆</text></view>
      </view>
      <view wx:if="{{!extractFields.length && !extractDocs.length}}" class="ex-empty">没有提取到可写入的内容</view>
    </scroll-view>
    <view class="ex-actions">
      <button class="ghost half" catchtap="closeExtract">取消</button>
      <button class="primary half" catchtap="saveExtract">写入选中项</button>
    </view>
  </view>
</view>
