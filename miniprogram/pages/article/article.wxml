<view class="page">
  <view style="margin:12rpx 0;padding:12rpx 16rpx;border-radius:10rpx;background:#fff7ed;color:#9a3412;font-size:22rpx;line-height:1.6;">AI 生成内容，请注意甄别；生成结果仅供参考。</view>

  <view class="head">
    <view class="head-text">
      <text class="title">公众号文案</text>
      <text class="sub">选题/录音/IP 生成，或粘贴公众号链接复刻改写</text>
    </view>
    <button class="ghost mini" bindtap="goBackList">返回列表</button>
  </view>

  <view class="head-actions">
    <button class="ghost mini" bindtap="openMemory">IP记忆生成</button>
    <button class="ghost mini" bindtap="openRecording">录音生成</button>
    <button class="ghost mini" bindtap="openPrefillHistory">历史</button>
  </view>

  <view class="panel">
    <text class="label">复刻公众号文章（可选）</text>
    <input class="input" value="{{sourceUrl}}" bindinput="onSourceUrl" placeholder="粘贴 mp.weixin.qq.com/s/... 文章链接" />
    <button class="ghost" loading="{{fetchingSource}}" bindtap="fetchSource">抓取原文并改写</button>
    <text wx:if="{{rewriteMode}}" class="hint">{{sourceTitle ? '已抓取：' + sourceTitle : '已抓取原文，生成时会按原文改写'}}</text>
  </view>

  <view class="panel">
    <text class="label">文章主题</text>
    <input class="input" value="{{topic}}" bindinput="onTopicInput" placeholder="例如：小户型收纳的三个反常识" />
    <text class="label">目标读者（可选）</text>
    <input class="input" value="{{audience}}" bindinput="onAudienceInput" placeholder="例如：中小企业老板、门店经营者" />
    <text class="label">要点 / 素材（可选）</text>
    <textarea class="textarea" value="{{points}}" bindinput="onPointsInput" placeholder="产品卖点、案例、想强调的观点" auto-height maxlength="800" />
    <view class="row">
      <text class="label">风格</text>
      <view class="chips">
        <view wx:for="{{tones}}" wx:key="*this" class="chip {{tone === item ? 'active' : ''}}" data-value="{{item}}" bindtap="setTone">{{item}}</view>
      </view>
    </view>
    <button class="primary" loading="{{loading}}" disabled="{{loading}}" bindtap="generate">{{rewriteMode ? '复刻改写并生成' : '生成公众号文案'}}</button>
  </view>

  <view wx:if="{{title || body}}" class="panel">
    <text class="label">标题</text>
    <view class="title-box">{{title}}</view>
    <text class="label">摘要</text>
    <view class="summary-box">{{summary}}</view>
    <text class="label">正文</text>
    <text class="body" user-select="{{true}}">{{body}}</text>
    <button class="ghost" bindtap="copyAll">复制标题 + 正文</button>
    <button class="ghost" bindtap="reset">重新生成</button>
  </view>

  <view wx:if="{{progressText}}" class="progress">{{progressText}}</view>

  <topic-prefill id="topicPrefill" target="article" bind:pick="onPrefillPick" />
</view>
