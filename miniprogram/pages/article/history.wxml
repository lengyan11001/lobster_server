<view class="page">
  <view class="head">
    <view><text class="title">{{title}}</text><text class="sub">点开查看生成内容，右上角新建</text></view>
    <button class="primary small" bindtap="goCreate">+ 新增</button>
  </view>

  <view wx:if="{{!items.length}}" class="empty">还没有生成记录</view>

  <view wx:for="{{items}}" wx:key="id" class="card">
    <view class="card-top" data-id="{{item.id}}" bindtap="toggle">
      <text class="card-title">{{item.title || (feature === 'article' ? '公众号文章' : '混剪任务')}}</text>
      <text class="chip {{item.status === 'failed' ? 'failed' : 'completed'}}">{{item.status === 'failed' ? '失败' : (item.status === 'processing' ? '生成中' : '已完成')}}</text>
    </view>
    <text class="card-meta">{{item.timeText}}</text>

    <block wx:if="{{openId === item.id}}">
      <text wx:if="{{item.summary}}" class="summary">{{item.summary}}</text>
      <text wx:if="{{item.content}}" class="content">{{item.content}}</text>
      <view wx:if="{{item.images.length}}" class="img-grid">
        <image wx:for="{{item.images}}" wx:for-item="img" wx:key="*this" src="{{img}}" mode="aspectFill" class="img" data-url="{{img}}" data-id="{{item.id}}" catchtap="previewImage" />
      </view>
      <video wx:if="{{item.videoUrl}}" src="{{item.videoUrl}}" class="video" controls></video>
      <view class="actions">
        <button wx:if="{{item.content}}" class="ghost mini" catchtap="copyText" data-id="{{item.id}}">复制</button>
        <button wx:if="{{item.taskId && item.status === 'processing'}}" class="ghost mini" catchtap="refreshStatus" data-id="{{item.id}}">刷新状态</button>
        <button class="ghost mini danger" catchtap="remove" data-id="{{item.id}}">删除</button>
      </view>
    </block>
  </view>
</view>

<view wx:if="{{modalOpen}}" class="overlay" catchtap="closeModal">
  <view class="sheet" catchtap="noop">
    <view class="sheet-head"><text class="sheet-title">新建公众号文章</text><text class="sheet-close" catchtap="closeModal">×</text></view>
    <text class="label">文章主题</text>
    <textarea class="input" value="{{topic}}" bindinput="onTopic" placeholder="例如：AI 如何改变中小企业获客" auto-height maxlength="200" />
    <text class="label">要点 / 素材（可选）</text>
    <textarea class="input small" value="{{points}}" bindinput="onPoints" placeholder="可分条写" auto-height maxlength="2000" />
    <text class="label">目标读者（可选）</text>
    <textarea class="input small" value="{{audience}}" bindinput="onAudience" placeholder="例如：中小企业老板" auto-height maxlength="200" />
    <button class="primary" loading="{{generating}}" bindtap="submitArticle">创建</button>
  </view>
</view>
