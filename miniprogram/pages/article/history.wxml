<view class="page">
  <view class="head">
    <view><text class="title">{{title}}</text></view>
    <view class="head-action" bindtap="goCreate">＋ 新建</view>
  </view>

  <view wx:if="{{!items.length}}" class="empty">还没有生成记录</view>

  <view wx:for="{{items}}" wx:key="id" class="card">
    <view class="card-top" data-id="{{item.id}}" bindtap="toggle">
      <text class="card-title">{{item.title || (feature === 'article' ? '公众号文章' : '混剪任务')}}</text>
      <view class="card-top-right">
        <text wx:if="{{feature === 'article' && item.content}}" class="draft-link" catchtap="sendToDraft" data-id="{{item.id}}">发草稿</text>
        <text class="chip {{item.status === 'failed' ? 'failed' : (item.status === 'processing' ? 'processing' : 'completed')}}">{{item.statusText || (item.status === 'failed' ? '失败' : (item.status === 'processing' ? '生成中' : '已完成'))}}</text>
      </view>
    </view>
    <text class="card-meta">{{item.timeText}}</text>
    <text wx:if="{{feature === 'article' && !item.content}}" class="missing-hint">这条记录没有保存正文，旧版本可能只保存了标题</text>
    <button wx:if="{{feature === 'article' && !item.content && item.payload}}" class="ghost mini missing-btn" catchtap="regenerate" data-id="{{item.id}}">补生成正文</button>

    <block wx:if="{{openId === item.id}}">
      <text wx:if="{{item.summary}}" class="summary">{{item.summary}}</text>
      <block wx:for="{{item.blocks}}" wx:key="key" wx:for-item="blk">
        <text wx:if="{{blk.type === 'text'}}" class="content">{{blk.text}}</text>
        <image wx:else class="inline-img" src="{{blk.url}}" mode="widthFix" data-url="{{blk.url}}" data-id="{{item.id}}" catchtap="previewImage" />
      </block>
      <text wx:if="{{!item.blocks.length && item.content}}" class="content">{{item.content}}</text>
      
      <video wx:if="{{item.videoUrl}}" src="{{item.videoUrl}}" class="video" controls></video>
      <view class="actions">
        <button wx:if="{{item.content}}" class="ghost mini" catchtap="copyArticle" data-id="{{item.id}}">{{item.images.length ? '复制文字+保存图片' : '复制'}}</button>
        <button wx:if="{{feature === 'article' && item.content}}" class="ghost mini" catchtap="sendToDraft" data-id="{{item.id}}">发到公众号草稿</button>
        <button wx:if="{{item.taskId && item.status === 'processing'}}" class="ghost mini" catchtap="refreshStatus" data-id="{{item.id}}">刷新状态</button>
        <button class="ghost mini danger" catchtap="remove" data-id="{{item.id}}">删除</button>
      </view>
    </block>
  </view>
</view>
