page { background: #f8f9fa; color: #0f172a; }

.templates-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  padding: 28rpx 32rpx 0;
  color: #0f172a;
  background: #f8f9fa;
}

.space-layer {
  position: absolute;
  pointer-events: none;
}

.stars-a {
  left: 0;
  right: 0;
  top: 0;
  height: 100%;
  background-image: radial-gradient(circle, rgba(255,255,255,0.72) 0 2rpx, transparent 3rpx);
  background-size: 112rpx 146rpx;
  opacity: 0.28;
}

.stars-b {
  left: -20%;
  right: -20%;
  top: 180rpx;
  height: 900rpx;
  background-image: radial-gradient(circle, rgba(16,245,221,0.7) 0 2rpx, transparent 4rpx);
  background-size: 230rpx 210rpx;
  opacity: 0.14;
}

.page-top,
.hero-panel,
.template-grid,
.loading-grid,
.empty-card {
  position: relative;
  z-index: 1;
}

.page-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 68rpx;
  width: 68rpx;
  height: 68rpx;
  margin: 0;
  padding: 0;
  color: #0f172a;
  background: #ffffff;
  border: 1rpx solid #eef1f6;
  border-radius: 999rpx;
  font-size: 52rpx;
  line-height: 1;
}

.page-title-block {
  min-width: 0;
}

.page-title,
.page-sub,
.hero-title,
.hero-sub,
.template-title,
.template-sub {
  display: block;
}

.page-title {
  font-size: 34rpx;
  font-weight: 900;
}

.page-sub {
  margin-top: 6rpx;
  color: rgba(226,232,240,0.62);
  font-size: 22rpx;
}

.hero-panel {
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-height: 150rpx;
  margin-top: 28rpx;
  padding: 26rpx;
  background: #f8f9fa;
  border: 1rpx solid rgba(16, 245, 221, 0.2);
  border-radius: 28rpx;
}

.hero-panel view {
  flex: 1;
  min-width: 0;
}

.hero-title {
  font-size: 32rpx;
  font-weight: 900;
}

.hero-sub {
  margin-top: 10rpx;
  color: rgba(226,232,240,0.62);
  font-size: 23rpx;
  line-height: 1.45;
}

.hero-panel button,
.empty-card button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 62rpx;
  margin: 0;
  padding: 0 24rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #1957E8, #00D6B9);
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 900;
}

.template-grid,
.loading-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 26rpx;
}

.template-card,
.skeleton-card {
  position: relative;
  min-width: 0;
  height: 360rpx;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid #eef1f6;
  border-radius: 28rpx;
  box-shadow: 0 18rpx 42rpx rgba(15,23,42,0.08);
}

.template-img,
.template-mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.template-static {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #f8f9fa;
}

.tone-1 .template-static {
  background: #f8f9fa;
}

.tone-2 .template-static {
  background: #f8f9fa;
}

.tone-3 .template-static {
  background: #f8f9fa;
}

.tone-4 .template-static {
  background: #f8f9fa;
}

.tone-5 .template-static {
  background: #f8f9fa;
}

.avatar-glow {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  top: 46rpx;
  height: 190rpx;
  border-radius: 999rpx;
  background: rgba(16,245,221,0.13);
  filter: blur(12rpx);
}

.avatar-head {
  position: absolute;
  left: 50%;
  top: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  margin-left: -64rpx;
  color: #ecfeff;
  background: #f8f9fa;
  border: 2rpx solid rgba(255,255,255,0.32);
  border-radius: 999rpx;
  box-shadow: 0 18rpx 40rpx rgba(15,23,42,0.08);
  font-size: 40rpx;
  font-weight: 900;
}

.avatar-body {
  position: absolute;
  left: 50%;
  top: 184rpx;
  width: 190rpx;
  height: 158rpx;
  margin-left: -95rpx;
  background: #f8f9fa;
  border: 2rpx solid rgba(255,255,255,0.18);
  border-radius: 76rpx 76rpx 28rpx 28rpx;
}

.avatar-line {
  position: absolute;
  height: 2rpx;
  background: #f8f9fa;
}

.line-a {
  left: 20rpx;
  right: 20rpx;
  top: 232rpx;
}

.line-b {
  left: 42rpx;
  right: 42rpx;
  top: 272rpx;
}

.template-mask {
  background: #f8f9fa;
}

.template-copy {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: 18rpx;
  z-index: 2;
}

.template-title {
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.template-sub {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 21rpx;
}

.skeleton-card {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 20rpx;
  background: linear-gradient(135deg, #1957E8, #00D6B9); color: #ffffff;}

.skeleton-card view {
  width: 104rpx;
  height: 104rpx;
  margin: auto;
  border-radius: 999rpx;
  background: #ffffff;
}

.skeleton-card text {
  display: block;
  width: 70%;
  height: 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
  margin-top: 28rpx;
  padding: 44rpx 28rpx;
  background: #ffffff;
  border: 1rpx solid #eef1f6;
  border-radius: 28rpx;
}

.empty-card text {
  color: rgba(226,232,240,0.72);
  font-size: 24rpx;
}

.bottom-space {
  height: 52rpx;
}
