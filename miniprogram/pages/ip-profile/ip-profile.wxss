.page { min-height: 100vh; padding: 28rpx; background: #f8f9fa; }
.tabs { display: flex; gap: 10rpx; padding-bottom: 20rpx; flex-wrap: wrap; }
.tab { padding: 12rpx 22rpx; font-size: 24rpx; color: #475569; background: #fff; border-radius: 999rpx; }
.tab.active { color: #ffffff; background: linear-gradient(135deg, #1957E8, #00D6B9); }
.panel { padding: 26rpx; background: #fff; border-radius: 20rpx; }
.field { margin-bottom: 20rpx; }
.label { display: block; margin-bottom: 10rpx; font-size: 24rpx; color: #64748b; }
.input { width: 100%; height: 78rpx; padding: 0 20rpx; font-size: 27rpx; background: #f8fafc; border-radius: 14rpx; }
.textarea { width: 100%; min-height: 130rpx; padding: 18rpx; font-size: 26rpx; line-height: 1.7; background: #f8fafc; border-radius: 14rpx; }
.primary { margin-top: 12rpx; height: 86rpx; line-height: 86rpx; font-size: 30rpx; color: #ffffff; background: linear-gradient(135deg, #1957E8, #00D6B9); border-radius: 16rpx; }
.primary.small { margin: 0 0 18rpx; height: 68rpx; line-height: 68rpx; font-size: 24rpx; width: 240rpx; }
.empty { padding: 48rpx; text-align: center; font-size: 24rpx; color: #64748b; }
.row { display: flex; align-items: center; justify-content: space-between; padding: 22rpx; margin-bottom: 14rpx; background: #fff; border-radius: 16rpx; }
.row-main { flex: 1; }
.row-title { display: block; font-size: 27rpx; font-weight: 600; color: #0f172a; }
.row-meta { display: block; margin-top: 6rpx; font-size: 22rpx; color: #64748b; }
.link { font-size: 24rpx; color: #1957E8; }
.overlay { position: fixed; inset: 0; z-index: 99; display: flex; align-items: flex-end; background: rgba(15,23,42,0.5); }
.sheet { width: 100%; max-height: 82vh; overflow-y: auto; padding: 28rpx; background: #fff; border-radius: 24rpx 24rpx 0 0; }
.sheet-head { display: flex; align-items: center; justify-content: space-between; }
.sheet-title { font-size: 30rpx; font-weight: 600; }
.sheet-close { font-size: 40rpx; color: #64748b; }
.doc-content { display: block; margin-top: 18rpx; font-size: 26rpx; line-height: 1.85; color: #1f2937; white-space: pre-wrap; }
.row-actions { display: flex; gap: 16rpx; }

.tag-current { padding: 4rpx 14rpx; font-size: 22rpx; color: #16a34a; background: #ecfdf5; border-radius: 999rpx; }

.btn-row { display: flex; gap: 16rpx; margin-bottom: 18rpx; }
.ghost.small { height: 68rpx; line-height: 68rpx; font-size: 24rpx; width: 240rpx; margin: 0; color: #1957E8; background: #eff6ff; border-radius: 14rpx; }

/* 资料调查 */
.survey-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; }
.survey-head-copy { flex: 1; min-width: 0; }
.survey-title { display: block; font-size: 34rpx; font-weight: 700; color: #0f172a; }
.survey-sub { display: block; margin-top: 6rpx; font-size: 21rpx; color: #64748b; }
.survey-add { margin: 0; padding: 0 28rpx; width: auto; }
.survey-row { display: flex; align-items: center; padding: 22rpx; margin-bottom: 14rpx; background: #fff; border: 1rpx solid #eef2f7; border-radius: 18rpx; }
.survey-row.active { border-color: #a5f3fc; background: #f0fdff; }
.survey-row-main { flex: 1; min-width: 0; }
.survey-row-title { display: flex; align-items: center; }
.survey-row-name { font-size: 27rpx; font-weight: 600; color: #0f172a; }
.survey-row-meta { display: block; margin-top: 6rpx; font-size: 21rpx; color: #64748b; }
.survey-row-actions { display: flex; gap: 18rpx; margin-left: 16rpx; }
.danger-text { color: #dc2626; }
.field-hint { display: block; margin-top: 8rpx; margin-bottom: 12rpx; font-size: 21rpx; color: #64748b; }
.editor-sheet { display: flex; flex-direction: column; max-height: 88vh; overflow: hidden; }
.editor-sheet .sheet-body { flex: 1; height: 60vh; margin-top: 16rpx; }
.sheet-actions { display: flex; margin-top: 18rpx; }
.sheet-actions .half { flex: 1; height: 84rpx; line-height: 84rpx; font-size: 26rpx; border-radius: 16rpx; }
.sheet-actions .ghost.half { margin-right: 12rpx; background: #f1f5f9; color: #334155; }
.sheet-actions .primary.half { margin: 0; background: #f8f9fa; }

.page { padding-bottom: 200rpx; }
.section { margin-top: 28rpx; padding: 24rpx; background: #ffffff; border-radius: 22rpx; box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05); }
.section:first-child { margin-top: 8rpx; }
.sec-head { display: flex; flex-direction: column; margin-bottom: 16rpx; }
.sec-title { font-size: 30rpx; font-weight: 700; color: #0f172a; }
.sec-sub { margin-top: 6rpx; font-size: 22rpx; color: #64748b; }
.field { margin-bottom: 4rpx; }
.save-bar { position: fixed; left: 0; right: 0; bottom: 0; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); background: rgba(248, 249, 250, 0.96); box-shadow: 0 -8rpx 24rpx rgba(15, 23, 42, 0.08); z-index: 50; }
.save-btn { width: 100%; height: 84rpx; line-height: 84rpx; border-radius: 999rpx; font-size: 28rpx; color: #ffffff; background: linear-gradient(135deg, #1957E8, #00B3A0); }
.kw-suggest-btn { margin-top: 16rpx; }
.kw-suggest { margin-top: 18rpx; }
.chip-grid { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.kw-chip { padding: 10rpx 20rpx; border-radius: 999rpx; font-size: 24rpx; color: #475569; background: #f1f5f9; border: 1rpx solid #e2e8f0; }
.kw-chip.on { color: #0f766e; background: #ccfbf1; border-color: #5eead4; font-weight: 600; }
.keyword-sheet { max-height: 80vh; overflow-y: auto; }

.pager { display: flex; align-items: center; justify-content: center; gap: 28rpx; margin-top: 18rpx; }
.pager-btn { font-size: 24rpx; color: #1957E8; padding: 8rpx 14rpx; }
.pager-btn.disabled { color: #cbd5e1; }
.pager-info { font-size: 22rpx; color: #64748b; }
