.page { min-height: 100vh; padding: 28rpx; background: #f3f6fb; }
.tabs { display: flex; gap: 10rpx; padding-bottom: 20rpx; flex-wrap: wrap; }
.tab { padding: 12rpx 22rpx; font-size: 24rpx; color: #475569; background: #fff; border-radius: 999rpx; }
.tab.active { color: #fff; background: #2563eb; }
.panel { padding: 26rpx; background: #fff; border-radius: 20rpx; }
.field { margin-bottom: 20rpx; }
.label { display: block; margin-bottom: 10rpx; font-size: 24rpx; color: #64748b; }
.input { width: 100%; height: 78rpx; padding: 0 20rpx; font-size: 27rpx; background: #f8fafc; border-radius: 14rpx; }
.textarea { width: 100%; min-height: 130rpx; padding: 18rpx; font-size: 26rpx; line-height: 1.7; background: #f8fafc; border-radius: 14rpx; }
.primary { margin-top: 12rpx; height: 86rpx; line-height: 86rpx; font-size: 30rpx; color: #fff; background: #2563eb; border-radius: 16rpx; }
.primary.small { margin: 0 0 18rpx; height: 68rpx; line-height: 68rpx; font-size: 24rpx; width: 240rpx; }
.empty { padding: 48rpx; text-align: center; font-size: 24rpx; color: #94a3b8; }
.row { display: flex; align-items: center; justify-content: space-between; padding: 22rpx; margin-bottom: 14rpx; background: #fff; border-radius: 16rpx; }
.row-main { flex: 1; }
.row-title { display: block; font-size: 27rpx; font-weight: 600; color: #0f172a; }
.row-meta { display: block; margin-top: 6rpx; font-size: 22rpx; color: #94a3b8; }
.link { font-size: 24rpx; color: #2563eb; }
.overlay { position: fixed; inset: 0; z-index: 99; display: flex; align-items: flex-end; background: rgba(15,23,42,0.5); }
.sheet { width: 100%; max-height: 82vh; overflow-y: auto; padding: 28rpx; background: #fff; border-radius: 24rpx 24rpx 0 0; }
.sheet-head { display: flex; align-items: center; justify-content: space-between; }
.sheet-title { font-size: 30rpx; font-weight: 600; }
.sheet-close { font-size: 40rpx; color: #94a3b8; }
.doc-content { display: block; margin-top: 18rpx; font-size: 26rpx; line-height: 1.85; color: #1f2937; white-space: pre-wrap; }
.row-actions { display: flex; gap: 16rpx; }

.tag-current { padding: 4rpx 14rpx; font-size: 22rpx; color: #16a34a; background: #ecfdf5; border-radius: 999rpx; }

.btn-row { display: flex; gap: 16rpx; margin-bottom: 18rpx; }
.ghost.small { height: 68rpx; line-height: 68rpx; font-size: 24rpx; width: 240rpx; margin: 0; color: #2563eb; background: #eff6ff; border-radius: 14rpx; }
@import "../../styles/dark.wxss";
