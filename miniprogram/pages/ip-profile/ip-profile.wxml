<view class="page">
  <view class="section">
    <view class="sec-head">
      <text class="sec-title">资料调查</text>
      
    </view>
    <view wx:for="{{profileFields}}" wx:key="key" class="field">
      <text class="label">{{item.label}}</text>
      <textarea wx:if="{{item.multiline}}" class="textarea" value="{{item.value}}" data-key="{{item.key}}" bindinput="onProfileField" auto-height maxlength="2000" />
      <input wx:else class="input" value="{{item.value}}" data-key="{{item.key}}" bindinput="onProfileField" />
    </view>
    <view wx:if="{{loading && !profileFields.length}}" class="empty">加载中…</view>
  </view>

  <view class="section">
    <view class="sec-head">
      <text class="sec-title">上传文件</text>
      <text class="sec-sub">个人资料，产品资料，企业资料等</text>
    </view>
    <view class="btn-row">
      <button class="primary small" bindtap="uploadMemory">上传文件</button>
    </view>
    <view wx:if="{{memoryLoading}}" class="empty">加载中…</view>
    <view wx:elif="{{!memoryDocs.length}}" class="empty">还没有个人记忆文件</view>
    <view wx:for="{{memoryItems}}" wx:key="doc_id" class="row" data-index="{{index}}" bindtap="openDoc">
      <view class="row-main">
        <text class="row-title">{{item.title}}</text>
        <text class="row-meta">{{item.notes || '记忆文件'}}</text>
      </view>
    </view>
    <view wx:if="{{memoryPages > 1}}" class="pager">
      <text class="pager-btn {{memoryPage <= 1 ? 'disabled' : ''}}" data-kind="memory" data-dir="-1" bindtap="changePage">上一页</text>
      <text class="pager-info">{{memoryPage}} / {{memoryPages}}</text>
      <text class="pager-btn {{memoryPage >= memoryPages ? 'disabled' : ''}}" data-kind="memory" data-dir="1" bindtap="changePage">下一页</text>
    </view>
  </view>

  <view class="section">
    <view class="sec-head">
      <text class="sec-title">关键词</text>
      
    </view>
    <button class="primary small" bindtap="openKeywordModal">新增关键词</button>
    <view wx:if="{{keywordLoading}}" class="empty">加载中…</view>
    <view wx:elif="{{!keywords.length}}" class="empty">还没有关键词</view>
    <view wx:for="{{keywordItems}}" wx:key="id" class="row" data-index="{{index}}" bindlongpress="keywordMenu">
      <view class="row-main">
        <text class="row-title">{{item.display_name || item.keyword}}</text>
        <text class="row-meta">{{item.status || ''}} · 长按操作</text>
      </view>
    </view>
    <view wx:if="{{keywordPages > 1}}" class="pager">
      <text class="pager-btn {{keywordPage <= 1 ? 'disabled' : ''}}" data-kind="keyword" data-dir="-1" bindtap="changePage">上一页</text>
      <text class="pager-info">{{keywordPage}} / {{keywordPages}}</text>
      <text class="pager-btn {{keywordPage >= keywordPages ? 'disabled' : ''}}" data-kind="keyword" data-dir="1" bindtap="changePage">下一页</text>
    </view>
  </view>

  <view class="section">
    <view class="sec-head">
      <text class="sec-title">同行</text>
      
    </view>
    <button class="primary small" bindtap="openCompetitorModal">新增同行</button>
    <view wx:if="{{competitorLoading}}" class="empty">加载中…</view>
    <view wx:elif="{{!competitors.length}}" class="empty">还没有同行账号</view>
    <view wx:for="{{competitorItems}}" wx:key="id" class="row" data-index="{{index}}" bindlongpress="competitorMenu">
      <view class="row-main">
        <text class="row-title">{{item.display_name || item.account_key}}</text>
        <text class="row-meta">{{item.platform}} · {{item.status || ''}}{{item.last_fetch_at ? ' · 最近同步 ' + item.last_fetch_at : ''}}</text>
        <text wx:if="{{item.industry_tags}}" class="row-meta">标签：{{item.industry_tags}}</text>
      </view>
      <text class="row-act" data-index="{{index}}" catchtap="syncCompetitorRow">同步</text>
    </view>
    <view wx:if="{{competitorPages > 1}}" class="pager">
      <text class="pager-btn {{competitorPage <= 1 ? 'disabled' : ''}}" data-kind="competitor" data-dir="-1" bindtap="changePage">上一页</text>
      <text class="pager-info">{{competitorPage}} / {{competitorPages}}</text>
      <text class="pager-btn {{competitorPage >= competitorPages ? 'disabled' : ''}}" data-kind="competitor" data-dir="1" bindtap="changePage">下一页</text>
    </view>
  </view>

  <view class="save-bar">
    <button class="primary save-btn" loading="{{profileSaving}}" disabled="{{profileSaving}}" bindtap="saveProfileInline">保存资料</button>
  </view>

  <view wx:if="{{keywordModalOpen}}" class="overlay" catchtap="closeKeywordModal">
    <view class="sheet keyword-sheet" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">新增关键词</text>
        <text class="sheet-close" catchtap="closeKeywordModal">×</text>
      </view>
      <text class="label">关键词</text>
      <input class="input" value="{{keywordInput}}" bindinput="onKeywordInput" placeholder="输入一个关键词，例如：小户型收纳" maxlength="40" />
      <button class="ghost small kw-suggest-btn" loading="{{keywordSuggesting}}" disabled="{{keywordSuggesting}}" bindtap="suggestKeywords">AI 推荐相关词</button>
      <view wx:if="{{suggestItems.length}}" class="kw-suggest">
        <text class="field-hint">勾选要加入的关键词（点一下切换）</text>
        <view class="chip-grid">
          <view wx:for="{{suggestItems}}" wx:key="text" class="kw-chip {{item.checked ? 'on' : ''}}" data-index="{{index}}" bindtap="toggleSuggest">{{item.text}}</view>
        </view>
      </view>
      <view class="sheet-actions">
        <button class="ghost half" bindtap="closeKeywordModal">取消</button>
        <button class="primary half" loading="{{keywordSaving}}" disabled="{{keywordSaving}}" bindtap="confirmKeywords">确认添加</button>
      </view>
    </view>
  </view>

  <view wx:if="{{compOpen}}" class="overlay" catchtap="closeCompetitorModal">
    <view class="sheet comp-sheet" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">新增同行</text>
        <text class="sheet-close" catchtap="closeCompetitorModal">×</text>
      </view>
      <view class="comp-platform">
        <view class="comp-tab {{compPlatform === 'douyin' ? 'on' : ''}}" data-p="douyin" bindtap="setCompPlatform">平台1</view>
        <view class="comp-tab {{compPlatform === 'wechat_channels' ? 'on' : ''}}" data-p="wechat_channels" bindtap="setCompPlatform">平台2</view>
      </view>
      <text class="label">{{compPlatform === 'wechat_channels' ? '昵称、用户名、ID 或作品链接' : '昵称或账号ID'}}</text>
      <input class="input" value="{{compKeyword}}" bindinput="onCompKeyword" placeholder="{{compPlatform === 'wechat_channels' ? '输入昵称、用户名、ID 或作品链接' : '输入昵称或账号ID'}}" maxlength="200" />
      <text class="label">行业标签（可选）</text>
      <input class="input" value="{{compTags}}" bindinput="onCompTags" placeholder="例如：餐饮,本地生活" maxlength="60" />
      <view class="comp-actions">
        <button class="primary small" loading="{{compSearching}}" disabled="{{compSearching}}" bindtap="searchCompetitor">搜索账号</button>
        <button wx:if="{{compPlatform === 'wechat_channels'}}" class="ghost small" loading="{{compAdding}}" disabled="{{compAdding}}" bindtap="addCompetitorByChannel">解析并添加</button>
      </view>
      <view wx:if="{{compResults.length}}" class="comp-results">
        <text class="field-hint">搜到 {{compResults.length}} 个账号，点一个添加</text>
        <view wx:for="{{compResults}}" wx:key="key" class="comp-row" data-index="{{index}}" bindtap="addCompetitorCandidate">
          <image wx:if="{{item.avatar}}" class="comp-avatar" src="{{item.avatar}}" mode="aspectFill" />
          <view wx:else class="comp-avatar comp-avatar-empty">{{item.initial}}</view>
          <view class="comp-main">
            <text class="comp-name">{{item.name}}</text>
            <text class="comp-meta">{{item.meta}}</text>
          </view>
          <text class="comp-add">添加</text>
        </view>
      </view>
      <view wx:if="{{compSearched && !compResults.length}}" class="empty">没有搜到匹配账号</view>
    </view>
  </view>

  <view wx:if="{{doc}}" class="overlay" catchtap="closeDoc">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">{{doc.title}}</text>
        <text class="sheet-close" catchtap="closeDoc">×</text>
      </view>
      <text class="doc-content" user-select="{{true}}">{{doc.content}}</text>
    </view>
  </view>
</view>
