<view class="page">
  <view class="head">
    <text class="title">新建声音分身</text>
    <text class="sub">上传 10MB 以内的清晰人声，mp3 / wav / m4a</text>
  </view>

  <view class="panel">
    <text class="label">名称</text>
    <input class="input" value="{{title}}" bindinput="onTitle" placeholder="给这个声音起个名字" />

    <text class="label">语言</text>
    <picker mode="selector" range="{{languages}}" value="{{langIndex}}" bindchange="pickLang">
      <view class="picker">{{languages[langIndex]}}</view>
    </picker>

    <text class="label">声音文件</text>
    <view class="picker-box" bindtap="chooseFile">
      <text class="picker-text">{{fileName || '选择音频文件'}}</text>
      <text wx:if="{{fileName}}" class="clear" catchtap="clearFile">×</text>
    </view>

    <checkbox-group bindchange="toggleAgree"><label class="agree"><checkbox value="1" checked="{{agree}}" /><text>我确认已取得声音本人授权</text></label></checkbox-group>

    <button class="primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">开始克隆</button>
    <view wx:if="{{statusText}}" class="status">{{statusText}}</view>
  </view>
</view>