.page { min-height: 100vh; padding: 28rpx; background: #f8f9fa; }
.head { padding: 12rpx 4rpx 24rpx; }
.title { display: block; font-size: 42rpx; font-weight: 700; }
.sub { display: block; margin-top: 8rpx; font-size: 24rpx; color: #64748b; }
.panel { padding: 28rpx; margin-bottom: 24rpx; background: #fff; border-radius: 24rpx; box-shadow: 0 12rpx 32rpx rgba(15,23,42,0.06); }
.label { display: block; margin: 20rpx 0 12rpx; font-size: 24rpx; color: #64748b; }
.tpl-scroll { white-space: nowrap; }
.tpl-row { display: flex; gap: 16rpx; }
.tpl { width: 180rpx; padding: 8rpx; border: 2rpx solid transparent; border-radius: 16rpx; background: #f8fafc; }
.tpl.active { border-color: #1957E8; background: #eff6ff; }
.tpl-cover { width: 164rpx; height: 220rpx; border-radius: 12rpx; background: #e2e8f0; }
.tpl-cover-empty { display: flex; align-items: center; justify-content: center; color: #64748b; font-size: 28rpx; }
.tpl-name { display: block; margin-top: 8rpx; font-size: 22rpx; color: #334155; overflow: hidden; text-overflow: ellipsis; }
.tpl-empty { padding: 24rpx; font-size: 24rpx; color: #64748b; }
.picker { padding: 22rpx; font-size: 28rpx; background: #f8fafc; border-radius: 16rpx; }
.textarea { width: 100%; min-height: 160rpx; padding: 20rpx; font-size: 26rpx; background: #f8fafc; border-radius: 16rpx; }
.mat-row { display: flex; flex-wrap: wrap; gap: 16rpx; }
.mat { position: relative; width: 140rpx; height: 140rpx; }
.mat-thumb { width: 140rpx; height: 140rpx; border-radius: 12rpx; background: #e2e8f0; }
.mat-video { display: flex; align-items: center; justify-content: center; font-size: 22rpx; color: #64748b; }
.mat-play { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 44rpx; height: 44rpx; line-height: 44rpx; text-align: center; font-size: 20rpx; color: #fff; background: rgba(15,23,42,.55); border-radius: 50%; }
.mat-del { position: absolute; top: -10rpx; right: -10rpx; width: 36rpx; height: 36rpx; line-height: 34rpx; text-align: center; font-size: 26rpx; color: #0f172a; background: #ef4444; border-radius: 50%; }
.mat-add { width: 140rpx; height: 140rpx; line-height: 140rpx; text-align: center; font-size: 48rpx; color: #64748b; background: #f8fafc; border: 2rpx dashed #cbd5e1; border-radius: 12rpx; }
.primary { margin-top: 28rpx; height: 84rpx; line-height: 84rpx; color: #ffffff; font-size: 28rpx; background: linear-gradient(135deg, #1957E8, #00D6B9); border-radius: 16rpx; }
.primary[disabled] { opacity: 0.5; }
.ghost { margin-top: 16rpx; height: 76rpx; line-height: 76rpx; font-size: 26rpx; color: #1957E8; background: #eff6ff; border-radius: 16rpx; }
.status { font-size: 28rpx; color: #0f172a; }
.video { width: 100%; margin-top: 20rpx; border-radius: 16rpx; }
.progress { padding: 16rpx; font-size: 24rpx; color: #64748b; text-align: center; }

.am-mask { position:fixed; left:0; right:0; top:0; bottom:0; background:rgba(15,23,42,.45); display:flex; align-items:flex-end; z-index:99; }
.am-sheet { width:100%; background:#fff; border-radius:24rpx 24rpx 0 0; padding:24rpx; max-height:78vh; display:flex; flex-direction:column; }
.am-head { display:flex; justify-content:space-between; align-items:center; margin-bottom:12rpx; }
.am-title { font-size:30rpx; font-weight:600; color:#0f172a; }
.am-close { font-size:40rpx; color: #64748b; }
.am-body { max-height:56vh; }
.am-item { display:flex; align-items:center; padding:12rpx 0; border-bottom:1rpx solid #f1f5f9; }
.am-box { width:36rpx; height:36rpx; border:2rpx solid #cbd5e1; border-radius:8rpx; margin-right:14rpx; text-align:center; line-height:36rpx; color: #0f172a; font-size:22rpx; }
.am-box.on { background:#00D6B9; border-color:#00D6B9; }
.am-thumb { width:90rpx; height:70rpx; border-radius:10rpx; background:#f1f5f9; margin-right:14rpx; text-align:center; line-height:70rpx; font-size:20rpx; color:#64748b; }
.am-name { flex:1; font-size:24rpx; color:#0f172a; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.am-empty { padding:60rpx 0; text-align:center; color: #64748b; }

.head-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12rpx; }
.head-acts { display: flex; flex-direction: column; gap: 10rpx; align-items: flex-end; }
.act-btn { margin: 0; height: 56rpx; line-height: 56rpx; padding: 0 20rpx; font-size: 22rpx; border-radius: 999rpx; }
.act-btn.primary { color: #ffffff; background: linear-gradient(135deg, #1957E8, #00D6B9); }
.act-btn.ghost { color: #1957E8; background: #eff6ff; }

.hint { display: block; margin-top: 10rpx; font-size: 22rpx; color: #64748b; line-height: 1.5; }

.tpl-row2 { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; }
.tpl-label { margin: 0; }
.list-head { display: flex; align-items: center; justify-content: space-between; }
.list-add { font-size: 26rpx; color: #1957E8; font-weight: 600; }
.job-row { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #eef1f6; }
.job-main { flex: 1; min-width: 0; }
.job-title { display: block; font-size: 28rpx; color: #0f172a; }
.job-meta { display: block; margin-top: 6rpx; font-size: 21rpx; color: #94a3b8; }
.job-go { font-size: 24rpx; color: #1957E8; }

.create-back { display: inline-block; margin-bottom: 12rpx; font-size: 24rpx; color: #1957E8; }

.job-actions { display: flex; align-items: center; gap: 18rpx; margin-left: 12rpx; }
.job-dl { font-size: 24rpx; color: #0f766e; }

.job-error { display: block; margin-top: 6rpx; font-size: 20rpx; color: #dc2626; line-height: 1.4; }

.video-preview { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 9999; display: flex; flex-direction: column; background: #000; }
.video-preview-head { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 28rpx; color: #fff; background: #000; }
.video-preview-back { font-size: 28rpx; color: #fff; padding: 8rpx 12rpx; }
.video-preview-title { flex: 1; text-align: center; font-size: 28rpx; color: #fff; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.video-preview-download { font-size: 26rpx; color: #7dd3fc; }
.video-preview-body { flex: 1; width: 100%; background: #000; }

.head-actions { display: flex; gap: 10rpx; margin-top: 14rpx; flex-wrap: wrap; }
.list-count { font-size: 21rpx; color: #94a3b8; }

.rate-row { display: flex; align-items: center; gap: 16rpx; margin-top: 10rpx; }
.rate-label { font-size: 24rpx; color: #475569; white-space: nowrap; }
.rate-slider { flex: 1; }

.param-grid { display: flex; flex-direction: column; gap: 8rpx; margin-top: 10rpx; }
.param { display: flex; flex-direction: column; gap: 4rpx; }
.param-label { font-size: 24rpx; color: #475569; }
.picker.small { padding: 14rpx 18rpx; font-size: 24rpx; }
