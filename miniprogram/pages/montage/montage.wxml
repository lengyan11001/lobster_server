<view class="page">
  <view class="head">
    <view class="head-top">
      <view>
        <text class="title">素材混剪</text>
        <text class="sub">上传素材 + 文案，选模板和声音，自动混剪成片</text>
      </view>
      <view class="head-acts">
        <button wx:if="{{viewMode === 'list'}}" class="act-btn primary" bindtap="openCreate">＋ 新建</button>
        <button wx:else class="act-btn ghost" bindtap="backToList">返回列表</button>
      </view>
    </view>
    <view wx:if="{{viewMode === 'create'}}" class="head-actions">
      <button class="act-btn ghost" bindtap="openMemoryPrefill">IP记忆生成</button>
      <button class="act-btn ghost" bindtap="openPrefillHistory">历史</button>
      <button class="act-btn primary" bindtap="openRecordingPrefill">录音生成</button>
    </view>
  </view>

  <view wx:if="{{viewMode === 'list'}}" class="panel">
    <view class="list-head">
      <text class="label">混剪任务</text>
      <text class="list-count">{{jobList.length}} 条</text>
    </view>
    <view wx:if="{{!jobList.length}}" class="hint">还没有任务，点右上角「新建」</view>
    <view wx:for="{{jobList}}" wx:key="job_id" class="job-row" data-id="{{item.job_id}}" bindtap="openJob">
      <view class="job-main">
        <text class="job-title">{{item.title}}</text>
        <text class="job-meta">{{item.timeText}} · {{item.statusText}}{{item.duration ? ' · ' + item.duration + 's' : ''}}</text>
        <text wx:if="{{item.errorText}}" class="job-error">{{item.errorText}}</text>
      </view>
      <view class="job-actions">
        <text class="job-go">{{item.video_url ? '播放' : '状态'}}</text>
        <text wx:if="{{item.video_url}}" class="job-dl" catchtap="downloadJob" data-id="{{item.job_id}}">下载</text>
      </view>
    </view>
  </view>

  <view wx:if="{{viewMode === 'create'}}" class="panel">
    <text class="label">音色（素材库 · 我的声音）</text>
    <picker mode="selector" range="{{voiceNames}}" value="{{voiceIndex}}" bindchange="selectVoice">
      <view class="picker">{{voiceIndex >= 0 ? voiceNames[voiceIndex] : '还没有音色，先去素材库创建'}}</view>
    </picker>

    <text class="label">口播文案</text>
    <textarea class="textarea" value="{{speechText}}" bindinput="onSpeechInput" placeholder="输入口播文案，生成语音后按语音时长切分素材" maxlength="1200" auto-height />
    <view class="param-grid">
      <view class="param"><text class="param-label">语速 {{speechRate}}x</text>
        <slider min="50" max="200" step="5" value="{{speechRate * 100}}" block-size="20" activeColor="#2563eb" bindchange="onSpeechRate" bindchanging="onSpeechRate" /></view>
      <view class="param"><text class="param-label">音量 {{speechVolumeText}}</text>
        <slider min="10" max="200" step="5" value="{{speechVolume * 100}}" block-size="20" activeColor="#2563eb" bindchange="onSpeechVolume" bindchanging="onSpeechVolume" /></view>
      <view class="param"><text class="param-label">音调 {{speechPitchText}}</text>
        <slider min="{{speechPitchMin}}" max="{{speechPitchMax}}" step="{{speechPitchStep}}" value="{{speechPitch}}" block-size="20" activeColor="#2563eb" bindchange="onSpeechPitch" bindchanging="onSpeechPitch" /></view>
      <view class="param"><text class="param-label">情绪</text>
        <picker mode="selector" range="{{speechEmotions}}" value="{{speechEmotionIndex}}" bindchange="pickSpeechEmotion">
          <view class="picker small">{{speechEmotions[speechEmotionIndex]}}</view>
        </picker></view>
    </view>
    <view class="btn-row">
      <button class="ghost half" loading="{{ttsLoading}}" bindtap="previewSpeech">试听</button>
      <button class="primary half" loading="{{ttsLoading}}" bindtap="generateSpeech">生成音轨</button>
    </view>
    <text class="hint">{{speechStatus}}</text>

    <block wx:if="{{bgmEnabled}}">
    <text class="label">背景音乐（可选，与口播双音轨同时播放）</text>
    <view wx:if="{{!bgmItems.length}}" class="hint">背景音乐加载中…</view>
    <scroll-view wx:else scroll-x class="tpl-scroll">
      <view class="tpl-row">
        <view class="tpl {{bgmIndex === -1 ? 'active' : ''}}" data-index="-1" bindtap="selectBgm">
          <view class="tpl-cover tpl-cover-empty">无</view>
          <text class="tpl-name">无音乐</text>
        </view>
        <view wx:for="{{bgmItems}}" wx:key="key" class="tpl {{bgmIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="selectBgm">
          <view class="tpl-cover tpl-cover-empty">♪</view>
          <text class="tpl-name">{{item.name}}</text>
        </view>
      </view>
    </scroll-view>
    <view wx:if="{{bgmIndex >= 0}}" class="btn-row">
      <button class="ghost half" bindtap="previewBgm">试听</button>
      <button class="ghost half" bindtap="clearBgm">移除</button>
    </view>

    </block>

    <view class="tpl-row2">
      <text class="label tpl-label">套用闪剪模板</text>
      <switch checked="{{useTemplate}}" bindchange="toggleUseTemplate" color="#1957E8" />
    </view>
    <block wx:if="{{useTemplate}}">
      <text class="label">标题（模板主标题）</text>
      <textarea class="textarea" value="{{templateTitle}}" bindinput="onTemplateTitle" maxlength="80" placeholder="输入成片标题，可分多行" auto-height />
      <text class="label">介绍文案（可空）</text>
      <textarea class="textarea" value="{{templateContent}}" bindinput="onTemplateContent" maxlength="240" placeholder="填写模板身份栏要显示的介绍文案" auto-height />
      <view wx:if="{{templatesLoading}}" class="hint">模板加载中…</view>
      <view wx:elif="{{!templates.length}}" class="hint">没有可用模板</view>
      <scroll-view wx:else scroll-x class="tpl-scroll">
        <view class="tpl-row">
          <view wx:for="{{templates}}" wx:key="styleId" class="tpl {{templateIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="selectTemplate">
            <image wx:if="{{item.cover}}" class="tpl-cover" src="{{item.cover}}" mode="aspectFill" />
            <view wx:else class="tpl-cover tpl-cover-empty">模</view>
            <text class="tpl-name">{{item.name}}</text>
          </view>
        </view>
      </scroll-view>
    </block>

    <text class="label">素材分组（切片好的素材，随机取）</text>
    <view wx:if="{{groupsLoading}}" class="hint">分组加载中…</view>
    <picker wx:else mode="selector" range="{{groupNames}}" value="{{groupIndex}}" bindchange="selectGroup">
      <view class="picker">{{groupIndex >= 0 ? groupNames[groupIndex] : '不选分组（用下面手动素材）'}}</view>
    </picker>

    <text class="label">素材（{{materials.length}} 个视频）</text>
    <view class="mat-row">
      <view wx:for="{{materials}}" wx:key="fileUrl" class="mat">
        <image wx:if="{{item.cover}}" class="mat-thumb" src="{{item.cover}}" mode="aspectFill" />
        <view wx:else class="mat-thumb mat-video">{{item.type === 'video' ? '视频' : '图片'}}</view>
        <view wx:if="{{item.type === 'video'}}" class="mat-play">▶</view>
        <text class="mat-del" data-index="{{index}}" bindtap="removeMaterial">×</text>
      </view>
      <view class="mat-add" bindtap="addMaterial">+</view>
      <view class="mat-add" bindtap="openAssetPicker">库</view>
    </view>

    <button class="primary" loading="{{rendering}}" disabled="{{rendering}}" bindtap="startLocalMontage">{{rendering ? '渲染中…' : '开始混剪'}}</button>
    <video wx:if="{{localVideoUrl}}" class="video" src="{{localVideoUrl}}" controls />
    <button wx:if="{{localVideoUrl}}" class="ghost" bindtap="saveLocalVideo">保存到相册</button>
    <text wx:if="{{localStatus}}" class="hint">{{localStatus}}</text>
  </view>

</view>

<view wx:if="{{assetOpen}}" class="am-mask" catchtap="closeAssetPicker">
  <view class="am-sheet" catchtap="assetNoop">
    <view class="am-head"><text class="am-title">选择素材</text><text class="am-close" catchtap="closeAssetPicker">×</text></view>
    <view wx:if="{{assetLoading}}" class="am-empty">加载中…</view>
    <view wx:elif="{{!assetItems.length}}" class="am-empty">素材库为空</view>
    <scroll-view scroll-y class="am-body">
      <view wx:for="{{assetItems}}" wx:key="id" class="am-item" data-index="{{index}}" catchtap="toggleAsset">
        <view class="am-box {{item.checked ? 'on' : ''}}">{{item.checked ? '✓' : ''}}</view>
        <image wx:if="{{item.cover}}" class="am-thumb" src="{{item.cover}}" mode="aspectFill" />
        <view wx:else class="am-thumb video">{{item.type === 'video' ? '视频' : '图片'}}</view>
        <text class="am-name">{{item.name}}</text>
      </view>
    </scroll-view>
    <button class="primary" catchtap="confirmAssets">加入素材</button>
  </view>
</view>

  <view wx:if="{{previewOpen}}" class="video-preview">
    <view class="video-preview-head">
      <view class="video-preview-back" bindtap="closePreview">‹ 返回</view>
      <text class="video-preview-title">{{previewTitle}}</text>
      <text class="video-preview-download" bindtap="downloadPreview">下载</text>
    </view>
    <video class="video-preview-body" src="{{previewUrl}}" controls autoplay object-fit="contain"></video>
  </view>

<topic-prefill id="topicPrefill" target="montage" bind:pick="onPrefillPick" />
