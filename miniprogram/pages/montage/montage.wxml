<view class="page">
  <view class="head">
    <text class="title">素材混剪</text>
    <text class="sub">上传素材 + 文案，选模板和声音，自动混剪成片</text>
  </view>

  <view class="panel">
    <text class="label">模板</text>
    <scroll-view scroll-x class="tpl-scroll">
      <view class="tpl-row">
        <view wx:if="{{templatesLoading}}" class="tpl-empty">模板加载中…</view>
        <view wx:if="{{!templatesLoading && !templates.length}}" class="tpl-empty">没有可用模板</view>
        <view wx:for="{{templates}}" wx:key="styleId" class="tpl {{templateIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="selectTemplate">
          <image wx:if="{{item.cover}}" class="tpl-cover" src="{{item.cover}}" mode="aspectFill" />
          <view wx:else class="tpl-cover tpl-cover-empty">模</view>
          <text class="tpl-name">{{item.name}}</text>
        </view>
      </view>
    </scroll-view>

    <text class="label">声音</text>
    <picker mode="selector" range="{{voiceNames}}" value="{{voiceIndex}}" bindchange="selectVoice">
      <view class="picker">{{voiceIndex >= 0 ? voiceNames[voiceIndex] : '请选择声音'}}</view>
    </picker>

    <text class="label">口播文案</text>
    <textarea class="textarea" value="{{content}}" bindinput="onContentInput" placeholder="输入这条视频要念的文案" auto-height maxlength="1200" />

    <text class="label">成片时长：{{duration}} 秒</text>
    <slider min="10" max="180" step="5" value="{{duration}}" show-value activeColor="#2563eb" bindchange="onDurationChange" />

    <text class="label">素材（{{materials.length}} 个）</text>
    <view class="mat-row">
      <view wx:for="{{materials}}" wx:key="fileUrl" class="mat">
        <image wx:if="{{item.type === 'image'}}" class="mat-thumb" src="{{item.fileUrl}}" mode="aspectFill" />
        <view wx:else class="mat-thumb mat-video">视频</view>
        <text class="mat-del" data-index="{{index}}" bindtap="removeMaterial">×</text>
      </view>
      <view class="mat-add" bindtap="addMaterial">+</view>
    </view>

    <button class="primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">开始混剪</button>
  </view>

  <view wx:if="{{taskId}}" class="panel">
    <text class="label">任务状态</text>
    <view class="status">{{statusText}}</view>
    <video wx:if="{{videoUrl}}" class="video" src="{{videoUrl}}" controls />
    <button wx:if="{{videoUrl}}" class="ghost" bindtap="copyUrl">复制视频链接</button>
  </view>

  <view wx:if="{{progressText}}" class="progress">{{progressText}}</view>
</view>
<view wx:if="{{assetOpen}}" class="am-mask" catchtap="closeAssetPicker">
  <view class="am-sheet" catchtap="assetNoop">
    <view class="am-head"><text class="am-title">选择素材</text><text class="am-close" catchtap="closeAssetPicker">×</text></view>
    <view wx:if="{{assetLoading}}" class="am-empty">加载中…</view>
    <view wx:elif="{{!assetItems.length}}" class="am-empty">素材库为空</view>
    <scroll-view scroll-y class="am-body">
      <view wx:for="{{assetItems}}" wx:key="id" class="am-item" data-index="{{index}}" catchtap="toggleAsset">
        <view class="am-box {{item.checked ? 'on' : ''}}">{{item.checked ? '✓' : ''}}</view>
        <image wx:if="{{item.type === 'image'}}" class="am-thumb" src="{{item.cover}}" mode="aspectFill" />
        <view wx:else class="am-thumb video">视频</view>
        <text class="am-name">{{item.name}}</text>
      </view>
    </scroll-view>
    <button class="primary" catchtap="confirmAssets">加入素材</button>
  </view>
</view>
