page { background: #f8f9fa; }

.home {
  min-height: 100vh;
  background: #f8f9fa;
  padding-bottom: 240rpx;
}

.top-visual {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: #f8f9fa;
}

.top-visual::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 80rpx;
  background: linear-gradient(180deg, rgba(248, 249, 250, 0) 0%, #f8f9fa 92%);
  pointer-events: none;
}

.top-visual-img {
  display: block;
  width: 100%;
}

.secretary-hit {
  position: absolute;
  right: 4%;
  top: 44%;
  width: 26%;
  height: 40%;
}

.body {
  padding: 0 40rpx;
  margin-top: 8rpx;
  position: relative;
  z-index: 2;
}

.row {
  display: flex;
  margin-bottom: 32rpx;
}

.col-left { flex: 1; margin-right: 32rpx; }
.col-right { flex: 1; display: flex; flex-direction: column; }
.col-right .card + .card { margin-top: 32rpx; }

.row > .card + .card { margin-left: 32rpx; }

.card {
  position: relative;
  overflow: hidden;
  background: #ffffff;
  border: 4rpx solid #ffffff;
  box-shadow: 0 16rpx 56rpx rgba(15, 23, 42, 0.06);
  box-sizing: border-box;
}

.card.tall {
  height: 452rpx;
  border-radius: 56rpx;
}

.card.small {
  flex: 1;
  height: 210rpx;
  border-radius: 56rpx;
}

.card.wide {
  height: 164rpx;
  border-radius: 48rpx;
}

.card-img {
  display: block;
  width: 100%;
  height: 100%;
}

.card-press {
  transform: scale(0.97);
  transition: transform 0.12s ease;
}

.wides {
  display: flex;
  flex-direction: column;
  margin: 32rpx 0 24rpx;
}

.wides .card + .card { margin-top: 24rpx; }
