page { background: #f8f9fa; }

.home {
  min-height: 100vh;
  background: #f8f9fa;
  padding-bottom: 240rpx;
}

.top-visual {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: #f8f9fa;
}

.top-visual::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 56rpx;
  background: linear-gradient(180deg, rgba(248, 249, 250, 0) 0%, #f8f9fa 92%);
  pointer-events: none;
}

.top-visual-img {
  display: block;
  width: 100%;
}

.hero-slogan {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 42rpx;
  z-index: 2;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #475569;
}

.secretary-hit {
  position: absolute;
  right: 4%;
  top: 44%;
  width: 26%;
  height: 40%;
}

.body {
  padding: 0 40rpx;
  margin-top: 8rpx;
  position: relative;
  z-index: 2;
}

.row {
  display: flex;
  margin-bottom: 32rpx;
}

.col-left { flex: 1; margin-right: 32rpx; }
.col-right { flex: 1; display: flex; flex-direction: column; }
.col-right .card + .card { margin-top: 32rpx; }

.row > .card + .card { margin-left: 32rpx; }

.card {
  position: relative;
  overflow: hidden;
  background: #ffffff;
  border: 4rpx solid #ffffff;
  box-shadow: 0 16rpx 56rpx rgba(15, 23, 42, 0.06);
  box-sizing: border-box;
}

.card.tall {
  height: 452rpx;
  border-radius: 56rpx;
}

.card.small {
  flex: 1;
  height: 210rpx;
  border-radius: 56rpx;
}

.card.wide {
  height: 164rpx;
  border-radius: 48rpx;
}

.card-img {
  display: block;
  width: 100%;
  height: 100%;
}

.card-press {
  transform: scale(0.97);
  transition: transform 0.12s ease;
}

.wides {
  display: flex;
  flex-direction: column;
  margin: 32rpx 0 24rpx;
}

.wides .card + .card { margin-top: 24rpx; }

.ip-entry { position: absolute; right: 8%; top: 18%; z-index: 3; display: flex; flex-direction: column; align-items: center; }
.ip-entry-ico { width: 80rpx; height: 80rpx; border-radius: 26rpx; box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.20); }
.ip-entry-label { margin-top: 6rpx; padding: 2rpx 14rpx; border-radius: 999rpx; background: rgba(255, 255, 255, 0.88); color: #334155; font-size: 20rpx; font-weight: 600; }
.ip-entry-press { opacity: 0.85; }


.extract-entry {
  display: flex;
  align-items: center;
  margin: 8rpx 0 24rpx;
  padding: 26rpx 28rpx;
  border-radius: 40rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 56rpx rgba(15, 23, 42, 0.06);
}
.extract-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1957E8, #00B3A0);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}
.extract-main {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}
.extract-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
}
.extract-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #64748b;
}
.extract-arrow {
  font-size: 40rpx;
  color: #94a3b8;
}
.extract-press {
  transform: scale(0.98);
  transition: transform 0.12s ease;
}
