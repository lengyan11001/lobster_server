.home-shell { min-height: 100vh; background: #05070f; padding: 20rpx 24rpx 0; box-sizing: border-box; }
.home-top { display: flex; align-items: center; justify-content: space-between; padding: 14rpx 4rpx 18rpx; }
.hello-pill { display: flex; align-items: center; gap: 10rpx; color: #f2f6ff; font-size: 24rpx; }
.status-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #64748b; }
.status-dot.online { background: #22c55e; }
.profile-bubble { margin: 0; padding: 0 24rpx; height: 56rpx; line-height: 56rpx; font-size: 22rpx; color: #67e8f9; background: rgba(34,211,238,.15); border-radius: 999rpx; }

.brand-stage { position: relative; height: 320rpx; border-radius: 24rpx; overflow: hidden; }
.hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; }
.hero-lobster { position: absolute; left: 0; right: 0; bottom: -10rpx; margin: auto; width: 300rpx; height: 220rpx; opacity: .9; }
.hero-vignette { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,10,15,.15), rgba(10,10,15,.75)); }
.brand-line { position: absolute; left: 28rpx; bottom: 24rpx; color: #fff; font-size: 30rpx; font-weight: 600; letter-spacing: 2rpx; }

.quick-row { display: flex; gap: 14rpx; margin-top: 18rpx; }
.quick-item { flex: 1; background: rgba(255,255,255,.045); border: 1rpx solid rgba(255,255,255,.10); border-radius: 18rpx; padding: 18rpx 16rpx; }
.quick-title { display: block; color: #f2f6ff; font-size: 24rpx; font-weight: 600; }
.quick-sub { display: block; margin-top: 6rpx; color: #8b98ae; font-size: 19rpx; }

.grid { display: flex; gap: 16rpx; margin-top: 18rpx; }
.big-card { position: relative; flex: 1.15; min-height: 330rpx; border-radius: 22rpx; padding: 26rpx; box-sizing: border-box; overflow: hidden; background: rgba(255,255,255,.045); border: 1rpx solid rgba(255,255,255,.10); display: flex; flex-direction: column; justify-content: flex-end; }
.big-tint { position: absolute; inset: 0; background: radial-gradient(circle at 85% 10%, rgba(34,211,238,.28), transparent 55%), radial-gradient(circle at 20% 120%, rgba(99,102,241,.22), transparent 60%); }
.big-play { position: absolute; right: 30rpx; top: 30rpx; width: 96rpx; height: 96rpx; border-radius: 50%; background: rgba(255,255,255,.22); color: #fff; font-size: 34rpx; display: flex; align-items: center; justify-content: center; }
.big-title { position: relative; color: #fff; font-size: 40rpx; font-weight: 700; letter-spacing: 1rpx; }
.big-sub { position: relative; margin-top: 8rpx; color: rgba(255,255,255,.85); font-size: 20rpx; }

.col { flex: 1; display: flex; flex-direction: column; gap: 16rpx; }
.small-card { flex: 1; border-radius: 22rpx; padding: 24rpx; background: rgba(255,255,255,.045); border: 1rpx solid rgba(255,255,255,.10);; display: flex; align-items: flex-end; }
.small-card:last-child { background: rgba(255,255,255,.045); border: 1rpx solid rgba(255,255,255,.10);; }
.small-title { color: #f2f6ff; font-size: 30rpx; font-weight: 700; }

.wide-card { flex: 1; border-radius: 22rpx; padding: 24rpx; min-height: 150rpx; background: rgba(255,255,255,.045); border: 1rpx solid rgba(255,255,255,.10);; display: flex; flex-direction: column; justify-content: center; }
.wide-card.alt { background: rgba(255,255,255,.045); border: 1rpx solid rgba(255,255,255,.10);; }
.wide-title { color: #fff; font-size: 28rpx; font-weight: 700; }
.wide-sub { margin-top: 8rpx; color: rgba(255,255,255,.82); font-size: 19rpx; }

.tools { margin-top: 24rpx; background: #121219; border-radius: 22rpx; border: 1rpx solid rgba(255,255,255,.10); overflow: hidden; }
.tool-row { display: flex; align-items: center; gap: 18rpx; padding: 24rpx; border-bottom: 1rpx solid #1e1e28; }
.tool-row:last-child { border-bottom: none; }
.tool-badge { width: 64rpx; height: 64rpx; border-radius: 18rpx; background: rgba(34,211,238,.18); color: #67e8f9; font-size: 26rpx; display: flex; align-items: center; justify-content: center; }
.tool-copy { flex: 1; }
.tool-name { display: block; color: #f2f6ff; font-size: 27rpx; font-weight: 600; }
.tool-desc { display: block; margin-top: 6rpx; color: #8b98ae; font-size: 20rpx; }
.tool-arrow { color: #5b677a; font-size: 34rpx; }

.bottom-space { height: 40rpx; }
@import "../../styles/dark.wxss";
