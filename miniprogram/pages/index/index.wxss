page { background: #05070f; }
.home-shell { min-height: 100vh; background: #05070f; padding: 20rpx 24rpx 0; box-sizing: border-box; }
.home-top { display: flex; align-items: center; justify-content: space-between; padding: 14rpx 4rpx 18rpx; }
.hello-pill { display: flex; align-items: center; color: #f2f6ff; font-size: 24rpx; }
.status-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #64748b; margin-right: 10rpx; }
.status-dot.online { background: #22d3ee; }
.profile-bubble { margin: 0; padding: 0 24rpx; height: 56rpx; line-height: 56rpx; font-size: 22rpx; color: #67e8f9; background: rgba(34,211,238,.15); border-radius: 999rpx; }

.brand-stage { position: relative; height: 320rpx; border-radius: 24rpx; overflow: hidden; background: #0b1020; }
.hero-bg { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.hero-lobster { position: absolute; left: 50%; bottom: 10rpx; width: 280rpx; height: 200rpx; margin-left: -140rpx; opacity: .9; }
.hero-vignette { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background: rgba(5,7,15,.35); }
.brand-line { position: absolute; left: 28rpx; bottom: 24rpx; color: #f2f6ff; font-size: 30rpx; font-weight: 600; }

.quick-row { display: flex; margin-top: 18rpx; }
.quick-item { flex: 1; margin-right: 14rpx; background: rgba(255,255,255,.045); border: 1rpx solid rgba(255,255,255,.10); border-radius: 18rpx; padding: 18rpx 16rpx; }
.quick-item:last-child { margin-right: 0; }
.quick-title { display: block; color: #f2f6ff; font-size: 24rpx; font-weight: 600; }
.quick-sub { display: block; margin-top: 6rpx; color: #8b98ae; font-size: 19rpx; }

.grid { display: flex; margin-top: 18rpx; }
.big-card { position: relative; flex: 1.2; min-height: 300rpx; margin-right: 16rpx; border-radius: 22rpx; padding: 24rpx; box-sizing: border-box; background: rgba(255,255,255,.045); border: 1rpx solid rgba(255,255,255,.10); display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden; }
.big-tint { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background: rgba(34,211,238,.10); }
.big-play { position: absolute; right: 24rpx; top: 24rpx; width: 84rpx; height: 84rpx; border-radius: 50%; background: rgba(255,255,255,.18); color: #ffffff; font-size: 30rpx; text-align: center; line-height: 84rpx; }
.big-title { position: relative; color: #f2f6ff; font-size: 36rpx; font-weight: 700; }
.big-sub { position: relative; margin-top: 8rpx; color: #b6c1d2; font-size: 20rpx; }

.col { flex: 1; display: flex; flex-direction: column; }
.small-card { flex: 1; border-radius: 22rpx; padding: 22rpx; background: rgba(255,255,255,.045); border: 1rpx solid rgba(255,255,255,.10); display: flex; align-items: flex-end; margin-bottom: 16rpx; }
.small-card.alt { background: rgba(34,211,238,.10); border-color: rgba(34,211,238,.28); margin-bottom: 0; }
.small-title { color: #f2f6ff; font-size: 26rpx; font-weight: 700; }

.ref-row { display: flex; margin-top: 16rpx; }
.wide-card { flex: 1; min-height: 130rpx; margin-right: 16rpx; border-radius: 22rpx; padding: 22rpx; background: rgba(255,255,255,.045); border: 1rpx solid rgba(255,255,255,.10); display: flex; flex-direction: column; justify-content: center; }
.wide-card.alt { margin-right: 0; background: rgba(99,102,241,.12); border-color: rgba(99,102,241,.28); }
.wide-title { color: #f2f6ff; font-size: 26rpx; font-weight: 700; }
.wide-sub { margin-top: 6rpx; color: #b6c1d2; font-size: 19rpx; }

.tools { margin-top: 22rpx; background: rgba(255,255,255,.045); border-radius: 22rpx; border: 1rpx solid rgba(255,255,255,.10); overflow: hidden; }
.tool-row { display: flex; align-items: center; padding: 22rpx; border-bottom: 1rpx solid rgba(255,255,255,.08); }
.tool-row:last-child { border-bottom: none; }
.tool-badge { width: 64rpx; height: 64rpx; margin-right: 18rpx; border-radius: 18rpx; background: rgba(34,211,238,.18); color: #67e8f9; font-size: 26rpx; text-align: center; line-height: 64rpx; }
.tool-copy { flex: 1; }
.tool-name { display: block; color: #f2f6ff; font-size: 27rpx; font-weight: 600; }
.tool-desc { display: block; margin-top: 6rpx; color: #8b98ae; font-size: 20rpx; }
.tool-arrow { color: #5b677a; font-size: 34rpx; }

.bottom-space { height: 40rpx; }
