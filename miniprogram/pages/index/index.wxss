page { background: #f6f8fc; color: #0f172a; }
.home-shell { min-height: 100vh; background: #f6f8fc; padding: 20rpx 24rpx 0; box-sizing: border-box; }
.home-top { display: flex; align-items: center; justify-content: space-between; padding: 14rpx 4rpx 18rpx; }
.hello-pill { display: flex; align-items: center; color: #0f172a; font-size: 24rpx; }
.status-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #cbd5e1; margin-right: 10rpx; }
.status-dot.online { background: #06b6d4; }
.profile-bubble { margin: 0; padding: 0 24rpx; height: 56rpx; line-height: 56rpx; font-size: 22rpx; color: #0369a1; background: #e0f2fe; border-radius: 999rpx; }

.brand-stage { position: relative; height: 320rpx; border-radius: 24rpx; overflow: hidden; background: #e2e8f0; }
.hero-bg { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.hero-lobster { position: absolute; left: 50%; bottom: 10rpx; width: 280rpx; height: 200rpx; margin-left: -140rpx; opacity: .95; }
.hero-vignette { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background: rgba(15,23,42,.18); }
.brand-line { position: absolute; left: 28rpx; bottom: 24rpx; color: #ffffff; font-size: 30rpx; font-weight: 600; }

.quick-row { display: flex; margin-top: 18rpx; }
.quick-item { flex: 1; margin-right: 14rpx; background: #ffffff; border: 1rpx solid #eef2f7; border-radius: 18rpx; padding: 18rpx 16rpx; box-shadow: 0 2rpx 10rpx rgba(15,23,42,.03); }
.quick-item:last-child { margin-right: 0; }
.quick-title { display: block; color: #0f172a; font-size: 24rpx; font-weight: 600; }
.quick-sub { display: block; margin-top: 6rpx; color: #94a3b8; font-size: 19rpx; }

.grid { display: flex; margin-top: 18rpx; }
.big-card { position: relative; flex: 1.2; min-height: 300rpx; margin-right: 16rpx; border-radius: 22rpx; padding: 24rpx; box-sizing: border-box; background: linear-gradient(145deg, #06b6d4, #2563eb); display: flex; flex-direction: column; justify-content: flex-end; overflow: hidden; }
.big-play { position: absolute; right: 24rpx; top: 24rpx; width: 84rpx; height: 84rpx; border-radius: 50%; background: rgba(255,255,255,.22); color: #ffffff; font-size: 30rpx; text-align: center; line-height: 84rpx; }
.big-title { color: #ffffff; font-size: 36rpx; font-weight: 700; }
.big-sub { margin-top: 8rpx; color: rgba(255,255,255,.85); font-size: 20rpx; }

.col { flex: 1; display: flex; flex-direction: column; }
.small-card { flex: 1; border-radius: 22rpx; padding: 22rpx; background: #ffffff; border: 1rpx solid #eef2f7; display: flex; align-items: flex-end; margin-bottom: 16rpx; box-shadow: 0 2rpx 10rpx rgba(15,23,42,.03); }
.small-card.alt { background: #eff6ff; border-color: #dbeafe; margin-bottom: 0; }
.small-title { color: #0f172a; font-size: 26rpx; font-weight: 700; }

.wide-row { display: flex; margin-top: 16rpx; }
.wide-card { flex: 1; min-height: 130rpx; margin-right: 16rpx; border-radius: 22rpx; padding: 22rpx; background: #ffffff; border: 1rpx solid #eef2f7; display: flex; flex-direction: column; justify-content: center; box-shadow: 0 2rpx 10rpx rgba(15,23,42,.03); }
.wide-card.alt { margin-right: 0; background: #eef2ff; border-color: #e0e7ff; }
.wide-title { color: #0f172a; font-size: 26rpx; font-weight: 700; }
.wide-sub { margin-top: 6rpx; color: #64748b; font-size: 19rpx; }

.tools { margin-top: 22rpx; background: #ffffff; border-radius: 22rpx; border: 1rpx solid #eef2f7; overflow: hidden; box-shadow: 0 2rpx 10rpx rgba(15,23,42,.03); }
.tool-row { display: flex; align-items: center; padding: 22rpx; border-bottom: 1rpx solid #eef2f7; }
.tool-row:last-child { border-bottom: none; }
.tool-badge { width: 64rpx; height: 64rpx; margin-right: 18rpx; border-radius: 18rpx; background: #ecfeff; color: #0891b2; font-size: 26rpx; text-align: center; line-height: 64rpx; }
.tool-copy { flex: 1; }
.tool-name { display: block; color: #0f172a; font-size: 27rpx; font-weight: 600; }
.tool-desc { display: block; margin-top: 6rpx; color: #94a3b8; font-size: 20rpx; }
.tool-arrow { color: #cbd5e1; font-size: 34rpx; }

.bottom-space { height: 40rpx; }
