<view class="home">
  <view class="top-visual">
    <image class="top-visual-img" src="/assets/home2/hero.jpg" mode="widthFix" />
    <text class="hero-slogan">必火智能 · 让企业AI落地更简单</text>
    <view class="ip-entry" bindtap="goIpProfile" hover-class="ip-entry-press">
      <view class="ip-entry-ico">IP</view>
      <text class="ip-entry-label">IP人设</text>
    </view>
    <view class="secretary-hit" bindtap="goSecretary" hover-class="none"></view>
  </view>

  <view class="body">
    <view class="row">
      <view class="col-left">
        <view class="card tall" bindtap="goDrama" hover-class="card-press">
          <image class="card-img" src="/assets/home2/drama.jpg" mode="aspectFill" />
        </view>
      </view>
      <view class="col-right">
        <view class="card small" bindtap="goDigital" hover-class="card-press">
          <image class="card-img" src="/assets/home2/digital.jpg" mode="aspectFill" />
        </view>
        <view class="card small" bindtap="goMix" hover-class="card-press">
          <image class="card-img" src="/assets/home2/mix.jpg" mode="aspectFill" />
        </view>
      </view>
    </view>

    <view class="row">
      <view class="card small" bindtap="goPoster" hover-class="card-press">
        <image class="card-img" src="/assets/home2/poster.jpg" mode="aspectFill" />
      </view>
      <view class="card small" bindtap="goTrending" hover-class="card-press">
        <image class="card-img" src="/assets/home2/trending.jpg" mode="aspectFill" />
      </view>
    </view>

    <view class="wides">
      <view class="card wide" bindtap="goMoments" hover-class="card-press">
        <image class="card-img" src="/assets/home2/moments.jpg" mode="aspectFill" />
      </view>
      <view class="card wide" bindtap="goArticle" hover-class="card-press">
        <image class="card-img" src="/assets/home2/article.jpg" mode="aspectFill" />
      </view>
    </view>
  </view>
</view>
