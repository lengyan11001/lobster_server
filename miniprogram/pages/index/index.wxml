<view class="home-shell">
  <view class="home-top">
    <view class="hello-pill">
      <view class="status-dot {{phoneBound ? 'online' : ''}}"></view>
      <text wx:if="{{phoneBound}}">你好，{{phone}}</text>
      <text wx:else>{{appName}}</text>
    </view>
    <button class="profile-bubble" bindtap="goProfile">{{phoneBound ? '我的' : '授权'}}</button>
  </view>

  <view class="brand-stage">
    <image class="hero-bg" src="{{heroBgUrl}}" mode="aspectFill" />
    <image class="hero-lobster" src="{{lobsterUrl}}" mode="aspectFit" />
    <view class="hero-vignette"></view>
    <text class="brand-line">把不凡的创意变成现实</text>
  </view>

  <view class="quick-row">
    <view class="quick-item" bindtap="goAssets">
      <text class="quick-title">素材库</text>
      <text class="quick-sub">素材 · 形象 · 声音</text>
    </view>
    <view class="quick-item" bindtap="goIpProfile">
      <text class="quick-title">个人IP</text>
      <text class="quick-sub">资料 · 记忆</text>
    </view>
    <view class="quick-item" bindtap="goAirec">
      <text class="quick-title">AI秘书</text>
      <text class="quick-sub">录音笔 · 设备</text>
    </view>
  </view>

  <view class="grid">
    <view class="big-card" bindtap="goVideoHub">
      <view class="big-play">▶</view>
      <text class="big-title">超级AI混剪</text>
      <text class="big-sub">一键爆款成片 · 全网矩阵获客</text>
    </view>
    <view class="col">
      <view class="small-card" bindtap="goMontageHistory">
        <text class="small-title">素材智能剪辑</text>
      </view>
      <view class="small-card alt" bindtap="goImageGenerate">
        <text class="small-title">一键做海报</text>
      </view>
    </view>
  </view>

  <view class="wide-row">
    <view class="wide-card" bindtap="goVideoInspiration">
      <text class="wide-title">一键抄爆款模板</text>
      <text class="wide-sub">没有灵感 · 一键爆款复刻</text>
    </view>
    <view class="wide-card alt" bindtap="goRecords">
      <text class="wide-title">我的成片库</text>
      <text class="wide-sub">全部生成结果</text>
    </view>
  </view>

  <view class="tools">
    <view class="tool-row" bindtap="goMoments">
      <view class="tool-badge">文</view>
      <view class="tool-copy"><text class="tool-name">朋友圈图文</text><text class="tool-desc">文案 + 配图，一键成组</text></view>
      <text class="tool-arrow">›</text>
    </view>
    <view class="tool-row" bindtap="goArticle">
      <view class="tool-badge">章</view>
      <view class="tool-copy"><text class="tool-name">公众号文案</text><text class="tool-desc">长文写作，直接发布</text></view>
      <text class="tool-arrow">›</text>
    </view>
  </view>

  <view class="bottom-space"></view>
</view>
