.image-page {
  position: relative;
  min-height: 100vh;
  overflow-x: hidden;
  padding: 30rpx 24rpx 0;
  box-sizing: border-box;
  color: #0f172a;
  background: #f8f9fa;
}

.bg-grid {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 0.28;
  background-image:
    radial-gradient(circle, rgba(0,255,236,0.26) 0 2rpx, transparent 3rpx),
    linear-gradient(120deg, rgba(22,163,255,0.08), transparent 44%, rgba(255,83,182,0.08));
  background-size: 54rpx 54rpx, 100% 100%;
}

.topbar,
.section-title,
.reference-scroll,
.prompt-box,
.section-head,
.example-scroll,
.seg-row,
.generate-btn,
.result-section,
.auth-card {
  position: relative;
  z-index: 1;
}

.topbar {
  display: grid;
  grid-template-columns: 76rpx 1fr auto;
  align-items: center;
  height: 78rpx;
}

.back-btn {
  width: 66rpx;
  height: 66rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  color: #0f172a;
  background: #ffffff;
  border: 1rpx solid #eef1f6;
  font-size: 58rpx;
  line-height: 58rpx;
}

.page-title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 900;
}

.auth-card {
  margin-top: 22rpx;
  padding: 26rpx;
  border: 1rpx solid #eef1f6;
  border-radius: 28rpx;
  background: #ffffff;
}

.auth-title,
.auth-text {
  display: block;
}

.auth-title {
  font-size: 30rpx;
  font-weight: 900;
}

.auth-text {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 24rpx;
}

.auth-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 22rpx;
}

.ghost-btn,
.primary-small {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 74rpx;
  margin: 0;
  padding: 0;
  border-radius: 20rpx;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 74rpx;
}

.ghost-btn {
  color: #1957E8;
  background: #ffffff;
  border: 1rpx solid #eef1f6;
}

.primary-small {
  color: #ffffff;
  background: linear-gradient(135deg, #1957E8, #00D6B9);
}

.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 34rpx;
  color: #0f172a;
  font-size: 29rpx;
  font-weight: 900;
}

.section-title.compact {
  margin-top: 0;
}

.title-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 30rpx;
  height: 30rpx;
  color: #1957E8;
  font-size: 20rpx;
  font-weight: 1000;
}

.reference-scroll {
  margin-top: 18rpx;
  white-space: nowrap;
}

.reference-row,
.example-row {
  display: flex;
  gap: 18rpx;
}

.upload-card,
.reference-card {
  position: relative;
  flex: 0 0 auto;
  width: 158rpx;
  height: 158rpx;
  overflow: hidden;
  border-radius: 26rpx;
}

.upload-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #64748b;
  background: #ffffff;
  border: 2rpx dashed rgba(25,87,232,0.35);
}

.asset-card {
  border-style: solid;
  background: #f8f9fa;
}

.upload-plus {
  color: #1957E8;
  font-size: 58rpx;
  line-height: 52rpx;
}

.upload-card text:last-child {
  font-size: 24rpx;
}

.reference-card image {
  width: 100%;
  height: 100%;
}

.remove-ref {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 42rpx;
  height: 42rpx;
  padding: 0;
  border-radius: 999rpx;
  color: #0f172a;
  background: rgba(15,23,42,0.08);
  font-size: 30rpx;
  line-height: 38rpx;
}

.prompt-box {
  margin-top: 18rpx;
  padding: 24rpx;
  border: 1rpx solid #eef1f6;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 22rpx 70rpx rgba(15,23,42,0.08);
}

.prompt-head,
.prompt-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.prompt-head text {
  color: #64748b;
  font-size: 25rpx;
  font-weight: 800;
}

.prompt-head button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 150rpx;
  height: 56rpx;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 999rpx;
  color: #fff;
  background: linear-gradient(135deg, #1957E8, #00D6B9);
  font-size: 23rpx;
  font-weight: 900;
  line-height: 56rpx;
}

.prompt-input {
  width: 100%;
  height: 330rpx;
  margin-top: 22rpx;
  color: #0f172a;
  font-size: 29rpx;
  line-height: 1.48;
}

.prompt-input::placeholder {
  color: #64748b;
}

.prompt-foot {
  color: #64748b;
  font-size: 22rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 34rpx;
}

.more-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  color: #64748b;
  background: transparent;
  font-size: 24rpx;
  line-height: 48rpx;
}

.example-scroll {
  margin-top: 16rpx;
  white-space: nowrap;
}

.example-card {
  flex: 0 0 auto;
  width: 150rpx;
}

.example-card image {
  width: 150rpx;
  height: 170rpx;
  border-radius: 18rpx;
  background: #ffffff;
}

.example-card text {
  display: block;
  margin-top: 10rpx;
  overflow: hidden;
  color: #0f172a;
  font-size: 24rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.seg-row {
  display: flex;
  gap: 20rpx;
  margin-top: 18rpx;
}

.seg-row button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  margin: 0;
  padding: 0 28rpx;
  border: 1rpx solid #eef1f6;
  border-radius: 24rpx;
  color: #64748b;
  background: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 76rpx;
  text-align: center;
}

.resolution-row button {
  flex: 1;
}

.ratio-row,
.count-row {
  flex-wrap: wrap;
}

.ratio-row button,
.count-row button {
  min-width: 96rpx;
}

.seg-row button.active {
  border-color: transparent;
  color: #ffffff;
  background: linear-gradient(135deg, #1957E8, #00D6B9);
  box-shadow: 0 10rpx 24rpx rgba(25, 87, 232, 0.22);
}

.seg-row button.pink {
  border-color: transparent;
  color: #ffffff;
  background: linear-gradient(135deg, #ff6bb5, #b48cff);
  box-shadow: 0 10rpx 24rpx rgba(180, 140, 255, 0.22);
}

.generate-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 108rpx;
  margin-top: 36rpx;
  padding: 0;
  border-radius: 24rpx;
  color: #fff;
  background: linear-gradient(135deg, #1957E8, #00D6B9);
  font-size: 31rpx;
  font-weight: 1000;
  line-height: 1.2;
}

.generate-btn text {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 21rpx;
  font-weight: 700;
}

.result-section {
  margin-top: 38rpx;
}

.result-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 18rpx;
}

.result-card {
  overflow: hidden;
  border: 1rpx solid #eef1f6;
  border-radius: 24rpx;
  background: #ffffff;
}

.result-card image {
  width: 100%;
  height: 330rpx;
  background: #ffffff;
}

.result-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
  padding: 12rpx;
}

.result-actions button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  margin: 0;
  padding: 0;
  border-radius: 16rpx;
  color: #1957E8;
  background: #ffffff;
  border: 1rpx solid #eef1f6;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 56rpx;
  text-align: center;
}

.bottom-space {
  height: 80rpx;
}

.asset-picker-mask {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  width: 100%;
  height: 100%;
  background: rgba(15,23,42,0.08);
}

.asset-picker {
  width: 100%;
  max-height: 78vh;
  padding: 26rpx 24rpx 32rpx;
  box-sizing: border-box;
  border-radius: 32rpx 32rpx 0 0;
  background: #ffffff;
  border-top: 1rpx solid rgba(16,245,221,0.28);
}

.asset-picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 900;
}

.asset-picker-head button {
  width: 56rpx;
  height: 56rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  color: #64748b;
  background: #ffffff;
  font-size: 34rpx;
  line-height: 52rpx;
}

.asset-picker-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 260rpx;
  color: #64748b;
  font-size: 26rpx;
}

.asset-picker-list {
  max-height: 760rpx;
  margin-top: 22rpx;
}

.asset-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  padding-bottom: 10rpx;
}

.asset-option {
  position: relative;
  overflow: hidden;
  aspect-ratio: 1 / 1;
  border-radius: 20rpx;
  border: 2rpx solid #eef1f6;
  background: #ffffff;
}

.asset-option image {
  width: 100%;
  height: 100%;
}

.asset-option.selected {
  border-color: #1957E8;
  box-shadow: 0 0 0 3rpx rgba(16,245,221,0.34) inset;
}

.asset-check {
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  border-radius: 999rpx;
  color: transparent;
  background: rgba(15,23,42,0.08);
  border: 1rpx solid #eef1f6;
  font-size: 24rpx;
  font-weight: 1000;
}

.asset-option.selected .asset-check {
  color: #ffffff;
  background: #1957E8;
  border-color: #1957E8;
}

.asset-picker-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 22rpx;
}

.asset-picker-actions button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 82rpx;
  margin: 0;
  padding: 0;
  border-radius: 22rpx;
  font-size: 27rpx;
  font-weight: 900;
}

.ghost-action {
  color: #1957E8;
  background: #ffffff;
  border: 1rpx solid #eef1f6;
}

.primary-action {
  color: #ffffff;
  background: linear-gradient(135deg, #1957E8, #00D6B9);
}

.top-audio-btn { height: 56rpx; line-height: 56rpx; padding: 0 22rpx; font-size: 22rpx; color: #0f172a; background: #ffffff; border: 1rpx solid #eef1f6; border-radius: 999rpx; }
.audio-overlay { position: fixed; inset: 0; z-index: 120; display: flex; align-items: flex-end; background: rgba(2,6,23,0.55); }
.audio-sheet { width: 100%; max-height: 80vh; overflow-y: auto; padding: 28rpx; background: #fff; border-radius: 24rpx 24rpx 0 0; }
.audio-sheet-head { display: flex; align-items: center; justify-content: space-between; }
.audio-sheet-title { font-size: 30rpx; font-weight: 600; color: #0f172a; }
.audio-sheet-close { font-size: 40rpx; color: #64748b; }
.audio-empty { padding: 24rpx 0; font-size: 24rpx; color: #64748b; }
.audio-pick { padding: 22rpx 0; border-top: 2rpx solid #f1f5f9; }
.audio-pick-name { display: block; font-size: 28rpx; color: #0f172a; }
.audio-pick-meta { display: block; margin-top: 6rpx; font-size: 22rpx; color: #64748b; }


.audio-entry {
  position: relative;
  z-index: 1;
  margin-top: 18rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #eef1f6;
  color: #0f172a;
  font-size: 24rpx;
}

.task-panel {
  position: relative;
  z-index: 1;
  margin-top: 20rpx;
  padding: 26rpx;
  border-radius: 28rpx;
  background: #ffffff;
  border: 1rpx solid #eef1f6;
}

.task-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8rpx; }
.task-title { font-size: 30rpx; font-weight: 900; color: #0f172a; }
.task-count { font-size: 22rpx; color: #94a3b8; }
.task-empty { padding: 80rpx 0; text-align: center; color: #94a3b8; font-size: 25rpx; }
.task-row { display: flex; align-items: center; padding: 22rpx 0; border-bottom: 1rpx solid #f1f5f9; }
.task-row:last-child { border-bottom: 0; }
.task-thumb { width: 96rpx; height: 96rpx; border-radius: 16rpx; flex: 0 0 96rpx; background: #f8fafc; }
.task-thumb-empty { display: flex; align-items: center; justify-content: center; color: #cbd5e1; font-size: 26rpx; }
.task-main { flex: 1; min-width: 0; margin-left: 18rpx; }
.task-name { display: block; font-size: 27rpx; color: #0f172a; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.task-meta { display: block; margin-top: 8rpx; font-size: 21rpx; color: #94a3b8; }
.task-go { margin-left: 12rpx; font-size: 24rpx; color: #1957E8; }


.task-head-actions { display: flex; align-items: center; gap: 16rpx; }
.list-add { font-size: 25rpx; color: #1957E8; font-weight: 600; }


.panel { position: relative; z-index: 1; padding: 28rpx; margin-top: 20rpx; margin-bottom: 24rpx; background: #fff; border-radius: 24rpx; box-shadow: 0 12rpx 32rpx rgba(15,23,42,0.06); }
.label { display: block; margin: 20rpx 0 12rpx; font-size: 24rpx; color: #64748b; }
.hint { display: block; margin-top: 10rpx; font-size: 22rpx; color: #64748b; line-height: 1.5; }
.list-head { display: flex; align-items: center; justify-content: space-between; }
.list-add { font-size: 26rpx; color: #1957E8; font-weight: 600; }
.job-row { display: flex; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #eef1f6; }
.job-row:last-child { border-bottom: 0; }
.job-main { flex: 1; min-width: 0; }
.job-title { display: block; font-size: 28rpx; color: #0f172a; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.job-meta { display: block; margin-top: 6rpx; font-size: 21rpx; color: #94a3b8; }
.job-go { font-size: 24rpx; color: #1957E8; }
