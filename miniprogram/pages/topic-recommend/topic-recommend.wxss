page { background: #f8f9fa; color: #0f172a; }

.page {
  position: relative;
  min-height: 100vh;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
  color: #0f172a;
  overflow: hidden;
}

.bg-grid {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background-image:
    linear-gradient(rgba(16, 245, 221, 0.06) 1px, transparent 1px),
    linear-gradient(90deg, rgba(16, 245, 221, 0.06) 1px, transparent 1px);
  background-size: 56rpx 56rpx;
  pointer-events: none;
}

.bg-glow {
  position: fixed;
  top: -220rpx; right: -160rpx;
  width: 620rpx; height: 620rpx;
  border-radius: 50%;
  background: #f8f9fa;
  pointer-events: none;
}

.head { position: relative; padding: 8rpx 4rpx 24rpx; }
.head-title { font-size: 44rpx; font-weight: 700; letter-spacing: 2rpx; }
.head-sub { margin-top: 10rpx; font-size: 24rpx; color: #64748b; line-height: 1.5; }

.panel {
  position: relative;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid #ccfbf1;
}

.panel-acts { display: flex; gap: 16rpx; }

.btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.btn.primary {
  flex: 1.35;
  color: #ffffff;
  background: linear-gradient(135deg, #1957E8, #00B3A0);
}
.btn.ghost {
  flex: 1;
  color: #0f766e;
  background: #f0fdfa;
  border: 1rpx solid #99f6e4;
  font-weight: 500;
  font-size: 26rpx;
}
.btn.busy { opacity: 0.55; }

.err {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: #fef2f2;
  border: 1rpx solid #fecaca;
  color: #b91c1c;
  font-size: 24rpx;
  line-height: 1.5;
}

.note {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.5;
}

.prog { margin-top: 22rpx; }
.prog-bar {
  height: 10rpx;
  border-radius: 8rpx;
  background: #e2e8f0;
  overflow: hidden;
}
.prog-fill {
  height: 100%;
  border-radius: 8rpx;
  background: #1957E8;
  transition: width 0.4s ease;
}
.prog-meta {
  margin-top: 10rpx;
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #64748b;
}
.prog-num { color: #1957E8; }

.calls { margin-top: 18rpx; }
.call {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
  font-size: 22rpx;
  color: #64748b;
}
.call-dot {
  width: 12rpx; height: 12rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  background: #94a3b8;
}
.call.running .call-dot { background: #1957E8; box-shadow: 0 0 12rpx rgba(16, 245, 221, 0.9); }
.call.done .call-dot { background: #38d39f; }
.call.failed .call-dot { background: #ff6b6b; }
.call.running .call-label { color: #0f172a; }
.call.done .call-label { color: #0f766e; }
.call-label { flex: 0 0 auto; }
.call-sum { margin-left: 12rpx; color: #64748b; font-size: 21rpx; }

.sec { position: relative; margin-top: 32rpx; }
.sec-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 4rpx 14rpx;
}
.sec-title { font-size: 30rpx; font-weight: 700; }
.sec-tip { font-size: 21rpx; color: #64748b; }
.sec-act { font-size: 24rpx; color: #1957E8; }

.kw-list { display: flex; flex-direction: column; gap: 14rpx; }

.kw {
  padding: 20rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
}
.kw.on { border-color: #5eead4; background: #f0fdfa; }

.kw-top { display: flex; align-items: center; justify-content: space-between; }
.kw-word { font-size: 30rpx; font-weight: 700; color: #0f172a; }
.kw-score { display: flex; align-items: baseline; }
.kw-score-num { font-size: 36rpx; font-weight: 700; color: #1957E8; }
.kw-score-unit { font-size: 20rpx; color: #64748b; margin-left: 4rpx; }

.kw-bars { margin-top: 14rpx; display: flex; flex-direction: column; gap: 8rpx; }
.bar { display: flex; align-items: center; }
.bar-k { width: 70rpx; font-size: 20rpx; color: #64748b; }
.bar-t { flex: 1; height: 8rpx; border-radius: 6rpx; background: #e2e8f0; overflow: hidden; }
.bar-f { height: 100%; border-radius: 6rpx; }
.bar-f.heat { background: #d97706; }
.bar-f.room { background: #1957E8; }
.bar-f.fit { background: #0ea5e9; }
.bar-f.money { background: #7c3aed; }

.kw-live {
  margin-top: 12rpx;
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #ffffff;
  background: #1957E8;
}

.serp {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: #f0fdfa;
  border: 1rpx solid #ccfbf1;
}
.serp-row { display: flex; align-items: flex-start; margin-bottom: 6rpx; }
.serp-k { flex: 0 0 auto; width: 62rpx; font-size: 20rpx; color: #64748b; }
.serp-v { flex: 1; font-size: 21rpx; color: #64748b; line-height: 1.5; }
.serp-verdict {
  margin-top: 8rpx;
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 600;
}
.serp-verdict.good { color: #064e3b; background: #a7f3d0; }
.serp-verdict.mid { color: #ffffff; background: #b45309; }
.serp-verdict.bad { color: #7f1d1d; background: #fecaca; }
.serp-verdict.none { color: #64748b; background: #f1f5f9; }
.serp-margin { margin-left: 12rpx; font-weight: 400; opacity: 0.85; }

.kw-line { margin-top: 10rpx; display: flex; align-items: flex-start; }
.mini {
  flex: 0 0 auto;
  width: 34rpx; height: 34rpx; line-height: 34rpx;
  text-align: center;
  border-radius: 8rpx;
  font-size: 19rpx;
  margin-right: 10rpx;
}
.mini.good { color: #064e3b; background: #a7f3d0; }
.mini.bad { color: #7f1d1d; background: #fecaca; }
.kw-line-text { flex: 1; font-size: 22rpx; color: #64748b; line-height: 1.5; }
.kw-note { margin-top: 10rpx; font-size: 22rpx; color: #64748b; line-height: 1.5; }

.grid-card {
  margin-bottom: 14rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
}
.grid-head { display: flex; align-items: baseline; justify-content: space-between; }
.grid-center { font-size: 26rpx; font-weight: 700; color: #1957E8; }
.grid-kw { font-size: 20rpx; color: #64748b; }
.chips { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 12rpx; }
.chip {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  line-height: 1.4;
}
.chip.inner { color: #0f766e; background: #ccfbf1; }
.chip.outer { color: #1d4ed8; background: #eff6ff; }

.empty {
  padding: 40rpx 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #64748b;
  border-radius: 20rpx;
  border: 1rpx dashed #cbd5e1;
}

.tp {
  margin-bottom: 12rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  overflow: hidden;
}
.tp-head { display: flex; align-items: flex-start; padding: 20rpx; }
.tp-idx {
  flex: 0 0 auto;
  width: 44rpx; height: 44rpx; line-height: 44rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #1957E8;
  background: #ccfbf1;
  margin-right: 16rpx;
}
.tp-main { flex: 1; }
.tp-title { font-size: 28rpx; font-weight: 600; line-height: 1.45; color: #0f172a; }
.tp-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 10rpx; }
.tag {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  color: #ffffff;
  background: #1957E8;
}
.tag.dim { color: #64748b; background: #f1f5f9; }
.tag.fmt { color: #7c3aed; background: #f5f3ff; }
.tp-score { flex: 0 0 auto; margin-left: 12rpx; font-size: 24rpx; color: #d97706; }

.tp-body { padding: 0 20rpx 20rpx; border-top: 1rpx solid #e2e8f0; }
.tp-hook { display: flex; margin-top: 16rpx; }
.tp-k {
  flex: 0 0 auto;
  width: 60rpx;
  font-size: 21rpx;
  color: #64748b;
  padding-top: 2rpx;
}
.tp-v { flex: 1; font-size: 25rpx; color: #0f172a; line-height: 1.65; }
.tp-script { display: flex; margin-top: 14rpx; }
.tp-acts { display: flex; gap: 14rpx; margin-top: 20rpx; }
.btn.mini {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #475569;
  background: #f1f5f9;
}

.foot { margin-top: 40rpx; text-align: center; font-size: 20rpx; color: #64748b; }


.head-actions { margin-top: 16rpx; }
.head-link {
  display: inline-block;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #ccfbf1;
  border: 1rpx solid #99f6e4;
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 600;
}
.task-panel { padding: 26rpx; }
.task-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8rpx; }
.task-title { font-size: 30rpx; font-weight: 700; color: #0f172a; }
.task-count { font-size: 21rpx; color: #94a3b8; }
.task-row { display: flex; align-items: center; padding: 22rpx 0; border-bottom: 1rpx solid #e2e8f0; }
.task-row:last-child { border-bottom: 0; }
.task-main { flex: 1; min-width: 0; }
.task-name { display: block; font-size: 27rpx; color: #0f172a; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.task-meta { display: block; margin-top: 7rpx; font-size: 21rpx; color: #94a3b8; }
.task-go { margin-left: 12rpx; font-size: 24rpx; color: #0f766e; }
.label { display: block; margin: 8rpx 0 12rpx; font-size: 24rpx; color: #475569; }
.empty { padding: 90rpx 0; text-align: center; color: #94a3b8; font-size: 25rpx; }

.head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.head-copy { flex: 1; min-width: 0; }
.head-action { font-size: 26rpx; color: #0f766e; padding: 8rpx 0 8rpx 20rpx; white-space: nowrap; }
