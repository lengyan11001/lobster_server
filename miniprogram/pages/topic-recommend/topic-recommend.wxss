page { background: #05070d; }

.page {
  position: relative;
  min-height: 100vh;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
  color: #e9f4ff;
  overflow: hidden;
}

.bg-grid {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background-image:
    linear-gradient(rgba(16, 245, 221, 0.06) 1px, transparent 1px),
    linear-gradient(90deg, rgba(16, 245, 221, 0.06) 1px, transparent 1px);
  background-size: 56rpx 56rpx;
  pointer-events: none;
}

.bg-glow {
  position: fixed;
  top: -220rpx; right: -160rpx;
  width: 620rpx; height: 620rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(16, 245, 221, 0.20), rgba(16, 245, 221, 0) 68%);
  pointer-events: none;
}

.head { position: relative; padding: 8rpx 4rpx 24rpx; }
.head-title { font-size: 44rpx; font-weight: 700; letter-spacing: 2rpx; }
.head-sub { margin-top: 10rpx; font-size: 24rpx; color: #7f94ad; line-height: 1.5; }

.panel {
  position: relative;
  padding: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(160deg, rgba(18, 27, 40, 0.96), rgba(10, 15, 24, 0.96));
  border: 1rpx solid rgba(16, 245, 221, 0.16);
}

.panel-acts { display: flex; gap: 16rpx; }

.btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.btn.primary {
  flex: 1.35;
  color: #04211e;
  background: linear-gradient(120deg, #10f5dd, #4ad6ff);
}
.btn.ghost {
  flex: 1;
  color: #9fe9e0;
  background: rgba(16, 245, 221, 0.08);
  border: 1rpx solid rgba(16, 245, 221, 0.32);
  font-weight: 500;
  font-size: 26rpx;
}
.btn.busy { opacity: 0.55; }

.err {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: rgba(255, 92, 92, 0.12);
  border: 1rpx solid rgba(255, 92, 92, 0.34);
  color: #ff9d9d;
  font-size: 24rpx;
  line-height: 1.5;
}

.note {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #7f94ad;
  line-height: 1.5;
}

.prog { margin-top: 22rpx; }
.prog-bar {
  height: 10rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
}
.prog-fill {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #10f5dd, #4ad6ff);
  transition: width 0.4s ease;
}
.prog-meta {
  margin-top: 10rpx;
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #8aa2ba;
}
.prog-num { color: #10f5dd; }

.calls { margin-top: 18rpx; }
.call {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
  font-size: 22rpx;
  color: #6f849c;
}
.call-dot {
  width: 12rpx; height: 12rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  background: #33445a;
}
.call.running .call-dot { background: #10f5dd; box-shadow: 0 0 12rpx rgba(16, 245, 221, 0.9); }
.call.done .call-dot { background: #38d39f; }
.call.failed .call-dot { background: #ff6b6b; }
.call.running .call-label { color: #cfe9ff; }
.call.done .call-label { color: #9fe9e0; }
.call-label { flex: 0 0 auto; }
.call-sum { margin-left: 12rpx; color: #6f849c; font-size: 21rpx; }

.sec { position: relative; margin-top: 32rpx; }
.sec-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 4rpx 14rpx;
}
.sec-title { font-size: 30rpx; font-weight: 700; }
.sec-tip { font-size: 21rpx; color: #6f849c; }
.sec-act { font-size: 24rpx; color: #10f5dd; }

.kw-list { display: flex; flex-direction: column; gap: 14rpx; }

.kw {
  padding: 20rpx;
  border-radius: 20rpx;
  background: rgba(14, 21, 32, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
}
.kw.on { border-color: rgba(16, 245, 221, 0.6); background: rgba(16, 245, 221, 0.07); }

.kw-top { display: flex; align-items: center; justify-content: space-between; }
.kw-word { font-size: 30rpx; font-weight: 700; color: #eaf8ff; }
.kw-score { display: flex; align-items: baseline; }
.kw-score-num { font-size: 36rpx; font-weight: 700; color: #10f5dd; }
.kw-score-unit { font-size: 20rpx; color: #7f94ad; margin-left: 4rpx; }

.kw-bars { margin-top: 14rpx; display: flex; flex-direction: column; gap: 8rpx; }
.bar { display: flex; align-items: center; }
.bar-k { width: 70rpx; font-size: 20rpx; color: #6f849c; }
.bar-t { flex: 1; height: 8rpx; border-radius: 6rpx; background: rgba(255, 255, 255, 0.07); overflow: hidden; }
.bar-f { height: 100%; border-radius: 6rpx; }
.bar-f.heat { background: #ff9f45; }
.bar-f.room { background: #10f5dd; }
.bar-f.fit { background: #4ad6ff; }
.bar-f.money { background: #b48cff; }

.kw-live {
  margin-top: 12rpx;
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #04211e;
  background: #10f5dd;
}

.serp {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: rgba(16, 245, 221, 0.05);
  border: 1rpx solid rgba(16, 245, 221, 0.16);
}
.serp-row { display: flex; align-items: flex-start; margin-bottom: 6rpx; }
.serp-k { flex: 0 0 auto; width: 62rpx; font-size: 20rpx; color: #6f849c; }
.serp-v { flex: 1; font-size: 21rpx; color: #a9bed3; line-height: 1.5; }
.serp-verdict {
  margin-top: 8rpx;
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 600;
}
.serp-verdict.good { color: #04211e; background: #38d39f; }
.serp-verdict.mid { color: #241a05; background: #ffc861; }
.serp-verdict.bad { color: #2a0b0b; background: #ff8a8a; }
.serp-verdict.none { color: #9fb4c9; background: rgba(255, 255, 255, 0.08); }
.serp-margin { margin-left: 12rpx; font-weight: 400; opacity: 0.85; }

.kw-line { margin-top: 10rpx; display: flex; align-items: flex-start; }
.mini {
  flex: 0 0 auto;
  width: 34rpx; height: 34rpx; line-height: 34rpx;
  text-align: center;
  border-radius: 8rpx;
  font-size: 19rpx;
  margin-right: 10rpx;
}
.mini.good { color: #04211e; background: #38d39f; }
.mini.bad { color: #2a0b0b; background: #ff8a8a; }
.kw-line-text { flex: 1; font-size: 22rpx; color: #a9bed3; line-height: 1.5; }
.kw-note { margin-top: 10rpx; font-size: 22rpx; color: #7f94ad; line-height: 1.5; }

.grid-card {
  margin-bottom: 14rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: rgba(14, 21, 32, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
}
.grid-head { display: flex; align-items: baseline; justify-content: space-between; }
.grid-center { font-size: 26rpx; font-weight: 700; color: #10f5dd; }
.grid-kw { font-size: 20rpx; color: #6f849c; }
.chips { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 12rpx; }
.chip {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  line-height: 1.4;
}
.chip.inner { color: #9fe9e0; background: rgba(16, 245, 221, 0.12); }
.chip.outer { color: #a9c4ff; background: rgba(74, 163, 255, 0.12); }

.empty {
  padding: 40rpx 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #6f849c;
  border-radius: 20rpx;
  border: 1rpx dashed rgba(255, 255, 255, 0.12);
}

.tp {
  margin-bottom: 12rpx;
  border-radius: 18rpx;
  background: rgba(14, 21, 32, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  overflow: hidden;
}
.tp-head { display: flex; align-items: flex-start; padding: 20rpx; }
.tp-idx {
  flex: 0 0 auto;
  width: 44rpx; height: 44rpx; line-height: 44rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #10f5dd;
  background: rgba(16, 245, 221, 0.10);
  margin-right: 16rpx;
}
.tp-main { flex: 1; }
.tp-title { font-size: 28rpx; font-weight: 600; line-height: 1.45; color: #eaf8ff; }
.tp-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 10rpx; }
.tag {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  color: #04211e;
  background: #10f5dd;
}
.tag.dim { color: #9fb4c9; background: rgba(255, 255, 255, 0.08); }
.tag.fmt { color: #b48cff; background: rgba(180, 140, 255, 0.14); }
.tp-score { flex: 0 0 auto; margin-left: 12rpx; font-size: 24rpx; color: #ff9f45; }

.tp-body { padding: 0 20rpx 20rpx; border-top: 1rpx solid rgba(255, 255, 255, 0.06); }
.tp-hook { display: flex; margin-top: 16rpx; }
.tp-k {
  flex: 0 0 auto;
  width: 60rpx;
  font-size: 21rpx;
  color: #6f849c;
  padding-top: 2rpx;
}
.tp-v { flex: 1; font-size: 25rpx; color: #cfe1f2; line-height: 1.65; }
.tp-script { display: flex; margin-top: 14rpx; }
.tp-acts { display: flex; gap: 14rpx; margin-top: 20rpx; }
.btn.mini {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #9fb4c9;
  background: rgba(255, 255, 255, 0.06);
}

.foot { margin-top: 40rpx; text-align: center; font-size: 20rpx; color: #4c5e73; }
