<view class="page">
  <view class="bg-grid"></view>
  <view class="bg-glow"></view>

  <view class="head">
    <view class="head-title">推荐选题</view>
    <view class="head-sub">IP 档案 → 账号关键词 → 5×5 宫格 → 50 条选题与口播文案</view>
  </view>

  <view class="panel">
    <view class="panel-acts">
      <view class="btn primary {{running ? 'busy' : ''}}" bindtap="start">{{running ? '生成中…' : (hasPlan ? '重新生成 50 条' : 'AI 生成 50 条选题')}}</view>
      <view class="btn ghost {{metricsLoading ? 'busy' : ''}}" bindtap="checkDouyin">{{metricsLoading ? '校验中…' : '抖音数据校验'}}</view>
    </view>

    <view wx:if="{{errorText}}" class="err">{{errorText}}</view>
    <view wx:if="{{metricsNote}}" class="note">{{metricsNote}}</view>

    <view wx:if="{{running}}" class="prog">
      <view class="prog-bar"><view class="prog-fill" style="width:{{progress}}%"></view></view>
      <view class="prog-meta"><text class="prog-stage">{{stage}}</text><text class="prog-num">{{progress}}%</text></view>
    </view>

    <view wx:if="{{calls.length}}" class="calls">
      <view wx:for="{{calls}}" wx:key="id" class="call {{item.status}}">
        <text class="call-dot"></text>
        <text class="call-label">{{item.label}}</text>
        <text class="call-sum">{{item.summary}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{keywords.length}}" class="sec">
    <view class="sec-head">
      <text class="sec-title">账号关键词</text>
      <text class="sec-tip">点一个关键词只看它的选题</text>
    </view>
    <view class="kw-list">
      <view wx:for="{{keywords}}" wx:key="word" class="kw {{activeKeyword === item.word ? 'on' : ''}}" data-word="{{item.word}}" bindtap="pickKeyword">
        <view class="kw-top">
          <text class="kw-word">{{item.word}}</text>
          <view class="kw-score"><text class="kw-score-num">{{item.score}}</text><text class="kw-score-unit">分</text></view>
        </view>
        <view class="kw-bars">
          <view class="bar"><text class="bar-k">热度</text><view class="bar-t"><view class="bar-f heat" style="width:{{item.heat}}%"></view></view></view>
          <view class="bar"><text class="bar-k">机会</text><view class="bar-t"><view class="bar-f room" style="width:{{item.room}}%"></view></view></view>
          <view class="bar"><text class="bar-k">匹配</text><view class="bar-t"><view class="bar-f fit" style="width:{{item.fit}}%"></view></view></view>
          <view class="bar"><text class="bar-k">变现</text><view class="bar-t"><view class="bar-f money" style="width:{{item.monetize}}%"></view></view></view>
        </view>
        <view wx:if="{{item.source === 'douyin'}}" class="kw-live">{{item.liveText}}</view>
        <view wx:if="{{item.prosText}}" class="kw-line"><text class="mini good">优</text><text class="kw-line-text">{{item.prosText}}</text></view>
        <view wx:if="{{item.consText}}" class="kw-line"><text class="mini bad">劣</text><text class="kw-line-text">{{item.consText}}</text></view>
        <view wx:if="{{item.note}}" class="kw-note">{{item.note}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{grids.length}}" class="sec">
    <view class="sec-head">
      <text class="sec-title">宫格拆解</text>
      <text class="sec-tip">选题 = 内圈词 × 外圈人群场景</text>
    </view>
    <view wx:for="{{grids}}" wx:key="keyword" class="grid-card">
      <view class="grid-head"><text class="grid-center">{{item.center}}</text><text class="grid-kw">内圈 {{item.inner.length}} · 外圈 {{item.outer.length}}</text></view>
      <view class="chips">
        <text wx:for="{{item.inner}}" wx:for-item="word" wx:key="*this" class="chip inner">{{word}}</text>
      </view>
      <view class="chips">
        <text wx:for="{{item.outer}}" wx:for-item="word" wx:key="*this" class="chip outer">{{word}}</text>
      </view>
    </view>
  </view>

  <view class="sec" id="topic-list">
    <view class="sec-head">
      <text class="sec-title">选题{{activeKeyword ? ' · ' + activeKeyword : ''}}（{{viewTopics.length}}）</text>
      <text wx:if="{{viewTopics.length}}" class="sec-act" bindtap="copyAll">全部复制</text>
    </view>
    <view wx:if="{{!viewTopics.length}}" class="empty">{{running ? '正在生成，先出的会一条条补上来…' : '还没有选题，点上面「AI 生成 50 条选题」'}}</view>

    <view wx:for="{{viewTopics}}" wx:key="id" class="tp">
      <view class="tp-head" data-id="{{item.id}}" bindtap="toggleTopic">
        <text class="tp-idx">{{index + 1}}</text>
        <view class="tp-main">
          <text class="tp-title">{{item.title}}</text>
          <view class="tp-tags">
            <text class="tag">{{item.keyword}}</text>
            <text wx:if="{{item.inner}}" class="tag dim">{{item.inner}}</text>
            <text wx:if="{{item.outer}}" class="tag dim">× {{item.outer}}</text>
            <text class="tag fmt">{{item.format}}</text>
          </view>
        </view>
        <text wx:if="{{item.score}}" class="tp-score">{{item.score}}</text>
      </view>
      <view wx:if="{{openId === item.id}}" class="tp-body">
        <view wx:if="{{item.hook}}" class="tp-hook"><text class="tp-k">钩子</text><text class="tp-v">{{item.hook}}</text></view>
        <view class="tp-script"><text class="tp-k">口播</text><text class="tp-v">{{item.script}}</text></view>
        <view class="tp-acts">
          <view class="btn mini" data-id="{{item.id}}" catchtap="copyTopic">一键复制</view>
          <view class="btn mini primary" data-id="{{item.id}}" catchtap="toDigital">带入数字人</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{generatedAt}}" class="foot">生成于 {{generatedAt}}</view>
</view>
