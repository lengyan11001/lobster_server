<view class="page">
  <view class="head">
    <view class="head-row">
      <view>
        <text class="title">素材与分身</text>
        <text class="sub">{{tabs[tabIndex]}} · {{tabCount}} 个</text>
      </view>
      <button class="primary small" bindtap="upload">{{isDigital ? '新建' : '上传'}}</button>
    </view>
    <input wx:if="{{!isDigital}}" class="search" value="{{keyword}}" bindinput="onKeyword" placeholder="搜索文件名" />
  </view>

  <view class="tabs">
    <view wx:for="{{tabs}}" wx:key="*this" class="tab {{tabIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="switchTab">{{item}}</view>
  </view>

  <view wx:if="{{loading && !currentCount}}" class="empty">加载中…</view>
  <view wx:elif="{{!currentCount}}" class="empty">暂无{{tabs[tabIndex]}}</view>

  <view wx:if="{{!isDigital}}" class="grid">
    <view wx:for="{{items}}" wx:key="asset_id" class="cell" data-index="{{index}}" bindtap="preview" bindlongpress="onAssetMenu">
      <image class="thumb" src="{{item.thumb}}" mode="aspectFill" />
      <view wx:if="{{item.media_type !== 'image'}}" class="badge">{{item.media_type === 'video' ? '▶' : '♪'}}</view>
      <view class="del" data-index="{{index}}" catchtap="remove">×</view>
      <text class="name">{{item.name}}</text>
      <text wx:if="{{item.group}}" class="group">{{item.group}}</text>
      <text wx:if="{{item.tags}}" class="tags">{{item.tags}}</text>
    </view>
  </view>

  <view wx:elif="{{tabIndex === 3}}" class="grid">
    <view wx:for="{{avatars}}" wx:key="id" class="cell" data-index="{{index}}" bindtap="previewAvatar">
      <image wx:if="{{item.thumb}}" class="thumb" src="{{item.thumb}}" mode="aspectFill" />
      <view wx:else class="thumb thumb-empty">形象</view>
      <view wx:if="{{item.isVideo}}" class="badge">▶</view>
      <view class="del" data-index="{{index}}" catchtap="removeAvatar">×</view>
      <text class="name">{{item.title}}</text>
      <text class="status {{item.ok ? 'ok' : ''}}">{{item.statusText}}</text>
    </view>
  </view>

  <view wx:else class="voice-list">
    <view wx:for="{{voices}}" wx:key="id" class="voice" data-index="{{index}}">
      <view class="voice-main" bindtap="playVoice">
        <text class="voice-title">{{item.title}}</text>
        <text class="voice-meta">{{item.provider}} · {{item.statusText}}</text>
      </view>
      <view class="voice-actions">
        <button class="ghost tiny" data-index="{{index}}" catchtap="playVoice">试听</button>
        <button class="ghost tiny danger" data-index="{{index}}" catchtap="removeVoice">删除</button>
      </view>
    </view>
  </view>
</view>