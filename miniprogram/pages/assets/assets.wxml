<view class="page">
  <block wx:if="{{viewMode === 'home'}}">
    <view class="head">
      <text class="title">素材库</text>
      <text class="sub">IP人设 · 数字人声音 · 图片 · 视频</text>
    </view>
    <view class="entry-grid">
      <view class="entry-card ip" data-key="ip" bindtap="goEntry" hover-class="entry-press">
        <text class="entry-ico">IP</text>
        <view class="entry-body">
          <text class="entry-title">IP人设</text>
          <text class="entry-sub">手动填写个人IP档案</text>
        </view>
      </view>
      <view class="entry-card digital" data-key="digital" bindtap="goEntry" hover-class="entry-press">
        <text class="entry-ico">AI</text>
        <view class="entry-body">
          <text class="entry-title">数字人声音分身</text>
          <text class="entry-sub">形象分身 · 声音分身</text>
        </view>
      </view>
      <view class="entry-card image" data-key="image" bindtap="goEntry" hover-class="entry-press">
        <text class="entry-ico">IMG</text>
        <view class="entry-body">
          <text class="entry-title">图片</text>
          <text class="entry-sub">上传的图片素材</text>
        </view>
      </view>
      <view class="entry-card video" data-key="video" bindtap="goEntry" hover-class="entry-press">
        <text class="entry-ico">VID</text>
        <view class="entry-body">
          <text class="entry-title">视频</text>
          <text class="entry-sub">上传的视频素材</text>
        </view>
      </view>
    </view>
  </block>

  <block wx:else>
  <view class="head">
    <view class="head-row">
      <view class="head-copy">
        <text class="back" bindtap="backHome">‹ 素材库</text>
        <text class="title">{{pageTitle}}</text>
        <text class="sub">{{tabCount}} 个</text>
      </view>
      <button class="primary small" bindtap="upload">{{isDigital ? '新建' : '上传'}}</button>
    </view>
    <input wx:if="{{!isDigital}}" class="search" value="{{keyword}}" bindinput="onKeyword" placeholder="搜索文件名" />
  </view>

  <view wx:if="{{!scope}}" class="tabs">
    <view wx:for="{{tabs}}" wx:key="*this" class="tab {{tabIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="switchTab">{{item}}</view>
  </view>

  <view wx:if="{{loading && !currentCount}}" class="empty">加载中…</view>

  <block wx:if="{{showUploads}}">
  <view wx:if="{{!currentCount}}" class="empty">暂无{{pageTitle}}</view>
  <view class="grid-hint">点素材预览；点右侧「⋯」可编辑分组/标签、加入分组、视频切片</view>
  <view class="grid">
    <view wx:for="{{items}}" wx:key="asset_id" class="cell" data-index="{{index}}" bindtap="preview" bindlongpress="onAssetMenu">
      <image class="thumb" src="{{item.thumb}}" mode="aspectFill" />
      <view wx:if="{{item.media_type !== 'image'}}" class="badge">{{item.media_type === 'video' ? '▶' : '♪'}}</view>
      <view class="more" data-index="{{index}}" catchtap="onAssetMenu">⋯</view>
      <text class="name">{{item.name}}</text>
      <text wx:if="{{item.group}}" class="group">{{item.group}}</text>
      <text wx:if="{{item.tags}}" class="tags">{{item.tags}}</text>
    </view>
  </view>
  </block>

  <block wx:if="{{showAvatars}}">
  <text wx:if="{{scope === 'digital'}}" class="sec-head">形象分身 · {{avatars.length}}</text>
  <view wx:if="{{scope === 'digital' && !avatars.length}}" class="empty">还没有形象分身</view>
  <view class="grid">
    <view wx:for="{{avatars}}" wx:key="id" class="cell" data-index="{{index}}" bindtap="previewAvatar">
      <image wx:if="{{item.thumb}}" class="thumb" src="{{item.thumb}}" mode="aspectFill" />
      <view wx:else class="thumb thumb-empty">形象</view>
      <view wx:if="{{item.isVideo}}" class="badge">▶</view>
      <view class="del" data-index="{{index}}" catchtap="removeAvatar">×</view>
      <text class="name">{{item.title}}</text>
      <text class="status {{item.ok ? 'ok' : ''}}">{{item.statusText}}</text>
    </view>
  </view>
  </block>

  <block wx:if="{{showVoices}}">
  <text wx:if="{{scope === 'digital'}}" class="sec-head">声音分身 · {{voices.length}}</text>
  <view wx:if="{{scope === 'digital' && !voices.length}}" class="empty">还没有声音分身</view>
  <view class="voice-list">
    <view wx:for="{{voices}}" wx:key="id" class="voice" data-index="{{index}}">
      <view class="voice-main" bindtap="playVoice">
        <text class="voice-title">{{item.title}}</text>
        <text class="voice-meta">{{item.provider}} · {{item.statusText}}</text>
      </view>
      <view class="voice-actions">
        <button class="ghost tiny" data-index="{{index}}" catchtap="playVoice">试听</button>
        <button class="ghost tiny danger" data-index="{{index}}" catchtap="removeVoice">删除</button>
      </view>
    </view>
  </view>
  </block>
  <view wx:if="{{labelOpen}}" class="label-mask" catchtap="closeLabelEditor">
    <view class="label-sheet" catchtap="labelNoop">
      <text class="label-title">编辑分组 / 标签</text>
      <text class="label-sub">分组（可留空）</text>
      <input class="label-input" value="{{labelGroup}}" bindinput="onLabelGroup" placeholder="例如：产品A素材" maxlength="60" cursor-spacing="120" />
      <text class="label-sub">标签（逗号分隔，可留空）</text>
      <input class="label-input" value="{{labelTags}}" bindinput="onLabelTags" placeholder="例如：口播,产品" maxlength="200" cursor-spacing="120" />
      <view class="label-actions">
        <button class="ghost half" bindtap="closeLabelEditor">取消</button>
        <button class="primary half" loading="{{labelSaving}}" bindtap="saveLabels">保存</button>
      </view>
    </view>
  </view>

  <view wx:if="{{previewOpen}}" class="asset-preview">
    <view class="asset-preview-head">
      <view class="asset-preview-back" bindtap="closePreview">‹ 返回</view>
      <text class="asset-preview-title">{{previewTitle}}</text>
      <view class="asset-preview-spacer"></view>
    </view>
    <video wx:if="{{previewType === 'video'}}" class="asset-preview-body" src="{{previewUrl}}" controls autoplay object-fit="contain"></video>
    <image wx:else class="asset-preview-body" src="{{previewUrl}}" mode="aspectFit" />
  </view>
</block>
</view>
