.page { min-height: 100vh; padding: 28rpx; background: #f3f6fb; }
.head { padding: 12rpx 4rpx 8rpx; }
.head-row { display: flex; align-items: center; justify-content: space-between; }
.title { display: block; font-size: 42rpx; font-weight: 700; }
.sub { display: block; margin-top: 6rpx; font-size: 24rpx; color: #64748b; }
.primary.small { margin: 0; height: 64rpx; line-height: 64rpx; padding: 0 28rpx; font-size: 24rpx; color: #fff; background: #2563eb; border-radius: 999rpx; }
.search { width: 100%; height: 72rpx; margin-top: 20rpx; padding: 0 24rpx; font-size: 26rpx; background: #fff; border-radius: 999rpx; }
.tabs { display: flex; gap: 10rpx; padding: 20rpx 0; flex-wrap: wrap; }
.tab { padding: 12rpx 22rpx; font-size: 24rpx; color: #475569; background: #fff; border-radius: 999rpx; }
.tab.active { color: #fff; background: #2563eb; }
.grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.cell { position: relative; width: 218rpx; }
.thumb { width: 218rpx; height: 218rpx; border-radius: 16rpx; background: #e2e8f0; }
.thumb-empty { display: flex; align-items: center; justify-content: center; font-size: 26rpx; color: #94a3b8; }
.badge { position: absolute; left: 10rpx; top: 10rpx; width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center; font-size: 20rpx; color: #fff; background: rgba(0,0,0,0.55); border-radius: 50%; }
.del { position: absolute; right: 6rpx; top: 6rpx; width: 40rpx; height: 40rpx; line-height: 38rpx; text-align: center; font-size: 26rpx; color: #fff; background: rgba(239,68,68,0.9); border-radius: 50%; }
.name { display: block; margin-top: 8rpx; font-size: 22rpx; color: #475569; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.status { display: block; font-size: 20rpx; color: #f59e0b; }
.status.ok { color: #16a34a; }
.voice-list { display: flex; flex-direction: column; gap: 16rpx; }
.voice { display: flex; align-items: center; justify-content: space-between; padding: 24rpx; background: #fff; border-radius: 18rpx; }
.voice-main { flex: 1; }
.voice-title { display: block; font-size: 28rpx; color: #0f172a; }
.voice-meta { display: block; margin-top: 6rpx; font-size: 22rpx; color: #94a3b8; }
.ghost.tiny { margin: 0; width: 120rpx; height: 60rpx; line-height: 60rpx; font-size: 22rpx; color: #2563eb; background: #eff6ff; border-radius: 999rpx; }
.empty { padding: 48rpx; text-align: center; font-size: 24rpx; color: #94a3b8; }
.group { display: block; font-size: 20rpx; color: #2563eb; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

.tags { display: block; font-size: 20rpx; color: #94a3b8; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
