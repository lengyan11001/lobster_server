.page { min-height: 100vh; padding: 28rpx; background: #f8f9fa; }
.head { padding: 12rpx 4rpx 8rpx; }
.head-row { display: flex; align-items: center; justify-content: space-between; }
.title { display: block; font-size: 42rpx; font-weight: 700; }
.sub { display: block; margin-top: 6rpx; font-size: 24rpx; color: #64748b; }
.primary.small { margin: 0; height: 64rpx; line-height: 64rpx; padding: 0 28rpx; font-size: 24rpx; color: #ffffff; background: linear-gradient(135deg, #1957E8, #00D6B9); border-radius: 999rpx; }
.search { width: 100%; height: 72rpx; margin-top: 20rpx; padding: 0 24rpx; font-size: 26rpx; background: #fff; border-radius: 999rpx; }
.tabs { display: flex; gap: 10rpx; padding: 20rpx 0; flex-wrap: wrap; }
.tab { padding: 12rpx 22rpx; font-size: 24rpx; color: #475569; background: #fff; border-radius: 999rpx; }
.tab.active { color: #ffffff; background: linear-gradient(135deg, #1957E8, #00D6B9); }
.grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.cell { position: relative; width: 218rpx; }
.thumb { width: 218rpx; height: 218rpx; border-radius: 16rpx; background: #e2e8f0; }
.thumb-empty { display: flex; align-items: center; justify-content: center; font-size: 26rpx; color: #64748b; }
.badge { position: absolute; left: 10rpx; top: 10rpx; width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center; font-size: 20rpx; color: #0f172a; background: rgba(15,23,42,0.08); border-radius: 50%; }
.del { position: absolute; right: 6rpx; top: 6rpx; width: 40rpx; height: 40rpx; line-height: 38rpx; text-align: center; font-size: 26rpx; color: #0f172a; background: rgba(239,68,68,0.9); border-radius: 50%; }
.more { position: absolute; right: 6rpx; top: 170rpx; width: 40rpx; height: 40rpx; line-height: 34rpx; text-align: center; font-size: 26rpx; color: #0f172a; background: rgba(255,255,255,0.92); border-radius: 50%; box-shadow: 0 2rpx 8rpx rgba(15,23,42,0.18); }
.grid-hint { margin: 4rpx 0 14rpx; font-size: 22rpx; color: #64748b; }
.name { display: block; margin-top: 8rpx; font-size: 22rpx; color: #475569; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.status { display: block; font-size: 20rpx; color: #f59e0b; }
.status.ok { color: #16a34a; }
.voice-list { display: flex; flex-direction: column; gap: 16rpx; }
.voice { display: flex; align-items: center; justify-content: space-between; padding: 24rpx; background: #fff; border-radius: 18rpx; }
.voice-main { flex: 1; }
.voice-title { display: block; font-size: 28rpx; color: #0f172a; }
.voice-meta { display: block; margin-top: 6rpx; font-size: 22rpx; color: #64748b; }
.ghost.tiny { margin: 0; width: 120rpx; height: 60rpx; line-height: 60rpx; font-size: 22rpx; color: #1957E8; background: #eff6ff; border-radius: 999rpx; }
.empty { padding: 48rpx; text-align: center; font-size: 24rpx; color: #64748b; }
.group { display: block; font-size: 20rpx; color: #1957E8; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

.tags { display: block; font-size: 20rpx; color: #64748b; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

.voice-actions { display: flex; gap: 12rpx; margin-left: 12rpx; }
.ghost.tiny.danger { color: #dc2626; background: #fef2f2; }


.asset-preview { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 9999; display: flex; flex-direction: column; background: #000; }
.asset-preview-head { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 28rpx; }
.asset-preview-back { font-size: 28rpx; color: #fff; padding: 8rpx 12rpx; }
.asset-preview-title { flex: 1; text-align: center; font-size: 28rpx; color: #fff; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.asset-preview-spacer { width: 80rpx; }
.asset-preview-body { flex: 1; width: 100%; background: #000; }

.label-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(15,23,42,.45); display: flex; align-items: center; justify-content: center; padding: 40rpx; z-index: 9999; }
.label-sheet { width: 100%; max-height: 80vh; overflow-y: auto; background: #fff; border-radius: 20rpx; padding: 32rpx; display: flex; flex-direction: column; }
.label-title { font-size: 30rpx; font-weight: 600; color: #0f172a; margin-bottom: 20rpx; }
.label-sub { font-size: 24rpx; color: #64748b; margin: 10rpx 0 8rpx; }
.label-input { height: 80rpx; padding: 0 20rpx; font-size: 28rpx; color: #0f172a; background: #f8fafc; border: 2rpx solid #e2e8f0; border-radius: 12rpx; }
.label-actions { display: flex; gap: 20rpx; margin-top: 28rpx; }
.label-actions .half { flex: 1; }

.head-copy { flex: 1; min-width: 0; }
.back { display: block; margin-bottom: 8rpx; font-size: 24rpx; color: #0f766e; font-weight: 600; }
.entry-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; margin-top: 24rpx; }
.entry-card { position: relative; min-height: 200rpx; padding: 26rpx; border-radius: 24rpx; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, 0.12); }
.entry-press { opacity: 0.9; transform: scale(0.99); }
.entry-card.ip { background: linear-gradient(135deg, #1d4ed8, #6d8dff); }
.entry-card.digital { background: linear-gradient(135deg, #0f766e, #2dd4bf); }
.entry-card.image { background: linear-gradient(135deg, #6d28d9, #c084fc); }
.entry-card.video { background: linear-gradient(135deg, #b45309, #f59e0b); }
.entry-ico { font-size: 24rpx; font-weight: 800; letter-spacing: 3rpx; color: rgba(255, 255, 255, 0.72); }
.entry-body { display: flex; flex-direction: column; }
.entry-title { font-size: 30rpx; font-weight: 700; color: #ffffff; }
.entry-sub { margin-top: 8rpx; font-size: 21rpx; line-height: 1.45; color: rgba(255, 255, 255, 0.86); }

.sec-head { display: block; margin: 26rpx 0 14rpx; font-size: 26rpx; font-weight: 700; color: #0f172a; }
