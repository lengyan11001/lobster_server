<view class="page">
  <view class="head">
    <text class="title">视频创作</text>
    <text class="sub">三种方式：数字人口播、分镜头成片、素材混剪</text>
  </view>

  <view class="card" bindtap="goOral">
    <view class="card-main">
      <text class="card-title">数字人口播</text>
      <text class="card-sub">选数字人 + 声音，输入口播稿直接出片</text>
    </view>
    <text class="card-arrow">›</text>
  </view>

  <view class="card" bindtap="goStoryboard">
    <view class="card-main">
      <text class="card-title">分镜头视频</text>
      <text class="card-sub">先出分镜画面，再逐镜生成视频</text>
    </view>
    <text class="card-arrow">›</text>
  </view>

  <view class="card" bindtap="goMontage">
    <view class="card-main">
      <text class="card-title">素材混剪</text>
      <text class="card-sub">上传素材 + 文案，套模板自动混剪</text>
    </view>
    <text class="card-arrow">›</text>
  </view>
</view>
