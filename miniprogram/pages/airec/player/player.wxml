<view class="container">

  <!-- 文件信息 -->
  <view class="info-card">
    <text class="file-name">{{fileName}}</text>
    <text class="file-size" wx:if="{{fileSize}}">大小：{{fileSize}}</text>
  </view>

  <!-- 加载中 -->
  <view class="loading-card" wx:if="{{loading && !errMsg}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 错误提示 -->
  <view class="err-card" wx:if="{{errMsg}}">
    <text class="err-text">⚠️ {{errMsg}}</text>
  </view>

  <!-- 播放器（始终显示，不因 errMsg 隐藏） -->
  <view class="player-card" wx:if="{{!loading}}">
    <!-- 时间 -->
    <view class="time-row">
      <text class="time-text">{{currentTimeStr}}</text>
      <text class="time-text">{{durationStr}}</text>
    </view>

    <!-- 进度条 -->
    <slider
      value="{{sliderValue}}"
      min="0" max="100"
      activeColor="#4A90D9"
      backgroundColor="#e0e0e0"
      block-size="24"
      bindchange="onSliderChange"
      bindchanging="onSliderChanging"
    />

    <!-- 控制按钮 -->
    <view class="controls">
      <view class="ctrl-btn" bindtap="onSeekBack">
        <text class="ctrl-icon">⏪</text>
        <text class="ctrl-label">-10s</text>
      </view>
      <view class="play-btn {{isPlaying ? 'playing' : ''}}" bindtap="onPlayPause">
        <text class="play-icon">{{isPlaying ? '⏸' : '▶'}}</text>
      </view>
      <view class="ctrl-btn" bindtap="onSeekForward">
        <text class="ctrl-icon">⏩</text>
        <text class="ctrl-label">+10s</text>
      </view>
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="action-card" wx:if="{{!loading}}">
    <button class="btn-primary full-btn" bindtap="onSaveToLocal">保存到本地</button>
  </view>

</view>
