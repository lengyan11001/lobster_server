.container { padding: 0 0 40rpx; }

.status-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #fff;
}

.spinner {
  width: 32rpx; height: 32rpx;
  border: 4rpx solid #ddd;
  border-top-color: #4A90D9;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: 16rpx;
  flex-shrink: 0;
}

@keyframes spin { to { transform: rotate(360deg); } }

.status-text { flex: 1; font-size: 26rpx; color: #666; }

.rescan-btn {
  font-size: 26rpx; color: #4A90D9;
  padding: 8rpx 16rpx;
}

.section-header {
  padding: 20rpx 32rpx 8rpx;
  font-size: 24rpx; color: #999;
}

.device-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  margin: 12rpx 24rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.05);
}

.device-info { flex: 1; }
.device-name { font-size: 30rpx; color: #333; display: block; }
.device-id { font-size: 22rpx; color: #999; display: block; margin-top: 4rpx; }
.rssi-value { font-size: 24rpx; color: #999; }

.empty {
  text-align: center; padding: 120rpx 0;
  color: #999; font-size: 28rpx;
}

.last-bar { display: flex; align-items: center; padding: 16rpx 32rpx 4rpx; background: #fff; }
.last-label { font-size: 22rpx; color: #94a3b8; }
.last-name { margin-left: 10rpx; font-size: 24rpx; color: #0f172a; font-weight: 600; }
.last-hint { margin-left: auto; font-size: 22rpx; color: #2563eb; }
.last-cancel { margin-left: 16rpx; font-size: 22rpx; color: #94a3b8; text-decoration: underline; }
.last-tag { margin-left: 12rpx; padding: 2rpx 12rpx; border-radius: 999rpx; background: #eff6ff; color: #2563eb; font-size: 18rpx; }
.device-title-row { display: flex; align-items: center; }
