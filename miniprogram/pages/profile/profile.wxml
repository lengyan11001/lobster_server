<view class="page">
  <view class="top-bg">
    <image class="top-bg-img" src="/assets/design/works-top.jpg" mode="aspectFill" />
    <view class="top-bg-mask"></view>
  </view>

  <view class="top-actions">
    <view class="icon-btn" bindtap="copyDiagnostics" hover-class="press"><image class="icon-ic" src="/assets/icons/ic-chat.png" /></view>
    <view class="icon-btn" bindtap="loadDevices" hover-class="press"><image class="icon-ic" src="/assets/icons/ic-gear.png" /></view>
  </view>

  <view class="identity">
    <view class="avatar-ring">
      <view class="avatar">{{avatarText}}</view>
      <view wx:if="{{phoneBound}}" class="avatar-badge">已绑</view>
    </view>
    <view class="id-main">
      <view class="name-row">
        <text class="name">{{identityName}}</text>
        <text class="status-chip">{{phoneBound ? '已绑定' : (wechatLoggedIn ? '待绑定' : '未登录')}}</text>
      </view>
      <view class="online-line">
        <view class="online-dot {{phoneBound ? 'on' : ''}}"></view>
        <text>{{identitySub}}</text>
      </view>
    </view>
  </view>

  <view class="balance-card">
    <view class="balance-row">
      <view class="balance-left">
        <view class="balance-label"><text>算力余额</text><image class="info-ic" src="/assets/icons/ic-info.png" /></view>
        <text class="balance-num">{{creditsText}}</text>
      </view>
      <view class="recharge-btn" bindtap="goRecharge" hover-class="press"><image class="plus-ic" src="/assets/icons/ic-plus.png" /><text>充值</text></view>
    </view>
    <view class="stats">
      <view class="stat" bindtap="loadDevices" hover-class="press">
        <text class="stat-num">{{onlineDevices.length}}</text>
        <text class="stat-label">在线设备</text>
      </view>
      <view class="stat" bindtap="goDownloads" hover-class="press">
        <text class="stat-num">作品</text>
        <text class="stat-label">内容记录</text>
      </view>
      <view class="stat" bindtap="copyDiagnostics" hover-class="press">
        <text class="stat-num">诊断</text>
        <text class="stat-label">复制信息</text>
      </view>
    </view>
  </view>

  <view wx:if="{{!phoneBound}}" class="login-card login">
    <text class="login-title">{{wechatLoggedIn ? '还差一步，绑定手机号' : '登录后同步你的账号'}}</text>
    <text class="login-desc">授权手机号后，手机端可直接调度电脑端 online，算力与内容记录跨设备同步。</text>

    <view class="steps">
      <view class="step {{wechatLoggedIn ? 'done' : ''}}">
        <view class="step-dot">{{wechatLoggedIn ? '✓' : '1'}}</view>
        <text class="step-text">微信登录</text>
      </view>
      <view class="step-line {{wechatLoggedIn ? 'done' : ''}}"></view>
      <view class="step">
        <view class="step-dot">2</view>
        <text class="step-text">授权手机号</text>
      </view>
    </view>

    <button class="btn-primary" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">手机号一键登录</button>
    <view class="login-alt">
      <text class="link" bindtap="login">{{loginBusy ? '登录中…' : '仅微信登录'}}</text>
      <text class="sep">·</text>
      <text class="link" bindtap="showSmsBind">短信验证码绑定</text>
    </view>

    <view wx:if="{{loginDebug || lastError}}" class="debug">
      <text wx:if="{{loginDebug}}" class="debug-line">{{loginDebug}}</text>
      <text wx:if="{{lastError}}" class="debug-error">{{lastError}}</text>
      <text class="debug-copy" bindtap="copyDiagnostics">复制诊断信息</text>
    </view>

    <view wx:if="{{smsBindVisible}}" class="sms">
      <view class="field">
        <text class="field-label">手机号</text>
        <input class="field-input" type="number" maxlength="11" value="{{smsPhone}}" bindinput="onSmsPhoneInput" placeholder="已开通 online 的手机号" />
      </view>
      <view class="field">
        <text class="field-label">验证码</text>
        <view class="field-code">
          <input class="field-input" type="number" maxlength="8" value="{{smsCode}}" bindinput="onSmsCodeInput" placeholder="短信验证码" />
          <button class="code-btn" disabled="{{smsSending || smsCountdown > 0}}" loading="{{smsSending}}" bindtap="sendSmsCode">{{smsCountdown > 0 ? smsCountdown + 's' : '获取验证码'}}</button>
        </view>
      </view>
      <button class="btn-primary" loading="{{smsBinding}}" bindtap="bindBySms">绑定并登录</button>
    </view>
  </view>

  <view class="assets-card">
    <text class="card-title">创作资产</text>
    <view class="asset-grid">
      <view class="asset" bindtap="goAvatarAssets" hover-class="press">
        <view class="asset-top"><text class="asset-title">形象管理</text><image class="caret-ic" src="/assets/icons/ic-caret.png" /></view>
        <text class="asset-sub">创建与管理数字人</text>
      </view>
      <view class="asset" bindtap="goVoiceAssets" hover-class="press">
        <view class="asset-top"><text class="asset-title">声音管理</text><image class="caret-ic" src="/assets/icons/ic-caret.png" /></view>
        <text class="asset-sub">创建与克隆 AI 声音</text>
      </view>
      <view class="asset" bindtap="goMediaAssets" hover-class="press">
        <view class="asset-top"><text class="asset-title">素材管理</text><image class="caret-ic" src="/assets/icons/ic-caret.png" /></view>
        <text class="asset-sub">素材 · 分组 · 标签</text>
      </view>
      <view class="asset" bindtap="goDownloads" hover-class="press">
        <view class="asset-top"><text class="asset-title">成片库</text><image class="caret-ic" src="/assets/icons/ic-caret.png" /></view>
        <text class="asset-sub">管理已生成的内容</text>
      </view>
    </view>
  </view>

  <view class="account-card">
    <text class="card-title">账号与安全</text>
    <view class="row" bindtap="onWechatRowTap" hover-class="press">
      <view class="row-ic ic-wechat"><image class="row-ic-img" src="/assets/icons/ic-wechat.png" /></view>
      <text class="row-label">微信登录</text>
      <view class="row-right">
        <text class="row-value {{wechatLoggedIn || phoneBound ? 'ok' : ''}}">{{wechatLoggedIn || phoneBound ? '已登录' : '未登录'}}</text>
        <image class="chevron-ic" src="/assets/icons/ic-caret.png" />
      </view>
    </view>
    <view class="row">
      <view class="row-ic ic-phone"><image class="row-ic-img" src="/assets/icons/ic-phone.png" /></view>
      <text class="row-label">绑定手机</text>
      <view class="row-right">
        <text class="row-value mono">{{phoneBound ? phone : '未绑定'}}</text>
        <button wx:if="{{!phoneBound}}" class="mini-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">绑定</button>
        <image wx:else class="chevron-ic" src="/assets/icons/ic-caret.png" />
      </view>
    </view>
    <view class="row" bindtap="copyDiagnostics" hover-class="press">
      <view class="row-ic ic-diag"><image class="row-ic-img" src="/assets/icons/ic-diag.png" /></view>
      <text class="row-label">诊断信息</text>
      <view class="row-right">
        <image class="copy-ic" src="/assets/icons/ic-copy.png" />
        <text class="row-value">复制</text>
        <image class="chevron-ic" src="/assets/icons/ic-caret.png" />
      </view>
    </view>
  </view>

  <view class="device-card">
    <view class="card-head">
      <text class="card-title">在线设备</text>
      <view class="mini-refresh" bindtap="loadDevices" hover-class="press"><image class="mini-refresh-ic" src="/assets/icons/ic-refresh.png" /><text>刷新</text></view>
    </view>
    <view class="device-state">
      <view class="online-dot {{onlineAvailable ? 'on' : ''}}"></view>
      <text>{{onlineAvailable ? '已连接 ' + onlineDevices.length + ' 台电脑端 online' : '暂未检测到电脑端 online'}}</text>
    </view>
    <view wx:for="{{onlineDevices}}" wx:key="installation_id" class="device-row">
      <view class="device-ic"><image class="device-ic-img" src="/assets/icons/ic-desktop.png" /></view>
      <view class="device-main">
        <text class="device-name">{{item.display_name || item.installation_id}}</text>
        <text class="device-time">{{item.last_seen_at}}</text>
      </view>
      <view class="device-pill {{item.online ? 'on' : ''}}">{{item.online ? '在线' : '离线'}}</view>
    </view>
    <view wx:if="{{onlineDevices.length === 0}}" class="device-empty">在电脑上启动 online 客户端后，设备会自动出现在这里</view>
  </view>

  <view class="footer">
    <text class="dev-id">DEV_ID: {{deviceId}}</text>
    <button class="logout" bindtap="logout" hover-class="press">退出登录</button>
    <text class="foot-brand">必火 AI · 让创意落地</text>
  </view>
</view>
