<view class="page">
  <view class="hero">
    <view class="hero-row">
      <view class="avatar">{{avatarText}}</view>
      <view class="hero-main">
        <text class="hero-name">{{phoneBound ? phone : (wechatLoggedIn ? '已微信登录' : '未绑定手机号')}}</text>
        <text class="hero-sub">{{phoneBound ? '已关联 online 账号' : (wechatLoggedIn ? '请继续授权手机号' : '授权手机号后关联电脑端')}}</text>
      </view>
      <view wx:if="{{phoneBound}}" class="hero-badge">已绑定</view>
    </view>
    <view class="wallet">
      <view class="wallet-left">
        <text class="wallet-label">算力余额</text>
        <text class="wallet-value">{{creditsText}}</text>
      </view>
      <view class="wallet-btn" bindtap="goRecharge">充值</view>
    </view>
  </view>

  <view class="quick-grid">
    <view class="quick" bindtap="goIpProfile">
      <view class="quick-icon">IP</view>
      <text class="quick-name">个人IP设置</text>
    </view>
    <view class="quick" bindtap="goDownloads">
      <view class="quick-icon">作</view>
      <text class="quick-name">我的作品</text>
    </view>
    <view class="quick" bindtap="goRecharge">
      <view class="quick-icon">充</view>
      <text class="quick-name">充值算力</text>
    </view>
    <view class="quick" bindtap="loadDevices">
      <view class="quick-icon">备</view>
      <text class="quick-name">刷新设备</text>
    </view>
  </view>

  <view wx:if="{{!phoneBound}}" class="card bind-card">
    <text class="card-title">账号绑定</text>
    <text class="card-desc">绑定手机号后，手机端才能找到你的电脑端 online，并下发 AI 员工、数字人和素材任务。</text>
    <view wx:if="{{wechatLoggedIn}}" class="bind-state">
      <view class="dot ok"></view>
      <text>微信登录已完成，请继续授权手机号。</text>
    </view>
    <view class="bind-actions">
      <button class="btn-ghost" loading="{{loginBusy}}" disabled="{{loginBusy}}" bindtap="login">{{wechatLoggedIn ? '重新登录' : '微信登录'}}</button>
      <button class="btn-primary" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">授权手机号</button>
    </view>
    <view wx:if="{{loginDebug || lastError}}" class="debug-box">
      <text wx:if="{{loginDebug}}" class="debug-line">{{loginDebug}}</text>
      <text wx:if="{{lastError}}" class="debug-error">{{lastError}}</text>
      <button class="debug-copy" bindtap="copyDiagnostics">复制诊断信息</button>
    </view>
    <text class="sms-link" bindtap="showSmsBind">微信取号失败，用短信验证码绑定</text>
    <view wx:if="{{smsBindVisible}}" class="sms-bind-box">
      <input class="input" type="number" maxlength="11" value="{{smsPhone}}" bindinput="onSmsPhoneInput" placeholder="输入已开通 online 的手机号" />
      <view class="sms-code-row">
        <input class="input" type="number" maxlength="8" value="{{smsCode}}" bindinput="onSmsCodeInput" placeholder="短信验证码" />
        <button class="btn-ghost sms-code-btn" disabled="{{smsSending || smsCountdown > 0}}" loading="{{smsSending}}" bindtap="sendSmsCode">{{smsCountdown > 0 ? smsCountdown + 's' : '获取'}}</button>
      </view>
      <button class="btn-primary sms-submit" loading="{{smsBinding}}" bindtap="bindBySms">绑定手机号</button>
    </view>
  </view>

  <view class="card">
    <view class="card-head">
      <text class="card-title">在线设备</text>
      <text class="card-link" bindtap="loadDevices">刷新</text>
    </view>
    <view class="device-state">
      <view class="dot {{onlineAvailable ? 'ok' : 'warn'}}"></view>
      <text>{{onlineAvailable ? '检测到 online 设备' : '暂未检测到 online 设备'}}</text>
    </view>
    <view wx:for="{{onlineDevices}}" wx:key="installation_id" class="device-row">
      <view class="device-dot {{item.online ? 'on' : ''}}"></view>
      <view class="device-info">
        <text class="device-name">{{item.display_name || item.installation_id}}</text>
        <text class="device-time">{{item.online ? '在线' : '离线'}} · {{item.last_seen_at}}</text>
      </view>
    </view>
    <view wx:if="{{onlineDevices.length === 0}}" class="empty-line">当前没有在线的电脑端 online。</view>
  </view>

  <view class="footer">
    <text class="device-id">当前手机：{{deviceId}}</text>
    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>
</view>
