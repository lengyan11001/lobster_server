.page { padding: 24rpx 24rpx 60rpx; background: #f5f7fb; min-height: 100vh; box-sizing: border-box; }

.hero { background: linear-gradient(135deg, #06b6d4, #2563eb); border-radius: 24rpx; padding: 28rpx; color: #fff; box-shadow: 0 12rpx 30rpx rgba(37,99,235,.18); }
.hero-row { display: flex; align-items: center; }
.avatar { width: 92rpx; height: 92rpx; border-radius: 28rpx; background: rgba(255,255,255,.22); font-size: 36rpx; font-weight: 700; text-align: center; line-height: 92rpx; margin-right: 20rpx; }
.hero-main { flex: 1; }
.hero-name { display: block; font-size: 32rpx; font-weight: 700; }
.hero-sub { display: block; margin-top: 6rpx; font-size: 21rpx; opacity: .85; }
.hero-badge { font-size: 20rpx; padding: 6rpx 16rpx; border-radius: 99rpx; background: rgba(255,255,255,.22); }

.wallet { margin-top: 26rpx; padding-top: 22rpx; border-top: 1rpx solid rgba(255,255,255,.25); display: flex; align-items: center; justify-content: space-between; }
.wallet-label { display: block; font-size: 21rpx; opacity: .85; }
.wallet-value { display: block; margin-top: 6rpx; font-size: 46rpx; font-weight: 700; }
.wallet-btn { padding: 12rpx 34rpx; border-radius: 99rpx; background: #fff; color: #1d4ed8; font-size: 25rpx; font-weight: 600; }

.quick-grid { display: flex; flex-wrap: wrap; margin-top: 18rpx; }
.quick { width: 25%; display: flex; flex-direction: column; align-items: center; padding: 12rpx 0; }
.quick-icon { width: 76rpx; height: 76rpx; border-radius: 22rpx; background: #fff; border: 1rpx solid #eef2f7; color: #0891b2; font-size: 24rpx; text-align: center; line-height: 76rpx; box-shadow: 0 3rpx 10rpx rgba(15,23,42,.04); }
.quick-name { margin-top: 10rpx; font-size: 21rpx; color: #475569; }

.card { background: #fff; border-radius: 20rpx; padding: 24rpx; margin-top: 18rpx; border: 1rpx solid #eef2f7; box-shadow: 0 3rpx 12rpx rgba(15,23,42,.03); }
.card-head { display: flex; align-items: center; justify-content: space-between; }
.card-title { font-size: 28rpx; font-weight: 600; color: #0f172a; }
.card-link { font-size: 22rpx; color: #06b6d4; }
.card-desc { display: block; margin-top: 10rpx; font-size: 22rpx; line-height: 1.6; color: #64748b; }

.device-state { display: flex; align-items: center; margin-top: 14rpx; font-size: 22rpx; color: #64748b; }
.device-row { display: flex; align-items: center; padding: 14rpx 0; border-bottom: 1rpx solid #f1f5f9; }
.device-row:last-child { border-bottom: none; }
.device-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #cbd5e1; margin-right: 14rpx; }
.device-dot.on { background: #22c55e; }
.device-info { flex: 1; }
.device-name { display: block; font-size: 25rpx; color: #0f172a; }
.device-time { display: block; margin-top: 4rpx; font-size: 20rpx; color: #94a3b8; }
.empty-line { display: block; margin-top: 14rpx; font-size: 22rpx; color: #94a3b8; }
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #cbd5e1; margin-right: 10rpx; }
.dot.ok { background: #22c55e; }
.dot.warn { background: #f59e0b; }

.bind-actions { display: flex; margin-top: 18rpx; }
.btn-ghost, .btn-primary { flex: 1; height: 80rpx; line-height: 80rpx; font-size: 26rpx; border-radius: 14rpx; text-align: center; }
.btn-ghost { margin-right: 14rpx; background: #f1f5f9; color: #334155; }
.btn-primary { background: linear-gradient(135deg, #06b6d4, #2563eb); color: #fff; }
.bind-state { display: flex; align-items: center; margin-top: 14rpx; font-size: 22rpx; color: #059669; }
.debug-box { margin-top: 14rpx; padding: 16rpx; background: #f8fafc; border-radius: 12rpx; }
.debug-line, .debug-error { display: block; font-size: 20rpx; color: #64748b; word-break: break-all; }
.debug-error { color: #dc2626; margin-top: 6rpx; }
.debug-copy { margin-top: 10rpx; font-size: 20rpx; color: #2563eb; text-align: left; background: transparent; padding: 0; line-height: 1.4; }
.sms-link { display: block; margin-top: 16rpx; font-size: 22rpx; color: #64748b; }
.sms-bind-box { margin-top: 14rpx; }
.input { width: 100%; height: 76rpx; background: #f8fafc; border-radius: 12rpx; padding: 0 18rpx; font-size: 24rpx; margin-bottom: 12rpx; box-sizing: border-box; }
.sms-code-row { display: flex; }
.sms-code-row .input { flex: 1; margin-right: 12rpx; margin-bottom: 0; }
.sms-code-btn { flex: none; width: 180rpx; height: 76rpx; line-height: 76rpx; margin: 0; }
.sms-submit { margin-top: 14rpx; }

.footer { margin-top: 24rpx; text-align: center; }
.device-id { display: block; font-size: 19rpx; color: #b6c1d2; word-break: break-all; }
.logout-btn { margin-top: 18rpx; width: 100%; height: 80rpx; line-height: 80rpx; font-size: 26rpx; color: #ef4444; background: #fff; border: 1rpx solid #fee2e2; border-radius: 14rpx; }
