.page { min-height: 100vh; padding: 28rpx; background: #f3f6fb; }
.head { padding: 12rpx 4rpx 8rpx; }
.head-row { display: flex; align-items: center; justify-content: space-between; }
.title { display: block; font-size: 42rpx; font-weight: 700; }
.sub { display: block; margin-top: 6rpx; font-size: 24rpx; color: #64748b; }
.primary.small { margin: 0; height: 64rpx; line-height: 64rpx; padding: 0 26rpx; font-size: 24rpx; color: #fff; background: #2563eb; border-radius: 999rpx; }
.quick-row { margin-top: 18rpx; }
.quick { font-size: 26rpx; color: #2563eb; }
.tabs { display: flex; gap: 12rpx; padding: 20rpx 0; }
.tab { padding: 12rpx 24rpx; font-size: 26rpx; color: #475569; background: #fff; border-radius: 999rpx; }
.tab.active { color: #fff; background: #2563eb; }
.card { padding: 24rpx; margin-bottom: 18rpx; background: #fff; border-radius: 20rpx; }
.card-top { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.card-title { flex: 1; font-size: 28rpx; font-weight: 600; color: #0f172a; }
.chip { padding: 6rpx 16rpx; font-size: 20rpx; border-radius: 999rpx; color: #64748b; background: #f1f5f9; }
.chip.completed { color: #16a34a; background: #ecfdf5; }
.chip.failed { color: #dc2626; background: #fef2f2; }
.chip.processing { color: #d97706; background: #fffbeb; }
.card-summary { display: block; margin-top: 12rpx; font-size: 24rpx; color: #475569; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.card-meta { display: block; margin-top: 12rpx; font-size: 22rpx; color: #94a3b8; }
.empty { padding: 48rpx; text-align: center; font-size: 24rpx; color: #94a3b8; }
.more { padding-top: 8rpx; }
.ghost { height: 76rpx; line-height: 76rpx; font-size: 26rpx; color: #2563eb; background: #eff6ff; border-radius: 16rpx; }
.device-card { margin: 0 0 20rpx; padding: 24rpx; background: #fff; border-radius: 20rpx; box-shadow: 0 10rpx 24rpx rgba(15,23,42,0.06); }
.device-head { display: flex; align-items: center; justify-content: space-between; }
.device-info { flex: 1; min-width: 0; }
.device-status { display: block; font-size: 28rpx; font-weight: 600; color: #64748b; }
.device-status.on { color: #0f172a; }
.device-meta { display: block; margin-top: 6rpx; font-size: 22rpx; color: #94a3b8; }
.device-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #ef4444; animation: devPulse 1.2s infinite; }
@keyframes devPulse { 0%,100% { opacity: .35 } 50% { opacity: 1 } }
.device-actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.ghost.mini { margin-top: 0; height: 60rpx; line-height: 60rpx; padding: 0 22rpx; font-size: 24rpx; }
.ghost.mini.danger { color: #dc2626; background: #fef2f2; }

.device-sync { display: block; margin-top: 12rpx; font-size: 22rpx; color: #2563eb; }

.head-actions { display: flex; align-items: center; gap: 16rpx; }
.diag-link { font-size: 24rpx; color: #2563eb; }
.diag-panel { margin-top: 16rpx; padding: 16rpx; background: #0f172a; border-radius: 14rpx; }
.diag-head { display: flex; align-items: center; justify-content: space-between; }
.diag-title { font-size: 22rpx; color: #cbd5e1; }
.diag-id { font-size: 20rpx; color: #93c5fd; }
.diag-body { max-height: 360rpx; margin-top: 10rpx; }
.diag-line { display: block; font-size: 20rpx; line-height: 1.5; color: #e2e8f0; word-break: break-all; }
.diag-actions { display: flex; gap: 12rpx; margin-top: 12rpx; }
.diag-actions .ghost.mini { color: #bfdbfe; background: rgba(37,99,235,0.18); }

.device-files { margin-top: 18rpx; padding-top: 18rpx; border-top: 1px solid #f1f5f9; }
.device-files-title { display: block; font-size: 22rpx; color: #94a3b8; margin-bottom: 10rpx; }
.device-file { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 14rpx 0; border-bottom: 1px solid #f8fafc; }
.device-file-main { flex: 1; min-width: 0; }
.device-file-name { display: block; font-size: 26rpx; color: #0f172a; word-break: break-all; }
.device-file-meta { display: block; margin-top: 4rpx; font-size: 20rpx; color: #94a3b8; }
.device-file-actions { display: flex; gap: 10rpx; flex: none; }
