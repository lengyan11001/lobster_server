<view class="page">
  <view class="head">
    <view class="head-row">
      <view>
        <text class="title">AI秘书</text>
        <text class="sub">录音转写、要点摘要，随时回看</text>
      </view>
      <view class="head-actions">
        <text class="diag-link" bindtap="toggleDiag">诊断</text>
        <button class="primary small" bindtap="upload">上传录音</button>
      </view>
    </view>
  </view>

  <view class="device-card">
    <view class="device-head">
      <view class="device-info">
        <text class="device-status {{device.connected ? 'on' : ''}}">
          {{device.connected ? (device.isRecording ? (device.isPaused ? '录音已暂停' : '正在录音') + ' · ' + device.timeText : '已连接 ' + device.name) : '尚未连接录音设备'}}
        </text>
        <text wx:if="{{device.connected}}" class="device-meta">
          {{device.name}}<text wx:if="{{device.battery !== null}}"> · 电量 {{device.battery}}%</text><text wx:if="{{device.isCharging}}"> · 充电中</text>
        </text>
        <text wx:else class="device-meta">连接后可在小程序里手动开始/暂停/停止录音</text>
      </view>
      <text wx:if="{{device.isRecording}}" class="device-dot"></text>
    </view>
    <view class="device-actions">
      <button class="ghost mini" bindtap="goDevices">{{device.connected ? '更换设备' : '连接设备'}}</button>
      <button class="ghost mini" wx:if="{{device.connected && !device.isRecording}}" bindtap="startRecording">开始录音</button>
      <button class="ghost mini" wx:if="{{device.isRecording}}" bindtap="togglePause">{{device.isPaused ? '继续录音' : '暂停录音'}}</button>
      <button class="ghost mini danger" wx:if="{{device.isRecording}}" bindtap="stopRecording">停止录音</button>
      <button class="ghost mini" wx:if="{{device.connected && !device.isRecording}}" bindtap="refreshDeviceFiles">刷新设备文件</button>
      <button class="ghost mini danger" wx:if="{{syncing}}" bindtap="stopSync">停止同步</button>
    </view>
    <text wx:if="{{syncText}}" class="device-sync">{{syncText}}</text>
    <view wx:if="{{diagOpen}}" class="diag-panel">
      <view class="diag-head">
        <text class="diag-title">设备诊断（{{diagLines.length}} 条）</text>
        <text wx:if="{{diagId}}" class="diag-id">{{diagId}}</text>
      </view>
      <scroll-view class="diag-body" scroll-y>
        <text wx:for="{{diagLines}}" wx:key="*this" class="diag-line">{{item}}</text>
        <text wx:if="{{!diagLines.length}}" class="diag-line">还没有日志</text>
      </scroll-view>
      <view class="diag-actions">
        <button class="ghost mini" bindtap="copyDiag">复制</button>
        <button class="ghost mini" bindtap="uploadDiag">上传诊断</button>
      </view>
    </view>
  </view>

  <view class="tabs">
    <view wx:for="{{tabs}}" wx:key="key" class="tab {{tabIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="switchTab">{{item.label}}</view>
  </view>

  <view wx:if="{{loading && !items.length}}" class="empty">加载中…</view>
  <view wx:elif="{{!items.length}}" class="empty">还没有录音记录</view>

  <view wx:for="{{items}}" wx:key="id" class="card" data-index="{{index}}" bindtap="openDetail">
    <view class="card-main">
      <view class="card-top">
        <text class="card-title">{{item.name}}</text>
        <text class="chip {{item.status}}">{{item.statusText}}</text>
      </view>
      <text wx:if="{{item.summary}}" class="card-summary">{{item.summary}}</text>
      <text class="card-meta">{{item.sourceLabel}} · {{item.time}}</text>
    </view>
  </view>

  <view wx:if="{{items.length}}" class="more">
    <button class="ghost" loading="{{loading}}" bindtap="loadMore">{{hasMore ? '加载更多' : '没有更多了'}}</button>
  </view>
</view>