<view class="page">
  <view class="head">
    <view class="head-row">
      <view>
        <text class="title">AI秘书</text>
        <text class="sub">录音转写、要点摘要，随时回看</text>
      </view>
      <view class="head-actions">
        <text class="diag-link" bindtap="toggleDiag">诊断</text>
        <button class="primary small" bindtap="upload">上传录音</button>
      </view>
    </view>
  </view>

  <view class="tabs">
    <view wx:for="{{tabs}}" wx:key="key" class="tab {{tabIndex === index ? 'active' : ''}}" data-index="{{index}}" bindtap="switchTab">{{item.label}}</view>
  </view>

  <view class="device-card" wx:if="{{tabIndex === 1}}">
    <view class="device-head">
      <view class="device-info">
        <text class="device-status {{device.connected ? 'on' : ''}}">
          {{device.connected ? (device.isRecording ? (device.isPaused ? '录音已暂停' : '正在录音') + ' · ' + device.timeText : '已连接 ' + device.name) : (autoConnecting ? '正在连接上次设备…' : '尚未连接录音设备')}}
        </text>
        <text wx:if="{{device.connected}}" class="device-meta">
          {{device.name}}<text wx:if="{{device.battery !== null}}"> · 电量 {{device.battery}}%</text><text wx:if="{{device.storageText}}"> · 存储 {{device.storageText}}</text><text wx:if="{{device.isCharging}}"> · 充电中</text>
        </text>
        <text wx:else class="device-meta">连接后可在小程序里手动开始/暂停/停止录音</text>
        <view wx:if="{{autoConnecting}}" class="auto-bar">
          <text class="auto-text">上次设备：{{autoConnectName}}</text>
          <text class="auto-cancel" bindtap="cancelAutoConnect">取消</text>
        </view>
      </view>
      <text wx:if="{{device.isRecording}}" class="device-dot"></text>
    </view>
    <view class="device-actions">
      <button class="ghost mini" bindtap="goDevices">{{device.connected ? '更换设备' : '连接设备'}}</button>
      <button class="ghost mini" wx:if="{{!device.connected && hasLastDevice && !autoConnecting}}" bindtap="retryLastDevice">连接上次设备</button>
      <button class="ghost mini" wx:if="{{device.connected && !device.isRecording}}" bindtap="startRecording">开始录音</button>
      <button class="ghost mini" wx:if="{{device.isRecording}}" bindtap="togglePause">{{device.isPaused ? '继续录音' : '暂停录音'}}</button>
      <button class="ghost mini danger" wx:if="{{device.isRecording}}" bindtap="stopRecording">停止录音</button>
      <button class="ghost mini" wx:if="{{device.connected}}" bindtap="togglePowerOnRecord">{{powerOnRecord === null ? '开机自动录音：读取中' : (powerOnRecord ? '开机自动录音：开' : '开机自动录音：关')}}</button>
      <button class="ghost mini" wx:if="{{device.connected}}" bindtap="toggleUsbMode">{{usbSwitch === null ? 'USB模式：读取中' : (usbSwitch ? 'USB模式：开' : 'USB模式：关')}}</button>
      <button class="ghost mini" wx:if="{{device.connected && !device.isRecording}}" bindtap="refreshDeviceFiles">刷新设备文件</button>
      <button class="ghost mini danger" wx:if="{{syncing}}" bindtap="stopSync">停止同步</button>
    </view>
    <text wx:if="{{usbSwitch === true}}" class="device-warn">USB 模式开着时设备会把存储交给电脑，录音可能写不进去、文件列表也可能为空。要先录音请切到「USB模式：关」。</text>
    <text wx:if="{{formatting}}" class="device-warn">正在格式化设备存储，请勿录音或断开…</text>
    <text wx:if="{{device.isRecording && powerOnRecord === false}}" class="device-warn">设备端已开始录音（不是小程序发起的），点「停止录音」结束；开机自动录音开关只控制下次开机。</text>
    <text wx:if="{{syncText}}" class="device-sync">{{syncText}}</text>
  </view>

    <view wx:if="{{diagOpen}}" class="diag-panel">
      <view class="diag-head">
        <text class="diag-title">设备诊断（{{diagLines.length}} 条）</text>
        <text wx:if="{{diagId}}" class="diag-id">{{diagId}}</text>
      </view>
      <scroll-view class="diag-body" scroll-y>
        <text wx:for="{{diagLines}}" wx:key="*this" class="diag-line">{{item}}</text>
        <text wx:if="{{!diagLines.length}}" class="diag-line">还没有日志</text>
      </scroll-view>
      <view class="diag-actions">
        <button class="ghost mini" bindtap="copyDiag">复制</button>
        <button class="ghost mini" bindtap="uploadDiag">上传诊断</button>
      </view>
    </view>

  <view wx:if="{{loading && !listRows.length}}" class="empty">加载中…</view>
  <view wx:elif="{{!listRows.length}}" class="empty">{{tabIndex === 1 ? '还没有设备录音，连接设备后可读取' : '还没有录音记录'}}</view>

  <view wx:for="{{listRows}}" wx:key="key" class="card" data-index="{{index}}" bindtap="openRow">
    <view class="card-main">
      <view class="card-top">
        <text class="card-title">{{item.name}}</text>
        <text class="chip {{item.status || (item.synced ? 'completed' : 'pending')}}">{{item.statusText}}</text>
      </view>
      <text wx:if="{{item.summary}}" class="card-summary">{{item.summary}}</text>
      <text wx:if="{{item.errorText}}" class="card-error">{{item.errorText}}</text>
      <text class="card-meta">{{item.meta}}</text>
      <view wx:if="{{item.kind === 'device'}}" class="device-row-actions">
        <button wx:if="{{!item.synced}}" class="ghost mini" catchtap="syncDeviceFile" data-name="{{item.fileName}}">同步</button>
        <button wx:if="{{item.synced && item.recordId}}" class="ghost mini" catchtap="openRow" data-index="{{index}}">查看</button>
        <button class="ghost mini danger" catchtap="deleteDeviceFile" data-name="{{item.fileName}}">删除</button>
      </view>
    </view>
  </view>

  <view wx:if="{{items.length}}" class="more">
    <button class="ghost" loading="{{loading}}" bindtap="loadMore">{{hasMore ? '加载更多' : '没有更多了'}}</button>
  </view>
</view>