page { background: #f6f8fc; color: #0f172a; }

.works { min-height: 100vh; padding: 24rpx 24rpx 40rpx; background: #f6f8fc; box-sizing: border-box; }

.head { display: flex; align-items: center; justify-content: space-between; padding: 8rpx 4rpx 20rpx; }
.head-copy { display: flex; flex-direction: column; }
.title { color: #0f172a; font-size: 42rpx; font-weight: 800; letter-spacing: 1rpx; }
.sub { margin-top: 8rpx; color: #8a97a8; font-size: 22rpx; }
.refresh {
  display: flex; align-items: center; height: 64rpx; padding: 0 22rpx;
  background: #fff; border: 1rpx solid #e8eef6; border-radius: 999rpx;
  color: #2563eb; font-size: 22rpx;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.04);
}
.refresh-ic { margin-right: 6rpx; font-size: 26rpx; }

.tabs { width: 100%; white-space: nowrap; }
.tab {
  display: inline-flex; align-items: center; justify-content: center;
  height: 62rpx; padding: 0 28rpx; margin-right: 14rpx;
  background: #fff; border: 1rpx solid #e8eef6; border-radius: 999rpx;
  color: #64748b; font-size: 24rpx;
}
.tab.active {
  background: linear-gradient(135deg, #06b6d4, #2563eb);
  border-color: transparent; color: #fff; font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.22);
}

.login-card {
  margin-top: 24rpx; padding: 44rpx 32rpx;
  background: #fff; border: 1rpx solid #eef2f7; border-radius: 26rpx;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.04);
  display: flex; flex-direction: column; align-items: center; text-align: center;
}
.login-title { color: #0f172a; font-size: 32rpx; font-weight: 700; }
.login-desc { margin-top: 12rpx; color: #8a97a8; font-size: 23rpx; line-height: 1.6; }
.login-btn {
  margin-top: 28rpx; width: 320rpx; height: 80rpx; line-height: 80rpx;
  border-radius: 999rpx; color: #fff; font-size: 26rpx; font-weight: 600;
  background: linear-gradient(135deg, #06b6d4, #2563eb);
  box-shadow: 0 8rpx 20rpx rgba(37, 99, 235, 0.24);
}

.skeleton { margin-top: 22rpx; }
.sk-row { display: flex; padding: 20rpx; margin-bottom: 18rpx; background: #fff; border-radius: 24rpx; border: 1rpx solid #eef2f7; }
.sk-thumb { width: 170rpx; height: 170rpx; border-radius: 18rpx; background: #eef2f7; }
.sk-lines { flex: 1; margin-left: 20rpx; padding-top: 8rpx; }
.sk-line { height: 22rpx; margin-bottom: 16rpx; border-radius: 8rpx; background: #eef2f7; }
.sk-line.w40 { width: 40%; }
.sk-line.w65 { width: 65%; }
.sk-line.w85 { width: 85%; }

.empty { margin-top: 60rpx; display: flex; flex-direction: column; align-items: center; }
.empty-ic {
  width: 132rpx; height: 132rpx; border-radius: 40rpx;
  background: linear-gradient(135deg, #e0f2fe, #eef2ff);
  color: #38bdf8; font-size: 52rpx; text-align: center; line-height: 132rpx;
}
.empty-title { margin-top: 26rpx; color: #0f172a; font-size: 30rpx; font-weight: 600; }
.empty-desc { margin-top: 10rpx; padding: 0 40rpx; color: #94a3b8; font-size: 22rpx; line-height: 1.6; text-align: center; }
.empty-btn {
  margin-top: 30rpx; width: 280rpx; height: 78rpx; line-height: 78rpx;
  border-radius: 999rpx; background: #eff6ff; color: #1d4ed8; font-size: 26rpx;
}

.list { margin-top: 22rpx; }
.item {
  display: flex; padding: 18rpx; margin-bottom: 18rpx;
  background: #fff; border: 1rpx solid #eef2f7; border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
}
.thumb { position: relative; width: 176rpx; height: 176rpx; flex: none; border-radius: 18rpx; overflow: hidden; background: #eef2f7; }
.thumb-img { width: 100%; height: 100%; }
.thumb-empty {
  width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 26rpx; font-weight: 600;
}
.thumb-empty.kind-video { background: linear-gradient(135deg, #60a5fa, #2563eb); }
.thumb-empty.kind-image { background: linear-gradient(135deg, #34d399, #059669); }
.thumb-empty.kind-article { background: linear-gradient(135deg, #93c5fd, #4f46e5); }
.thumb-empty.kind-wechat_article { background: linear-gradient(135deg, #93c5fd, #4f46e5); }
.thumb-empty.kind-ppt { background: linear-gradient(135deg, #fbbf24, #d97706); }
.thumb-empty.kind-audio { background: linear-gradient(135deg, #c4b5fd, #7c3aed); }
.play {
  position: absolute; right: 10rpx; bottom: 10rpx; width: 48rpx; height: 48rpx;
  border-radius: 50%; background: rgba(15, 23, 42, 0.55);
  display: flex; align-items: center; justify-content: center;
}
.play text { color: #fff; font-size: 18rpx; margin-left: 2rpx; }

.body { flex: 1; min-width: 0; margin-left: 20rpx; display: flex; flex-direction: column; }
.line { display: flex; align-items: center; justify-content: space-between; }
.chip { padding: 4rpx 14rpx; border-radius: 8rpx; font-size: 19rpx; }
.chip.kind-video { background: #e0f2fe; color: #0369a1; }
.chip.kind-image { background: #ecfdf5; color: #047857; }
.chip.kind-article { background: #eff6ff; color: #1d4ed8; }
.chip.kind-wechat_article { background: #eff6ff; color: #1d4ed8; }
.chip.kind-ppt { background: #fef3c7; color: #b45309; }
.chip.kind-audio { background: #f5f3ff; color: #6d28d9; }
.time { color: #b6c1d2; font-size: 19rpx; }
.item-title {
  margin-top: 12rpx; color: #0f172a; font-size: 27rpx; font-weight: 600; line-height: 1.4;
  overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
}
.item-summary {
  margin-top: 8rpx; color: #8a97a8; font-size: 21rpx; line-height: 1.5;
  overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
}

.more { padding: 12rpx 0 20rpx; }
.more-btn { height: 78rpx; line-height: 78rpx; border-radius: 999rpx; background: #fff; border: 1rpx solid #e8eef6; color: #2563eb; font-size: 24rpx; }

.overlay { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 99; display: flex; align-items: flex-end; background: rgba(15, 23, 42, 0.48); }
.sheet { width: 100%; max-height: 88vh; padding: 18rpx 28rpx 28rpx; background: #fff; border-radius: 30rpx 30rpx 0 0; display: flex; flex-direction: column; }
.sheet-grip { width: 72rpx; height: 8rpx; margin: 0 auto 18rpx; border-radius: 999rpx; background: #e2e8f0; }
.sheet-head { display: flex; align-items: flex-start; justify-content: space-between; }
.sheet-head-main { flex: 1; min-width: 0; margin-right: 18rpx; }
.sheet-line { display: flex; align-items: center; }
.sheet-time { margin-left: 14rpx; color: #b6c1d2; font-size: 20rpx; }
.sheet-title { display: block; margin-top: 10rpx; color: #0f172a; font-size: 32rpx; font-weight: 700; line-height: 1.4; }
.sheet-close { width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center; border-radius: 50%; background: #f1f5f9; color: #64748b; font-size: 24rpx; }
.sheet-body { max-height: 58vh; margin-top: 18rpx; }
.sheet-video { width: 100%; height: 420rpx; border-radius: 18rpx; background: #0f172a; }
.sheet-image { width: 100%; margin-top: 16rpx; border-radius: 18rpx; }
.sheet-content { display: block; margin-top: 18rpx; color: #334155; font-size: 26rpx; line-height: 1.8; white-space: pre-wrap; }
.sheet-actions { display: flex; margin-top: 24rpx; }
.act { flex: 1; height: 80rpx; line-height: 80rpx; margin: 0 8rpx; border-radius: 16rpx; font-size: 25rpx; }
.act.ghost { background: #f1f5f9; color: #334155; }
.act.primary { background: linear-gradient(135deg, #06b6d4, #2563eb); color: #fff; }
.act.danger { background: #fef2f2; color: #dc2626; }

.tap { opacity: 0.72; }
