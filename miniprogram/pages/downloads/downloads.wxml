<view class="works">
  <view class="top-bg">
    <image class="top-bg-img" src="/assets/design/works-top.jpg" mode="aspectFill" />
    <view class="top-bg-mask"></view>
  </view>

  <view class="top-actions">
    <view class="refresh" bindtap="refresh" hover-class="press">
      <text class="refresh-ic">↻</text>
      <text>刷新</text>
    </view>
  </view>

  <view class="head">
    <text class="title">作 品</text>
    <text class="sub">内容记录 · 全部生成结果</text>
  </view>

  <scroll-view class="tabs" scroll-x enhanced show-scrollbar="{{false}}">
    <view wx:for="{{tabs}}" wx:key="key" class="tab {{tab === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="switchTab">{{item.label}}</view>
  </scroll-view>

  <view wx:if="{{!phoneBound}}" class="login-card">
    <text class="login-title">登录后查看作品</text>
    <text class="login-desc">内容记录跟随账号，换手机也能继续查看和下载。</text>
    <button class="login-btn" bindtap="goLogin">去登录</button>
  </view>

  <block wx:else>
    <view wx:if="{{loading && items.length === 0}}" class="skeleton">
      <view wx:for="{{skeletons}}" wx:key="*this" class="sk-row">
        <view class="sk-thumb"></view>
        <view class="sk-lines">
          <view class="sk-line w40"></view>
          <view class="sk-line w85"></view>
          <view class="sk-line w65"></view>
        </view>
      </view>
    </view>

    <view wx:elif="{{items.length === 0}}" class="empty">
      <view class="empty-ic">▤</view>
      <text class="empty-title">还没有内容记录</text>
      <text class="empty-desc">在首页创作的数字人、图片、文章会自动汇总到这里</text>
      <button class="empty-btn" bindtap="goCreate">去创作</button>
    </view>

    <view wx:else class="list">
      <view wx:for="{{items}}" wx:key="key" class="work-card" data-index="{{index}}" bindtap="openDetail" hover-class="press">
        <image class="card-bg" src="/assets/design/works-card-bg.jpg" mode="aspectFill" />
        <view class="card-shade"></view>
        <view class="card-body">
          <view class="thumb">
            <image wx:if="{{item.thumb}}" class="thumb-img" src="{{item.thumb}}" mode="aspectFill" />
            <view wx:else class="thumb-empty kind-{{item.kind}}">{{item.kindLabel}}</view>
            <view wx:if="{{item.isVideo}}" class="play"><text>▶</text></view>
          </view>
          <view class="card-main">
            <view class="card-top">
              <text class="chip kind-{{item.kind}}">{{item.kindLabel}}</text>
              <text class="time">{{item.time}}</text>
            </view>
            <text class="card-title">{{item.title}}</text>
            <text class="card-summary">{{item.summary || item.kindLabel + '内容'}}</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{items.length}}" class="more">
      <button class="more-btn" loading="{{loadingMore}}" bindtap="loadMore">{{hasMore ? '加载更多' : '没有更多了'}}</button>
    </view>
  </block>

  <view wx:if="{{detail}}" class="overlay" catchtap="closeDetail">
    <view class="sheet" catchtap="noop">
      <view class="sheet-grip"></view>
      <view class="sheet-head">
        <view class="sheet-head-main">
          <view class="sheet-line">
            <text class="chip kind-{{detail.kind}}">{{detail.kindLabel}}</text>
            <text class="sheet-time">{{detail.time}}</text>
          </view>
          <text class="sheet-title">{{detail.title}}</text>
        </view>
        <text class="sheet-close" catchtap="closeDetail">✕</text>
      </view>

      <scroll-view class="sheet-body" scroll-y>
        <video wx:if="{{detail.videoUrl}}" class="sheet-video" src="{{detail.videoUrl}}" controls object-fit="contain"></video>
        <image wx:for="{{detail.images}}" wx:key="*this" class="sheet-image" src="{{item}}" mode="widthFix" data-url="{{item}}" bindtap="previewImage" />
        <text wx:if="{{detail.content}}" class="sheet-content" user-select="{{true}}">{{detail.content}}</text>
      </scroll-view>

      <view class="sheet-actions">
        <button class="act ghost" bindtap="copyContent">复制文字</button>
        <button wx:if="{{detail.saveable}}" class="act primary" bindtap="saveDetail">保存</button>
        <button class="act danger" bindtap="deleteDetail">删除</button>
      </view>
    </view>
  </view>
</view>
