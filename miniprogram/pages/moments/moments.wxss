.page { padding: 24rpx; }
.head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.title { display: block; font-size: 38rpx; font-weight: 600; color: #0f172a; }
.sub { display: block; margin-top: 6rpx; font-size: 22rpx; color: #64748b; }
.empty { padding: 120rpx 0; text-align: center; color: #64748b; font-size: 26rpx; }
.card { background: #fff; border-radius: 18rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 10rpx rgba(15,23,42,.05); }
.card-top { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.card-title { flex: 1; font-size: 28rpx; color: #0f172a; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.card-meta { display: block; margin-top: 12rpx; font-size: 22rpx; color: #64748b; }
.chip { font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 999rpx; background: #ecfdf5; color: #059669; }
.primary.small { margin: 0; font-size: 24rpx; padding: 0 22rpx; height: 60rpx; line-height: 60rpx; border-radius: 999rpx; }

.overlay { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(15,23,42,.45); display: flex; align-items: flex-end; z-index: 99; }
.sheet { width: 100%; background: #fff; border-radius: 24rpx 24rpx 0 0; padding: 28rpx 28rpx 40rpx; max-height: 82vh; overflow-y: auto; }
.sheet-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.sheet-title { font-size: 32rpx; font-weight: 600; color: #0f172a; }
.sheet-close { font-size: 40rpx; color: #64748b; padding: 0 10rpx; }
.label { display: block; margin: 16rpx 0 8rpx; font-size: 24rpx; color: #475569; }
.input { width: 100%; box-sizing: border-box; background: #f8fafc; border-radius: 12rpx; padding: 16rpx; font-size: 26rpx; }
.input.small { min-height: 100rpx; }
.chips { display: flex; gap: 12rpx; flex-wrap: wrap; }
.chip { padding: 10rpx 22rpx; border-radius: 999rpx; background: #f1f5f9; color: #475569; font-size: 24rpx; }
.chip.active { background: #ffffff; color: #0f172a; }
.primary { margin-top: 24rpx; }
.add-fab { width: 64rpx; height: 64rpx; border-radius: 50%; background: #ffffff; border: 1rpx solid #e2e8f0; color: #00D6B9; font-size: 40rpx; line-height: 62rpx; text-align: center; box-shadow: 0 4rpx 14rpx rgba(15,23,42,.08); }


.back-pill { font-size: 24rpx; color: #1957E8; padding: 12rpx 18rpx; }
.panel { background: #fff; border-radius: 18rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 10rpx rgba(15,23,42,.05); }
.create-panel { margin-top: 8rpx; }
.task-panel { margin-bottom: 16rpx; }
.task-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6rpx; }
.task-title { font-size: 28rpx; font-weight: 600; color: #0f172a; }
.task-count { font-size: 21rpx; color: #94a3b8; }
.task-row { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #eef1f6; }
.task-row:last-child { border-bottom: 0; }
.task-main { flex: 1; min-width: 0; }
.task-name { display: block; font-size: 27rpx; color: #0f172a; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.task-meta { display: block; margin-top: 6rpx; font-size: 21rpx; color: #94a3b8; }
.chip.completed { background: #ecfdf5; color: #059669; }
.chip.processing { background: #eff6ff; color: #2563eb; }
.chip.failed { background: #fef2f2; color: #dc2626; }

.head-action { font-size: 26rpx; color: #1957E8; padding: 10rpx 0 10rpx 20rpx; white-space: nowrap; }

.prefill-row { display: flex; gap: 16rpx; margin: 0 0 16rpx; flex-wrap: wrap; }
.hint { display: block; margin-top: 10rpx; font-size: 22rpx; color: #64748b; line-height: 1.6; }

.head-actions { display: flex; gap: 16rpx; margin: 0 0 16rpx; flex-wrap: wrap; }
.head-actions .ghost.mini { margin-top: 0; height: 60rpx; line-height: 60rpx; padding: 0 24rpx; font-size: 24rpx; color: #1957E8; background: #eff6ff; border-radius: 16rpx; }

.img-row { display: flex; flex-wrap: wrap; gap: 14rpx; margin: 8rpx 0 16rpx; }
.img-item { position: relative; width: 150rpx; height: 150rpx; }
.img { width: 150rpx; height: 150rpx; border-radius: 12rpx; }
.img-del { position: absolute; top: -10rpx; right: -10rpx; width: 36rpx; height: 36rpx; line-height: 34rpx; text-align: center; font-size: 24rpx; color: #fff; background: #ef4444; border-radius: 50%; }
.img-add { width: 150rpx; height: 150rpx; line-height: 150rpx; text-align: center; font-size: 44rpx; color: #64748b; background: #f8fafc; border: 2rpx dashed #cbd5e1; border-radius: 12rpx; }
