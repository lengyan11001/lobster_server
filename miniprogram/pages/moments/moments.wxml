<view class="page">
  <view style="margin:12rpx 0;padding:12rpx 16rpx;border-radius:10rpx;background:#fff7ed;color:#9a3412;font-size:22rpx;line-height:1.6;">AI 生成内容，请注意甄别；生成结果仅供参考。</view>
  <view class="head">
    <view>
      <text class="title">朋友圈文案</text>
      <text class="sub">按批次查看生成记录，点进去看文案和配图</text>
    </view>
    <view wx:if="{{viewMode === 'list'}}" class="head-action" bindtap="openCreate">＋ 新建</view>
    <view wx:else class="head-action" bindtap="backToList">返回列表</view>
  </view>

  <block wx:if="{{viewMode === 'list'}}">
    <view wx:if="{{taskRows.length}}" class="panel task-panel">
      <view class="task-head">
        <text class="task-title">进行中任务</text>
        <text class="task-count">{{taskRows.length}} 条</text>
      </view>
      <view wx:for="{{taskRows}}" wx:key="id" class="task-row">
        <view class="task-main">
          <text class="task-name">{{item.title || '朋友圈文案'}}</text>
          <text class="task-meta">{{item.timeText}} · {{item.statusText}}</text>
        </view>
        <text class="chip {{item.status === 'failed' ? 'failed' : 'processing'}}">{{item.statusText}}</text>
      </view>
    </view>

    <view wx:if="{{loading && !groups.length}}" class="empty">加载中…</view>
    <view wx:elif="{{!groups.length && !taskRows.length}}" class="empty">还没有生成记录，点右上角「新增」</view>

    <view wx:for="{{groups}}" wx:key="gid" class="card" data-gid="{{item.gid}}" bindtap="openGroup">
      <view class="card-top">
        <text class="card-title">{{item.title || '朋友圈文案批次'}}</text>
        <text class="chip completed">{{item.count}} 条</text>
      </view>
      <text class="card-meta">{{item.time}} · 配图 {{item.imageCount}} 张</text>
    </view>
  </block>

  <block wx:if="{{viewMode === 'create'}}">
    <view class="panel create-panel">
      <text class="label">主题 / 卖点</text>
      <textarea class="input" value="{{topic}}" bindinput="onTopic" placeholder="例如：小户型收纳神器，99 元三件套" auto-height maxlength="200" />
      <text class="label">文案条数</text>
      <view class="chips">
        <view wx:for="{{[5,10,20]}}" wx:key="*this" class="chip {{copyCount === item ? 'active' : ''}}" data-value="{{item}}" bindtap="setCopyCount">{{item}} 条</view>
      </view>
      <text class="label">文案要求（可选）</text>
      <textarea class="input small" value="{{copyRequirement}}" bindinput="onReq" placeholder="例如：短句、多换行、不要硬性导流" auto-height maxlength="200" />
      <button class="primary" loading="{{generating}}" disabled="{{generating}}" bindtap="submitCreate">创建并返回列表</button>
    </view>
  </block>
</view>
