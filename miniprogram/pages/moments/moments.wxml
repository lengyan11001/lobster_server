<view class="page">
  <view class="head">
    <view>
      <text class="title">朋友圈文案</text>
      <text class="sub">按批次查看生成记录，点进去看文案和配图</text>
    </view>
    <button class="primary small" bindtap="goCreate">+ 新增</button>
  </view>

  <view wx:if="{{loading && !groups.length}}" class="empty">加载中…</view>
  <view wx:elif="{{!groups.length}}" class="empty">还没有生成记录，点右上角「新增」</view>

  <view wx:for="{{groups}}" wx:key="gid" class="card" data-gid="{{item.gid}}" bindtap="openGroup">
    <view class="card-top">
      <text class="card-title">{{item.title || '朋友圈文案批次'}}</text>
      <text class="chip completed">{{item.count}} 条</text>
    </view>
    <text class="card-meta">{{item.time}} · 配图 {{item.imageCount}} 张</text>
  </view>
</view>
