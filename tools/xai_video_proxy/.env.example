# Keep real credentials only in /opt/xai_video_proxy/.env on the proxy host.
XAI_PROXY_TOKEN=replace-with-the-shared-server-to-proxy-token
XAI_API_KEY=replace-with-an-xai-api-key
XAI_API_BASE=https://api.x.ai
XAI_VIDEO_MODEL=grok-imagine-video-1.5

# Protect the standalone URL-to-TOS transfer endpoint.
VIDEO_TRANSFER_TOKEN=replace-with-a-different-long-random-token
VIDEO_TRANSFER_MAX_BYTES=536870912
VIDEO_TRANSFER_DOWNLOAD_TIMEOUT=300

# The proxy downloads image URLs itself, uploads them through xAI Files, then
# submits the returned file_id to the official video endpoint.
XAI_INPUT_IMAGE_MAX_BYTES=52428800
XAI_INPUT_IMAGE_DOWNLOAD_TIMEOUT=90
XAI_INPUT_IMAGE_SPOOL_BYTES=8388608

# TOS public storage for completed videos and the transfer endpoint.
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_ENDPOINT=
TOS_REGION=
TOS_BUCKET=
TOS_PUBLIC_DOMAIN=
TOS_PREFIX=proxy-video
