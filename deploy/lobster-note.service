[Unit]
Description=Lobster Note (必火听记录)
After=network.target postgresql.service lobster-backend.service
Wants=lobster-backend.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/lobster-server
Environment=PYTHONPATH=/opt/lobster-server
EnvironmentFile=/opt/lobster-server/.env
Environment=NOTE_PORT=8030
Environment=NOTE_WORKERS=2
ExecStart=/opt/lobster-server/.venv/bin/python3 -m backend.note_run
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
