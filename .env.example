# ============================================
# Lobster Config (复制为 .env 后按需填写，勿将含真实 key 的 .env 打包分发)
# 服务器上一键配置：在 lobster_server 仓库中运行 python3 scripts/config_env.py（交互或 CONFIG_* 环境变量）
# ============================================

SECRET_KEY=lobster-secret-change-me
DEBUG=true

# 仅测试/脚本用；在线版不创建默认用户
# DEFAULT_USER_EMAIL=user@lobster.local
# DEFAULT_USER_PASSWORD=lobster123

HOST=0.0.0.0
PORT=8000
MCP_PORT=8001
# Web API worker 数。生产 PostgreSQL 建议 2-4 起步；后台循环任务由独立 lobster-background 进程跑一份。
BACKEND_WORKERS=2
# 生产 systemd 已由 lobster-mcp 管理 MCP，Backend 不应抢先自启；本地单进程启动可保持默认 1。
# LOBSTER_BACKEND_AUTOSTART_MCP=0
# MCP 是否在 invoke_capability 成功后自动 POST /api/assets/save-url。在线版素材以用户本机为准：默认关闭；仅本机 backend+MCP 一体且需 MCP 写库时设 MCP_AUTOSAVE_ASSETS=1
# MCP_AUTOSAVE_ASSETS=0
# 公网根（定死 ECS）：upload-temp 外链、回调、速推拉图。仅当前面有 Nginx+HTTPS 时改为 https://你的域名
PUBLIC_BASE_URL=https://bhzn.top

# 数据库：默认 SQLite；生产并发建议迁移 PostgreSQL，流程见 docs/PostgreSQL迁移与回滚方案.md
# DATABASE_URL=sqlite:///./lobster.db
# DATABASE_URL=postgresql+psycopg://lobster:密码@127.0.0.1:5432/lobster
# 单个 worker 的连接池。BACKEND_WORKERS=2 时默认最多约 30 个应用连接；按机器和 pg max_connections 再调。
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# 文件日志和诊断上传默认只保留 3 天。
LOBSTER_LOG_RETENTION_DAYS=3
LOBSTER_DIAGNOSTICS_RETENTION_DAYS=3
# DB_POOL_TIMEOUT=10
# DB_POOL_RECYCLE=280
# PostgreSQL safety limits. They prevent a leaked request transaction or lock
# wait from occupying the service indefinitely.
# DB_STATEMENT_TIMEOUT_MS=60000
# DB_LOCK_TIMEOUT_MS=10000
# DB_IDLE_TRANSACTION_TIMEOUT_MS=30000
# Per-process request admission. Defaults leave pool capacity available for
# background writes while returning 503 quickly instead of hanging the site.
# SERVER_REQUEST_MAX_CONCURRENCY=12
# SERVER_REQUEST_MAX_QUEUE=48
# SERVER_REQUEST_QUEUE_TIMEOUT_SECONDS=10
# SERVER_HEAVY_MAX_CONCURRENCY=6
# SERVER_HEAVY_MAX_QUEUE=24
# SERVER_HEAVY_QUEUE_TIMEOUT_SECONDS=120
# Long-running LLM streams have a separate upstream gate, so they do not
# consume request or database capacity while clients are receiving tokens.
# SUTUI_CHAT_UPSTREAM_MAX_CONCURRENCY=16
# SUTUI_CHAT_UPSTREAM_MAX_QUEUE=32
# SUTUI_CHAT_UPSTREAM_QUEUE_TIMEOUT_SECONDS=30
# Detached media/document work has its own bounded queue as well.
# SERVER_BACKGROUND_HEAVY_MAX_CONCURRENCY=6
# SERVER_BACKGROUND_HEAVY_MAX_QUEUE=24
# SERVER_BACKGROUND_HEAVY_QUEUE_TIMEOUT_SECONDS=1800

# Mastra AI 调度服务：H5 对话由后台 runner 转交给本机 4111 端口，默认 4 路并发。
# 每个 H5 会话使用独立 thread；用户长期记忆按 brand + user 共享。
LOBSTER_MASTRA_CHAT_ENABLED=1
LOBSTER_MASTRA_URL=http://127.0.0.1:4111
LOBSTER_MASTRA_PORT=4111
LOBSTER_INTERNAL_API_BASE=http://127.0.0.1:8000
LOBSTER_MASTRA_MODEL=openai/gpt-5.6-sol
LOBSTER_MASTRA_MAX_CONCURRENCY=4
# 单用户公平性、排队和上下文预算
# LOBSTER_MASTRA_MAX_CONCURRENCY_PER_USER=1
# LOBSTER_MASTRA_MAX_QUEUE_DEPTH=32
# LOBSTER_MASTRA_MAX_ACTIVE_PER_USER=8
# LOBSTER_MASTRA_CONTEXT_TOKEN_LIMIT=48000
# LOBSTER_MASTRA_LAST_MESSAGES=10
# LOBSTER_MASTRA_SUMMARY_KEEP_TURNS=5
# LOBSTER_MASTRA_SUMMARY_MIN_TURNS=4
# LOBSTER_MASTRA_SUMMARY_MIN_CHARS=12000
# 会话与流事件保留期
# LOBSTER_MASTRA_MEMORY_RETENTION_DAYS=180
# LOBSTER_MASTRA_THREAD_RETENTION_DAYS=365
# LOBSTER_MASTRA_TRACE_RETENTION_DAYS=14
# LOBSTER_H5_CHAT_TRANSIENT_EVENT_DAYS=7
# LOBSTER_H5_CHAT_EVENT_DAYS=90
# LOBSTER_H5_CHAT_ARCHIVED_SESSION_DAYS=90
# LOBSTER_MASTRA_POLL_SECONDS=1
# LOBSTER_MASTRA_STALE_SECONDS=1200
# 可选。留空时 Backend 与 Mastra 会使用 SECRET_KEY 派生同一个内部鉴权值。
# LOBSTER_MASTRA_INTERNAL_SECRET=

# Messenger（仅海外实例通常需要）：与大陆登录共用 SECRET_KEY，但海外 SQLite 无 users 行时仍允许 /api/messenger/configs* 使用 JWT sub
# MESSENGER_TRUST_JWT_WITHOUT_USER=false

# 对话模型 API Key（选填；不填则仅用 OpenClaw/速推）
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_AGENT_ID=main
# 主对话默认先直连+MCP；仅当用户消息以 /openclaw 开头时该轮走 OpenClaw
LOBSTER_OPENCLAW_PRIMARY_CHAT=false
LOBSTER_OPENCLAW_ONLY_CHAT=false
LOBSTER_OPENCLAW_CHAT_PREFIX_GATE=true
# 是否在启动时尝试本机拉起 OpenClaw（需 node + openclaw.mjs，与 lobster_online 完整包一致）。
# 纯 API 的 Linux 服务器通常没有这些文件：可不配，启动时仅打 INFO 并跳过；若仍想关闭探测可设 false。
# OPENCLAW_AUTOSTART=false

CAPABILITY_SUTUI_MCP_URL=
# 服务器侧速推 Token：能力由服务器转发、扣用户积分时使用（必填，否则能力调用报错）
# 可选：sutui-chat 转发 xskill 前重写 model（JSON 对象）。键=客户端传入的 model，值=速推分销商侧有通道的真实 id。
# 例：网页智能对话里能用的 id 与 OpenClaw 用的 deepseek/deepseek-chat 不一致时配置。
# SUTUI_CHAT_MODEL_MAP_JSON={"deepseek/deepseek-chat":"你在下拉或 F12 里看到的 model id"}
# sutui-chat：主模型失败/非标准 OpenAI choices 时按顺序换备用模型（JSON 数组，用速推 model id）。默认主模型 → openai/gpt-5.6-sol → deepseek-chat；Token 池 402/401 等不会无意义重试。
# Mastra 调度请求会始终保留 deepseek-chat 作为最终备用，即使这里的自定义列表省略了它。
# SUTUI_CHAT_MODEL_FALLBACK_CHAIN_JSON=["openai/gpt-5.6-sol","deepseek-chat"]
# OpenClaw 独立 Browser/Computer 工作台使用的服务器调度模型；默认 gpt-5.4。
# LOBSTER_OPENCLAW_SKILL_SUTUI_CHAT_MODEL=gpt-5.4
# sutui-chat：速推 docs 无定价时，事后按 usage 折算扣费（每 1000 token 扣多少积分，ceil）。默认 1.0；设 0 则无极低价近似时可能算成 0 积分。上游若省略 usage（非流式常见），已用 messages/max_tokens 粗估再折算。
# SUTUI_CHAT_FALLBACK_CREDITS_PER_1K=1.0
# 网页 /api/sutui-llm/models 的 recommended 与探测快照默认推荐；不填时只要在目录里存在 deepseek-chat（或 deepseek/deepseek-chat）即优先于其它模型
# SUTUI_LLM_RECOMMENDED_ID=
# 下发给 lobster_online 的默认图片生成模型；修改后重启 lobster-server 即可，无需更新客户端包
# LOBSTER_DEFAULT_IMAGE_GENERATE_MODEL=gpt-image2

# Comfly：爆款TVC/创意分镜头视频等能力的云端转发根地址与服务端 Key。
# COMFLY_API_BASE=https://ai.comfly.org
# COMFLY_API_KEY=
# G-AISC image channel (write the real key only in the server .env; never commit it)
# COMFLY_API_BASE_GAISC=https://qwe.g-aisc.com
# COMFLY_API_KEY_GAISC=
# Dedicated ComfyUI official relay image key. Uses COMFLY_API_BASE unless a group base is supplied.
# COMFLY_API_KEY_COMFYUI_OFFICIAL=
# Dedicated ComfyUI Grok video key. Keep this separate from the image key above.
# COMFLY_API_KEY_COMFYUI_VIDEO=
# 多 Token 分组时可按 comfly_pricing.json 的 token_group 配 COMFLY_API_KEY_<GROUP>

# 阿里询盘客户档案：第一优先级数据源全部走 server 中转，不下发给 online 客户端。
# 稳定搜索建议至少配置一种：serper / google_cse / tavily；不配时只能使用不稳定网页兜底搜索。
# CUSTOMER_RESEARCH_SEARCH_PROVIDER=auto
# SERPER_API_KEY=
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_CX=
# TAVILY_API_KEY=
# 企业主体库：用于核验注册公司名、注册号、辖区、状态和注册地址。
# OPENCORPORATES_API_KEY=
# 社媒/短视频/电商公开信号中转，用于第二层辅助证据，不作为客户主体唯一依据。
# TIKHUB_API_BASE=https://api.tikhub.io
# TIKHUB_API_KEY=

# OpenMind：图片创作备用渠道。主 image.generate(gpt-image-2) 失败时自动切到这里。
# OPENMIND_API_BASE=https://www.openmindapi.com
# OPENMIND_API_KEY=
# OPENMIND_IMAGE_MODEL=gpt-image-2
# OPENMIND_IMAGE_FALLBACK_ENABLED=1
# Seedance-only OpenMind channel. Used for Seedance submit, polling, and content download.
# Falls back to OPENMIND_API_KEY when empty; other OpenMind features keep using OPENMIND_API_KEY.
# OPENMIND_SEEDANCE_API_KEY=
# OPENMIND_SEEDANCE_MODEL=seedance2.0
# OPENMIND_SEEDANCE_FAST_MODEL=seedance2.0
# OpenMind 余额监控：优先使用访问令牌 + 数字用户 ID 查询 /api/user/self；
# 未配置访问令牌时才尝试用 OPENMIND_API_KEY 查询 /api/usage/token/。
# OPENMIND_ACCOUNT_API_BASE=https://www.openmindapi.com
# OPENMIND_ACCOUNT_TOKEN=
# OPENMIND_ACCOUNT_USER_ID=

# MiniMax 语音：数字人声音创建/试听/文案驱动先走 MiniMax，再转 HiFly 音频驱动。
# HIFLY_VOICE_TTS_PROVIDER=qwen
# MINIMAX_API_KEY=
# MINIMAX_API_BASE=https://api.minimaxi.com
# MINIMAX_TTS_MODEL=speech-2.8-turbo
# 千问语音：HIFLY_VOICE_TTS_PROVIDER=qwen 时，数字人声音复刻/试听/文案驱动先走千问，再转 HiFly 音频驱动。
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
# QWEN_TTS_MODEL=qwen3-tts-vc-2026-01-22
# QWEN_VOICE_ENROLL_MODEL=qwen-voice-enrollment

# 国内实例：每小时速推 LLM 目录 + chat 可用性探测（写 data/sutui_llm_snapshot.json）。设为 0/false/off 可关闭，不影响对话转发与速推对账。
# LOBSTER_SUTUI_LLM_PROBE_ENABLED=0
# 独立后台 worker 内的子任务开关。web worker 不再启动这些循环，避免多 worker 重复探测/对账/发布。
# LOBSTER_BACKGROUND_SUTUI_LLM_PROBE_ENABLED=1
# LOBSTER_BACKGROUND_SUTUI_RECONCILE_ENABLED=1
# LOBSTER_BACKGROUND_META_SOCIAL_ENABLED=1
# 每小时查询上游余额并推送飞书机器人；只在 lobster-background 单进程中运行。
# PROVIDER_BALANCE_FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# PROVIDER_BALANCE_MONITOR_ENABLED=1
# PROVIDER_BALANCE_MONITOR_INTERVAL_SEC=3600
# PROVIDER_BALANCE_LOW_THRESHOLD=50
# 默认不查询也不推送 Yunwu；多个供应商用逗号分隔，支持 provider 或 provider_group（如 sutui_apiz）。
# PROVIDER_BALANCE_MONITOR_EXCLUDED_PROVIDERS=yunwu
# LOBSTER_BACKGROUND_PROVIDER_BALANCE_MONITOR_ENABLED=1
# TOS/火山账号余额监控：默认复用 custom_configs.json 的 TOS_CONFIG AK/SK 查询费用中心。
# 如果 TOS 子账号只有对象存储权限，可单独配置一组仅有费用中心只读权限的 AK/SK。
# VOLCENGINE_BILLING_API_BASE=https://billing.volcengineapi.com
# VOLCENGINE_BILLING_REGION=cn-beijing
# VOLCENGINE_BILLING_ACCESS_KEY=
# VOLCENGINE_BILLING_SECRET_KEY=
# 阿里云短信余额监控使用 ALIYUN_SMS_* 查询阿里云账号可用余额（不是短信条数）。
# 默认短信通道使用 ALIYUN_SMS_ACCESS_KEY_ID/SECRET/SIGN_NAME/TEMPLATE_CODE。
# OEM 可通过 JSON 配置独立通道（敏感信息只放部署环境，不要提交到 Git）：
# ALIYUN_SMS_BRAND_CHANNELS_JSON={"hikong":{"access_key_id":"...","access_key_secret":"...","sign_name":"海康智慧科技深圳","template_code":"SMS_511855264"}}
# 也可使用按品牌变量，例如 ALIYUN_SMS_HIKONG_ACCESS_KEY_ID 等；它们优先于 JSON。
# ALIYUN_BSS_API_BASE=https://business.aliyuncs.com

# 日常运行监控：每小时统计上一窗口在线用户、生成/失败次数、服务器资源使用情况并发飞书。
# 默认复用 PROVIDER_BALANCE_FEISHU_WEBHOOK；如需单独机器人可配置 RUNTIME_MONITOR_FEISHU_WEBHOOK。
# RUNTIME_MONITOR_FEISHU_WEBHOOK=
# RUNTIME_MONITOR_ENABLED=1
# RUNTIME_MONITOR_INTERVAL_SEC=3600
# RUNTIME_MONITOR_WINDOW_SEC=3600
# RUNTIME_MONITOR_CURRENT_ONLINE_WINDOW_SEC=300
# LOBSTER_BACKGROUND_RUNTIME_MONITOR_ENABLED=1

# SUTUI_SERVER_TOKEN=
# 多个速推算力 Token（逗号分隔）时做负载均衡；不填则用 SUTUI_SERVER_TOKEN
# SUTUI_SERVER_TOKENS=sk-xxx,sk-yyy,sk-zzz
#
# 品牌分流：终端用户 JWT 须为 brand_mark=bihuo|yingshi，对应池取 Token；无品牌不允许走速推（无 USER 兜底）
# SUTUI_SERVER_TOKEN_BIHUO=
# SUTUI_SERVER_TOKENS_BIHUO=sk-...,sk-...
# SUTUI_SERVER_TOKEN_YINGSHI=
# SUTUI_SERVER_TOKENS_YINGSHI=sk-...,sk-...
# 已弃用：SUTUI_SERVER_TOKEN_USER / SUTUI_SERVER_TOKENS_USER 不再参与用户侧选 Token
#
# MCP 需能解析 JWT 中的 brand_mark：与 Backend 使用同一 SECRET_KEY（或设 LOBSTER_SECRET_KEY）

# 速推对账（国内主实例默认开启；海外设 LOBSTER_SERVER_REGION=overseas 时关闭；与 LLM 探测独立）
# LOBSTER_SUTUI_RECONCILE_ENABLED=true
# LOBSTER_SUTUI_RECONCILE_INTERVAL_SEC=3600

# 在线版速推登录
# SUTUI_OAUTH_LOGIN_URL=

# 本构建仅在线版（online）
LOBSTER_EDITION=online
# 已废弃：前端由 lobster_online 提供，server 仅 API，不再提供 / 与 /static
# SERVE_FRONTEND=
# 独立认证与充值（注册/登录/积分/技能解锁）
LOBSTER_INDEPENDENT_AUTH=true
# 技能商店「调试」包（如微信 OpenClaw、YouTube）额外管理员：逗号分隔登录账号（与 User.email 一致）
# LOBSTER_SKILL_STORE_ADMIN_ACCOUNTS=ops1,ops2
# 完成充值/技能解锁订单时请求头 X-Admin-Secret（仅服务端知晓）
# LOBSTER_RECHARGE_ADMIN_SECRET=

# 自建微信登录 / 小程序：小程序端 wx.login 与手机号授权使用这组配置
# WECHAT_APP_ID=wxbbf4a4f9a0fdd872
# WECHAT_APP_SECRET=
# 小程序默认首页路径，必须在 miniprogram/app.json 的 pages 中存在。
# WECHAT_MINIPROGRAM_PAGE=pages/index/index

# 富友聚合支付（MD5 签名；主扫 preCreate / 查询 commonQuery）
# 文档: https://fundwx.fuiou.com/doc/#/aggregatePay/api
#
# ── 商户号 / 密钥 ─────────────────────────────────────────────
# FUIOU_MCHNT_CD=0002900F5829371
# FUIOU_MCHNT_KEY=f00dac5077ea11e754e14c9541bc0170
#
# ── 接口地址（测试/生产）────
# 【测试】
# FUIOU_PRECREATE_URL=https://aipaytest.fuioupay.com/aggregatePay/preCreate
# FUIOU_QUERY_URL=https://aipaytest.fuioupay.com/aggregatePay/commonQuery
# FUIOU_REFUND_URL=https://aipaytest.fuioupay.com/aggregatePay/commonRefund
# 【生产】
# FUIOU_PRECREATE_URL=https://aipay-cloud.fuioupay.com/aggregatePay/preCreate
# FUIOU_QUERY_URL=https://aipay-cloud.fuioupay.com/aggregatePay/commonQuery
# FUIOU_REFUND_URL=https://aipay-cloud.fuioupay.com/aggregatePay/commonRefund
#
# ── 业务参数 ─────────────────────────────────────────────
# FUIOU_ORDER_PREFIX=1066           # 订单前缀（5位，富友分配）
# FUIOU_DEFAULT_ORDER_TYPE=WECHAT   # WECHAT / ALIPAY / UNIONPAY
# FUIOU_TERM_ID=                    # 终端号，可选（默认 88888888）
# FUIOU_INS_CD=                     # 机构号，可选
# FUIOU_REPEAT_ORDER=1              # 启用幂等重复下单
# FUIOU_BRAND_CONFIGS_JSON={"hikong":{"mchnt_cd":"...","mchnt_key":"...","order_prefix":"..."}}
# OEM 配置需至少包含 mchnt_cd/mchnt_key；未配置的 OEM 自动使用上面的系统级 FUIOU_*。

# ── 管理后台（/admin）──
# 不设置则管理后台返回 503；用户名密码均为明文
# LOBSTER_ADMIN_USERNAME=admin
# LOBSTER_ADMIN_PASSWORD=change-me
